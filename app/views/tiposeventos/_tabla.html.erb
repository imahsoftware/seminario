<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
    <tr class="thcolor">
      <% if is_auth_a('tiposevento') %>
        <th width="10%" class="text-table">Acciones</th>
      <% end %>
      <th class="text-table">Descripción</th>
      <th class="text-table" width="10%">Estado</th>
    </tr>
    </thead>
    <tbody id="tbody_tiposeventos">
    <% @tiposeventos.each do |tiposevento| %>
      <%= render 'tiposeventos/tr', tiposevento: tiposevento %>
    <% end %>
    </tbody>
  </table>
</div>
