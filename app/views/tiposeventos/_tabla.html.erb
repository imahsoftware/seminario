<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
    <tr style="background-color: #071B7D; color: #fff;">
      <% if is_auth_a('tiposevento') %>
        <th style="background-color: #071B7D; color: #fff;" width="10%" class="text-center">Acciones</th>
      <% end %>
      <th style="background-color: #071B7D; color: #fff;">Descripción</th>
      <th style="background-color: #071B7D; color: #fff;" width="10%" class="text-center">Estado</th>
    </tr>
    </thead>
    <tbody id="tbody_tiposeventos">
    <% @tiposeventos.each do |tiposevento| %>
      <%= render 'tiposeventos/tr', tiposevento: tiposevento %>
    <% end %>
    </tbody>
  </table>
</div>
