<p id="notice"><%= notice %></p>

<h1>Tiposeventos</h1>

<table>
  <thead>
    <tr>
      <th>Descripcion</th>
      <th>Estado</th>
      <th>User</th>
      <th>User act</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tiposeventos.each do |tiposevento| %>
      <tr>
        <td><%= tiposevento.descripcion %></td>
        <td><%= tiposevento.estado %></td>
        <td><%= tiposevento.user %></td>
        <td><%= tiposevento.user_act %></td>
        <td><%= link_to 'Show', tiposevento %></td>
        <td><%= link_to 'Edit', edit_tiposevento_path(tiposevento) %></td>
        <td><%= link_to 'Destroy', tiposevento, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Tiposevento', new_tiposevento_path %>
