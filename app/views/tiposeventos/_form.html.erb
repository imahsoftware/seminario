<%= simple_form_for @tiposevento, remote: true do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-md-8">
        <%= f.input :descripcion, input_html: { class: 'clean', onChange: 'javascript:this.value=this.value.toUpperCase();' } %>
      </div>
      <div class="col-md-2">
        <%= f.input :estado, collection: select_estado, as: :select, input_html: { data: { width: '100%' }, class: 'select2' } %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @tiposevento.new_record? %>
          <%= button_tag t(:cancelar),
                         type: 'button',
                         class: 'btn btn-flat btn-default pull-left',
                         onclick: '$("#tiposevento_form").collapse("hide"); $("#tiposevento_form").empty(); return false;' %>
        <% else %>
          <%= link_to t(:cancelar), tiposevento_path(@tiposevento),
                      class: 'btn btn-flat btn-default pull-left',
                      remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
