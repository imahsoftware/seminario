<div class="box box-primary">
  <div class="box-header">
    <!-- Botón Atrás a la izquierda -->
    <div class="pull-left">
      <%= link_to iglesias_path  do %>
        <i class="fa fa-arrow-left"></i>
      <% end %>
    </div>

    <!-- Título centrado o alineado correctamente -->
    <h3 class="box-title" style="margin-left: 10px;">
      Comunidades de <%= @iglesia.nombre %>
    </h3>

    <!-- Herramientas a la derecha -->
    <div class="box-tools pull-right">
      <% if is_auth_c('iglesiascomunidades') %>
        <%= link_to new_iglesia_iglesiascomunidad_path(@iglesia),
                    remote: true,
                    class: 'btn btn-sm btn-info' do %>
          <i class="fa fa-plus-square"></i> <span>Nuevo</span>
        <% end %>&nbsp;&nbsp;
      <% end %>
      <div class="box-tools pull-right">

      <!-- Buscador -->
      <%= search_form_for @q, url: iglesia_iglesiascomunidades_path(@iglesia), method: :get do |f| %>
        <div class="input-group input-group-sm" style="width: 180px;">
          <%= f.search_field :nombre_cont,
                             onChange: 'javascript:this.value=this.value.toUpperCase();',
                             class: 'form-control pull-right input_uppercase',
                             placeholder: 'Buscar...' %>
          <div class="input-group-btn">
            <%= button_tag(type: "submit", class: "btn btn-default") do %>
              <i class="fa fa-search"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  </div>
  <!-- Resto del box-body con tabla y paginador sigue igual -->
  <div class="box-body">
    <div id="iglesiascomunidades_form"></div>

    <div id="iglesiascomunidades">
      <% if @iglesiascomunidades.present? %>
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead>
            <tr class="thcolor">
              <% if is_auth_a('iglesiascomunidades') %>
                <th class="text-center">Acciones</th>
              <% end %>
              <th>Nombre Comunidad</th>
              <th>Estado</th>
            </tr>
            </thead>
            <tbody>
            <% @iglesiascomunidades.each do |comunidad| %>
              <tr>
                <% if is_auth_a('iglesiascomunidades') %>
                  <td class="text-center">
                    <%= link_to edit_iglesia_iglesiascomunidad_path(@iglesia, comunidad),
                                class: 'btn btn-xs btn-warning',
                                remote: true,
                                data: { toggle: 'tooltip' },
                                title: "#{t :title_editar}" do %>
                      <i class="fa fa-edit"></i>
                    <% end %>

                    <%= link_to iglesia_iglesiascomunidad_path(@iglesia, comunidad),
                                method: :delete,
                                remote: true,
                                data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' },
                                title: "#{t :title_elimina}" do %>
                      <i class="fa fa-trash btn btn-xs btn-danger"></i>
                    <% end %>
                  </td>
                <% end %>
                <td><%= comunidad.nombre %></td>
                <td><%= comunidad.estado %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-danger">
          <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4>
          <%= t :atencion_msj %>
        </div>
      <% end %>
    </div>

    <div class="box-tools pull-right">
      <%= will_paginate @iglesiascomunidades, renderer: BootstrapPagination::Rails %>
    </div>
  </div>
</div>
