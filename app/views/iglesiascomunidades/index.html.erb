<div class="box box-primary">
  <div class="box-header with-border">
    <!-- Botón Atrás a la izquierda -->
    <div class="pull-left">
      <%= link_to iglesias_path do %>
        <i class="fa fa-arrow-left"></i>
      <% end %>&nbsp;&nbsp;
    </div>

    <!-- Título centrado o alineado correctamente -->
    <legend>
      Comunidades de <%= @iglesia.nombre %>
    </legend>
    <div class="box-tools pull-right">
      <% if is_auth_c('iglesiascomunidades') %>
        <%= link_to new_iglesia_iglesiascomunidad_path(@iglesia), remote: true, class: 'btn btn-sm btn-info' do %>
          <i class="fa fa-plus-square"> </i> <span>Nueva Comunidad</span>
        <% end %>&nbsp;&nbsp;
      <% end %>

      <!-- Herramientas a la derecha -->
      <div class="box-tools pull-right">

        <!-- Buscador -->
        <%= search_form_for @q, url: iglesia_iglesiascomunidades_path(@iglesia), method: :get do |f| %>
          <div class="input-group input-group-sm" style="width: 180px;">
            <%= f.search_field :nombre_cont,
                               onChange: 'javascript:this.value=this.value.toUpperCase();',
                               class: 'form-control pull-right input_uppercase',
                               placeholder: 'Buscar...' %>
            <div class="input-group-btn">
              <%= button_tag(type: "submit", class: "btn btn-default") do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <!-- Resto del box-body con tabla y paginador sigue igual -->
  <div class="box-body">
    <div id="iglesiascomunidades_form"></div>

    <div id="iglesiascomunidades">
      <%= render 'tabla', iglesia: @iglesia, iglesiascomunidades: @iglesiascomunidades %>
    </div>

    <div class="box-tools pull-right">
      <%= will_paginate @iglesiascomunidades, renderer: BootstrapPagination::Rails %>
    </div>
  </div>
</div>
