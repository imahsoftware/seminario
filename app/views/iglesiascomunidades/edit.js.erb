$("#iglesiascomunidades_form").collapse("hide");
$("#iglesiascomunidades_form").empty();

<% if @active_record.present? %>
$("#iglesiascomunidad_<%= @active_record.id %>")
    .replaceWith("<%= j render 'tr', comunidad: @active_record, iglesia: @iglesia %>");
<% end %>

$("#iglesiascomunidad_<%= @iglesiacomunidad.id %>").html("<td colspan='3'><%= j render 'form' %></td>");

$("#iglesiacomunidad_<%= @iglesiacomunidad.id %>").addClass("active_iglesia");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();


