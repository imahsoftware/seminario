<tr id="iglesiascomunidad_<%= comunidad.id %>">
  <% if is_auth_a('iglesiascomunidades') %>
    <td class="text-center">
      <%= link_to edit_iglesia_iglesiascomunidad_path(iglesia, comunidad),
                  class: 'btn btn-xs btn-warning',
                  remote: true,
                  data: { toggle: 'tooltip' },
                  title: t(:title_editar) do %>
        <i class="fa fa-edit"></i>
      <% end %>
      <% unless comunidad.iglesiacomunidad_usado? %>
        <%= link_to iglesia_iglesiascomunidad_path(iglesia, comunidad),
                    method: :delete,
                    remote: true,
                    class: 'btn btn-xs btn-danger',
                    data: { confirm: t(:elimina_confirma), toggle: 'tooltip' },
                    title: t(:title_elimina) do %>
          <i class="fa fa-trash"></i>
        <% end %>
      <% end %>
    </td>
  <% end %>

  <td><%= comunidad.nombre %></td>
  <td><%= comunidad.estado %></td>
</tr>
