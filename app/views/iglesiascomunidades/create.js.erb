$(".alert_flash").fadeOut(1000, function() {
	$(this).remove();
});

<% if @iglesiascomunidades.present? %>1
$("#iglesiascomunidades").html("<%= j render 'tabla', iglesia: @iglesia, iglesiascomunidades: @iglesiascomunidades %>");
<% else %>
$("#tbody_iglesiascomunidades").prepend("<%= j render partial: 'tr',
                                                      locals: { iglesia: @iglesia,
                                                                comunidad: @iglesiascomunidad } %>");
<% end %>

$("#iglesiascomunidades_form").empty();

$(".clean").val("").trigger('change');

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
	$(".alert_flash").fadeOut(1000, function() {
		$(this).remove();
	});
}, 5000);

$(".select2").select2();
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");