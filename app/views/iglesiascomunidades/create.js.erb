$(".alert_flash").fadeOut(1000, function() {
	$(this).remove();
});

$("#tbody_iglesiascomunidades")
	.prepend("<%= j render partial: 'tr',
                        locals: { iglesia: @iglesia,
                                  comunidad: @iglesiascomunidad } %>");

$("#iglesiascomunidades_form").empty();

$(".clean").val("").trigger('change');

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
	$(".alert_flash").fadeOut(1000, function() {
		$(this).remove();
	});
}, 5000);
