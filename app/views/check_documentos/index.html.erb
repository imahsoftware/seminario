<div class="box box-primary">
  <div class="box-header">
    <legend><i class="fa fa-file-text"></i> Biblioteca de Documentos</legend>
    <div class="box-tools pull-right">
      <%= link_to new_check_documento_path, remote: true, class: 'btn btn-sm btn-info' do %>
        <i class="fa fa-plus-square"></i> Nuevo Documento
      <% end %>
      <div class="box-tools pull-right" style="margin-left: 10px;">
        <%= search_form_for @q do |f| %>
          <div class="input-group input-group-sm" style="width: 200px;">
            <%= f.search_field :titulo_cont, class: 'form-control', placeholder: 'Buscar por título' %>
            <div class="input-group-btn">
              <%= button_tag(type: "submit", class: "btn btn-default") do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flash_messages"></div>
  <div class="box-body">
    <div id="check_documento_form" class="collapse"></div>
    <div id="check_documentos">
      <% if @check_documentos.present? %>
        <%= render 'tabla' %>
      <% else %>
        <div class="alert alert-warning">
          <i class="fa fa-info-circle"></i> No hay documentos en la biblioteca. Crea el primero.
        </div>
      <% end %>
    </div>
    <%= will_paginate @check_documentos, renderer: BootstrapPagination::Rails %>
  </div>
</div>
