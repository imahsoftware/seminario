<tr id="iglesia_<%= iglesia.id %>">
  <td class="text-center">
    <%# if is_auth_a('modulo') %>
      <%= link_to edit_iglesia_path(iglesia), remote: true, class: 'edit_modulo_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
         <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
    <%# end %>
    <%# if is_auth_e('modulo') %>
      <%= link_to iglesia, remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <%# end %>
   </td>
  <td><%= iglesia.nombre %></td>
  <td><%= iglesia.direccion %></td>
  <td><%= iglesia.presbitero %></td>
  <td><%= iglesia.email %></td>

</tr>
