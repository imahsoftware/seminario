$("#iglesia_form").collapse("hide");

$("#iglesia_form").empty();

<% if @active_record.present? %>
	$("#iglesia_<%= @active_record.id %>").replaceWith("<%= j render 'tr', iglesia: @active_record %>");
<% end %>

$("#iglesia_<%= @iglesia.id %>").html("<td colspan='7'><%= j render 'form' %></td>");

$("#iglesia_<%= @iglesia.id %>").addClass("active_iglesia");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
