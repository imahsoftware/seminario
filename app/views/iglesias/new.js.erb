<% if @active_record.present? %>
	$("#iglesia_<%= @active_record.id %>").replaceWith("<%= j render 'tr', iglesia: @active_record %>");
<% end %>
$("#iglesias_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#iglesias_form").collapse("show");
$(".select2").select2();
