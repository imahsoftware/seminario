<%= simple_form_for @iglesia, remote: true  do |f| %>

  <div class="bs-callout">

    <% if @iglesia.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@iglesia.errors.count, "error") %> impidieron guardar el registro:</h4>
        <ul>
          <% @iglesia.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- FILA 1 -->
    <div class="row">
      <div class="col-md-4">
        <%= f.input :nombre, input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-4">
        <%= f.input :direccion, input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-4">
        <%= f.input :telefono, input_html: { class: 'clean' } %>
      </div>
    </div>

    <!-- FILA 2 -->
    <div class="row">
      <div class="col-md-4">
        <%= f.input :presbitero, input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-4">
        <%= f.input :email, input_html: { class: 'clean' } %>
      </div>


    </div>

    <!-- BOTONES -->
    <div class="row">
      <div class="col-md-6">
        <%= link_to "Cancelar", iglesias_path,
                    class: "btn btn-flat btn-default pull-left" %>
      </div>

      <div class="col-md-6">
        <%= f.button :submit, "Guardar",
                     class: "btn btn-danger pull-right" %>
      </div>
    </div>

  </div>

<% end %>
