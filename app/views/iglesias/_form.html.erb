<%= simple_form_for @iglesia, remote: true do |f| %>

  <div class="bs-callout">

    <% if @iglesia.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@iglesia.errors.count, "error") %> impidieron guardar el registro:</h4>
        <ul>
          <% @iglesia.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- FILA 1 -->
    <div class="row">
      <div class="col-md-4">
        <%= f.input :nombre, onChange: 'javascript:this.value=this.value.toUpperCase();',input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-4">
        <%= f.input :direccion,onChange: 'javascript:this.value=this.value.toUpperCase();', input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-4">
        <%= f.input :telefono, input_html: { class: 'clean' } %>
      </div>
    </div>

    <!-- FILA 2 -->
    <div class="row">
      <div class="col-md-6">
        <%= f.input :presbitero,input_html: { class: 'clean', onChange: 'javascript:this.value=this.value.toUpperCase();' } %>
      </div>

      <div class="col-md-6">
        <%= f.input :email,input_html: { class: 'clean' , onChange: 'javascript:this.value=this.value.toUpperCase();' } %>
      </div>
    </div>

    <!-- FILA BOTONES -->
    <div class="row">
      <div class="col-md-6">
        <% if @iglesia.new_record? %>
          <%= button_tag "#{t :cancelar}",
                         type: 'button',
                         data: { target: '#iglesias_form' },
                         class: 'cancel_button btn btn-flat btn-default pull-left',
                         aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}",
                      iglesia_path(@iglesia),
                      class: 'btn btn-flat btn-default pull-left',
                      remote: true %>
        <% end %>
      </div>

      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}",
                     class: "btn btn-danger pull-right" %>
      </div>
    </div>

  </div>

<% end %>

<br/>
