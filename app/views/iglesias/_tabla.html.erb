<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
    <tr class="thcolor">
      <% if is_auth_a('iglesia') %>
        <th width="10%" class="text-table"></th>
      <% end %>
      <th width="10%" class="text-center">Id</th>
      <th class="text-table">Descripción</th>
      <th class="text-table" width="10%">Estado</th>
    </tr>
    </thead>
    <tbody id="tbody_iglesias">
    <% @iglesias.each do |iglesia| %>
      <%= render 'iglesias/tr', iglesia: iglesia %>
    <% end %>
    </tbody>
  </table>
</div>
