<div class="table-responsive">
  <table class="table table-bordered">
      <thead>
      <tr style="background-color: #071B7D; color: #fff;">
        <% if is_auth_a('iglesias') %>
          <th style="background-color: #071B7D; color: #fff;" class="text-center">Acciones</th>
        <% end %>
        <th style="background-color: #071B7D; color: #fff;">Nombre</th>
        <th style="background-color: #071B7D; color: #fff;">Dirección</th>
        <th style="background-color: #071B7D; color: #fff;">Presbítero</th>
        <th style="background-color: #071B7D; color: #fff;">Correo</th>
      </tr>
      </thead>
      <tbody id="tbody_iglesias">
      <% @iglesias.order(created_at: :desc).each do |iglesia| %>
        <%= render 'iglesias/tr', iglesia: iglesia %>
      <% end %>
      </tbody>
    </table>
</div>

