<div class="box box-primary">
  <div class="box-header">
    <h3 class="box-title"><strong>Usuarios Supervisor</strong></h3>
    <div class="box-tools pull-right">
      <%= link_to new_evento_eventosuser_path(@evento), id: 'new_eventosuser_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="eventosuser_form" class="collapse"></div>
    <div id="eventosusers">
      <% if @evento.eventosusers.order("created_at desc").present? %>
        <%= render 'eventosusers/tabla' %>
      <% else %>
        <div class="alert alert-danger">
          <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
      <% end %>
    </div>
  </div>
</div>