<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="5%"></td>
        <th class="text-left">Fecha</th>
        <th width="80%" class="text-justify">Usuario Administra</th>
      </tr>
    </thead>
	  <tbody id="tbody_eventosusers">
	    <% @evento.eventosusers.order(id: :desc).each do |eventosuser| %>
	      <%= render 'eventosusers/tr', eventosuser: eventosuser %>
	    <% end %>
	  </tbody>
	</table>
</div>
