<%# ══════════════════════════════════════════════════════════════════════
    MODAL CÁMARA — UNA SOLA VEZ, fuera del each y fuera del box
    ══════════════════════════════════════════════════════════════════════ %>
<div class="modal fade" id="modalCamara" tabindex="-1" role="dialog"
     style="padding:0 !important; overflow:hidden !important;">
  <div class="modal-dialog modal-camara-custom" role="document">
    <div class="modal-content modal-camara-content">

      <div class="modal-camara-header">
        <span id="modal-titulo" class="modal-camara-titulo">
          <i class="fa fa-camera"></i> Capturar Documento
        </span>
        <button type="button" class="modal-camara-close" data-dismiss="modal">
          <i class="fa fa-times"></i>
        </button>
      </div>

      <div class="modal-camara-body">
        <div id="camara-flash" class="camara-flash"></div>
        <video id="camara-video" autoplay playsinline class="camara-video" style="display:block;"></video>
        <canvas id="camara-canvas" class="camara-canvas" style="display:none;"></canvas>
        <div id="camara-guia" class="camara-guia">
          <div class="guia-esquina guia-tl"></div>
          <div class="guia-esquina guia-tr"></div>
          <div class="guia-esquina guia-bl"></div>
          <div class="guia-esquina guia-br"></div>
          <span class="guia-texto">Encuadra el documento</span>
        </div>
        <div id="camara-error" class="camara-error-overlay" style="display:none;">
          <i class="fa fa-exclamation-triangle fa-2x"></i>
          <p>No se pudo acceder a la cámara.<br>Verifica los permisos del navegador.</p>
        </div>
        <div id="footer-capturar" class="snap-flotante">
          <button type="button" id="btn-snap" class="btn-camara-snap">
            <span class="btn-snap-circulo"><i class="fa fa-camera"></i></span>
            <span class="btn-snap-label">Tomar Foto</span>
          </button>
        </div>
      </div>

      <div class="modal-camara-footer">
        <div class="footer-cancelar-wrap">
          <button type="button" class="btn-camara-cancelar" data-dismiss="modal" id="btn-cancelar-camara">
            <i class="fa fa-times"></i> Cancelar
          </button>
        </div>
        <div id="footer-confirmar" class="footer-estado" style="display:none;">
          <button type="button" id="btn-usar-foto" class="btn-camara-usar">
            <i class="fa fa-check"></i> Usar esta foto
          </button>
          <button type="button" id="btn-repetir" class="btn-camara-repetir">
            <i class="fa fa-refresh"></i> Repetir
          </button>
        </div>
      </div>

    </div>
  </div>
</div><%# fin modalCamara %>

<%# ── LIGHTBOX PARA AMPLIAR IMÁGENES ─────────────────────────────────── %>
<div id="lightbox-doc"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85);
       z-index:99999; align-items:center; justify-content:center; flex-direction:column;">
  <div style="position:relative; max-width:90vw; max-height:88vh;">
    <button onclick="cerrarLightbox()"
            style="position:absolute; top:-14px; right:-14px; background:#fff;
              border:none; border-radius:50%; width:32px; height:32px;
              font-size:18px; cursor:pointer; line-height:30px; text-align:center;
              box-shadow:0 2px 8px rgba(0,0,0,0.4); color:#333;">
      &times;
    </button>
    <p id="lightbox-titulo"
       style="color:#fff; text-align:center; font-size:13px; margin-bottom:8px; font-weight:600;"></p>
    <img id="lightbox-img" src=""
         style="max-width:90vw; max-height:80vh; border-radius:8px;
           box-shadow:0 8px 40px rgba(0,0,0,0.6); display:block;">
  </div>
</div>

<script>
    // ── Variables globales cámara ─────────────────────────────────────────
    var camaraStream          = null;
    var editarCampoObjetivo   = null;
    var editarPreviewObjetivo = null;
    var editarEpId            = null;

    var titulosCamaraEditar = {
        'frente':  'Capturar Documento \u2013 Frente',
        'reverso': 'Capturar Documento \u2013 Reverso'
    };

    $(document).on('click', '.btn-detalle-persona', function () {
        $('#modal-persona-' + $(this).data('id')).modal('show');
    });

    $(document).on('click', '.btn-editar-persona', function () {
        $('#modal-editar-' + $(this).data('id')).modal('show');
    });

    // ── Lightbox ──────────────────────────────────────────────────────────
    function abrirImagen(url, titulo) {
        $('#lightbox-img').attr('src', url);
        $('#lightbox-titulo').text(titulo);
        $('#lightbox-doc').css('display', 'flex');
    }
    function cerrarLightbox() {
        $('#lightbox-doc').css('display', 'none');
        $('#lightbox-img').attr('src', '');
    }
    document.getElementById('lightbox-doc').addEventListener('click', function (e) {
        if (e.target === this) cerrarLightbox();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') cerrarLightbox();
    });

    // ── Abrir cámara desde modal editar ───────────────────────────────────
    function abrirCamaraEditar(prefixPreview, campoId, epId) {
        editarCampoObjetivo   = campoId;
        editarPreviewObjetivo = prefixPreview;
        editarEpId            = epId;

        var $modalEditar = $('#modal-editar-' + epId);

        // Esperar cierre completo del modal editar, luego abrir cámara
        $modalEditar.one('hidden.bs.modal', function () {
            document.getElementById('modal-titulo').innerHTML =
                '<i class="fa fa-camera"></i> ' + (titulosCamaraEditar[prefixPreview] || 'Capturar Documento');
            document.getElementById('camara-canvas').style.display    = 'none';
            document.getElementById('camara-video').style.display     = 'block';
            document.getElementById('footer-capturar').style.display  = 'flex';
            document.getElementById('footer-confirmar').style.display = 'none';
            document.getElementById('camara-guia').style.display      = 'flex';
            document.getElementById('camara-error').style.display     = 'none';
            $('#modalCamara').modal('show');
        });

        $modalEditar.modal('hide');
    }

    // ── Iniciar stream al abrir cámara ────────────────────────────────────
    $('#modalCamara').on('show.bs.modal', function () {
        var video = document.getElementById('camara-video');
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
                .then(function (stream) {
                    camaraStream    = stream;
                    video.srcObject = stream;
                })
                .catch(function () {
                    document.getElementById('camara-error').style.display = 'flex';
                    document.getElementById('camara-video').style.display = 'none';
                    document.getElementById('camara-guia').style.display  = 'none';
                });
        } else {
            document.getElementById('camara-error').style.display = 'flex';
        }
    });

    // ── Detener stream + reabrir modal editar al cerrar cámara ────────────
    $('#modalCamara').on('hidden.bs.modal', function () {
        if (camaraStream) {
            camaraStream.getTracks().forEach(function (t) { t.stop(); });
            camaraStream = null;
        }
        if (editarEpId) {
            var idParaReabrir = editarEpId;
            editarEpId = null; // limpiar ANTES del timeout para evitar loops
            setTimeout(function () {
                $('#modal-editar-' + idParaReabrir).modal('show');
            }, 300);
        }
    });

    // ── Botón snap (tomar foto) ───────────────────────────────────────────
    document.getElementById('btn-snap').addEventListener('click', function () {
        var video  = document.getElementById('camara-video');
        var canvas = document.getElementById('camara-canvas');
        canvas.width  = video.videoWidth;
        canvas.height = video.videoHeight;
        canvas.getContext('2d').drawImage(video, 0, 0);

        // Flash visual
        var flash = document.getElementById('camara-flash');
        flash.style.opacity = '1';
        setTimeout(function () { flash.style.opacity = '0'; }, 150);

        video.style.display                                        = 'none';
        canvas.style.display                                       = 'block';
        document.getElementById('camara-guia').style.display      = 'none';
        document.getElementById('footer-capturar').style.display  = 'none';
        document.getElementById('footer-confirmar').style.display = 'flex';
    });

    // ── Botón repetir ─────────────────────────────────────────────────────
    document.getElementById('btn-repetir').addEventListener('click', function () {
        document.getElementById('camara-canvas').style.display    = 'none';
        document.getElementById('camara-video').style.display     = 'block';
        document.getElementById('camara-guia').style.display      = 'flex';
        document.getElementById('footer-capturar').style.display  = 'flex';
        document.getElementById('footer-confirmar').style.display = 'none';
    });

    // ── Botón usar foto ───────────────────────────────────────────────────
    document.getElementById('btn-usar-foto').addEventListener('click', function () {
        var dataUrl = document.getElementById('camara-canvas').toDataURL('image/jpeg', 0.85);
        var base64  = dataUrl.split(',')[1];

        if (editarCampoObjetivo) {
            // Contexto: modal editar
            document.getElementById(editarCampoObjetivo).value = base64;

            var epIdActual = editarCampoObjetivo
                .replace('editar-cedula-frente-', '')
                .replace('editar-cedula-reverso-', '');

            var div = document.getElementById('editar-preview-' + editarPreviewObjetivo + '-' + epIdActual);
            var img = document.getElementById('editar-preview-' + editarPreviewObjetivo + '-img-' + epIdActual);
            if (div && img) { img.src = dataUrl; div.style.display = 'block'; }

            editarCampoObjetivo   = null;
            editarPreviewObjetivo = null;
            // editarEpId NO se limpia aquí — lo usa hidden.bs.modal para reabrir el modal editar

        } else if (window._camaraFieldId) {
            // Contexto: formulario de registro original
            document.getElementById(window._camaraFieldId).value = base64;
            var pDiv = document.getElementById('preview-' + (window._camaraPrefixPreview || ''));
            var pImg = document.getElementById('preview-' + (window._camaraPrefixPreview || '') + '-img');
            if (pDiv && pImg) { pImg.src = dataUrl; pDiv.style.display = 'block'; }
        }

        $('#modalCamara').modal('hide');
    });

    // ── Envío AJAX formulario editar ──────────────────────────────────────
    $(document).on('submit', '[id^="form-editar-"]', function (e) {
        e.preventDefault();
        var form = $(this);
        var btn  = form.find('button[type="submit"]');
        var textoOriginal = btn.html();

        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

        $.ajax({
            url:  form.attr('action'),
            type: 'PATCH',
            data: form.serialize(),
            success: function () {
                form.closest('.modal').modal('hide');
                setTimeout(function () { location.reload(); }, 400);
            },
            error: function (xhr) {
                btn.prop('disabled', false).html(textoOriginal);
                var msg = 'Error al guardar los cambios.';
                try {
                    var json = JSON.parse(xhr.responseText);
                    if (json.errors) msg = json.errors.join('\n');
                } catch (ex) {}
                alert(msg);
            }
        });
    });
</script>
