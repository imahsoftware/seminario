                              </div>
                            </div>
                          <% end %>
                          <div id="editar-preview-frente-<%= ep.id %>" style="display:none; margin-bottom:8px;">
                            <p class="text-success" style="margin-bottom:4px; font-size:12px;">
                              <i class="fa fa-check-circle"></i> <strong>Nueva foto capturada:</strong>
                            </p>
                            <img id="editar-preview-frente-img-<%= ep.id %>" src="#" alt="Frente nueva"
                                 style="max-width:100%; max-height:150px; border:2px solid #5cb85c; border-radius:4px;"/>
                          </div>
                          <button type="button" class="btn btn-warning btn-sm btn-block"
                                  onclick="abrirCamaraEditar('frente', 'editar-cedula-frente-<%= ep.id %>', '<%= ep.id %>')">
                            <i class="fa fa-camera"></i>
                            <%= documento.present? && documento.cedula_frente.present? ? 'Cambiar Foto Frente' : 'Capturar Frente' %>
