<%
  hoy       = Date.today
  todos     = @q.result
  menores   = todos.select { |p| p.fecha_nacimiento.present? && ((hoy - p.fecha_nacimiento.to_date).to_i / 365.25) < 18 }
  mayores   = todos.select { |p| p.fecha_nacimiento.present? && ((hoy - p.fecha_nacimiento.to_date).to_i / 365.25) >= 18 }
  sin_fecha = todos.select { |p| p.fecha_nacimiento.blank? }
  autorizados    = menores.select { |p| p.acudiente_firma == 'SI' }
  no_autorizados = menores.select { |p| p.acudiente_firma == 'NO' }
  pendientes     = menores.select { |p| p.acudiente_firma.blank? }
%>

<div class="box box-danger">

  <%# ── HEADER ──────────────────────────────────────────────────────── %>
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-users"></i> Personas Inscritas</h3>
    <div class="box-tools pull-right">
      <%= search_form_for @q,
                          url: edit_evento_path(@evento),
                          method: :get do |f| %>
        <div class="input-group input-group-sm" style="width: 250px;">
          <%= f.search_field :identificacion_or_nombre_or_apellido_or_email_or_celular_cont,
                             onChange: 'javascript:this.value=this.value.toUpperCase();',
                             class: 'form-control input_uppercase',
                             placeholder: 'Buscar...' %>
          <div class="input-group-btn">
            <%= button_tag(type: "submit", class: "btn btn-default") do %>
              <i class="fa fa-search"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── INDICADORES ─────────────────────────────────────────────────── %>
  <div class="box-body" style="padding-bottom: 0;">
    <div class="row">

      <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-aqua">
          <span class="info-box-icon"><i class="fa fa-users"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Total Inscritos</span>
            <span class="info-box-number"><%= todos.count %></span>
          </div>
        </div>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-green">
          <span class="info-box-icon"><i class="fa fa-user"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Mayores de Edad</span>
            <span class="info-box-number"><%= mayores.count %></span>
          </div>
        </div>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-yellow">
          <span class="info-box-icon"><i class="fa fa-child"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Menores de Edad</span>
            <span class="info-box-number"><%= menores.count %></span>
          </div>
        </div>
      </div>

      <% if sin_fecha.any? %>
        <div class="col-md-3 col-sm-6 col-xs-12">
          <div class="info-box bg-red">
            <span class="info-box-icon"><i class="fa fa-question-circle"></i></span>
            <div class="info-box-content">
              <span class="info-box-text">Sin Fecha Nac.</span>
              <span class="info-box-number"><%= sin_fecha.count %></span>
            </div>
          </div>
        </div>
      <% end %>


      <%# ── Autorización menores ── %>
      <% if menores.any? %>
        <div class="col-xs-12"><hr style="margin:8px 0 10px; border-color:#ddd;"><p class="text-muted" style="font-size:12px; margin:0 0 8px;"><i class="fa fa-info-circle"></i> <strong>Estado de autorización (menores)</strong></p></div>
        <div class="col-md-4 col-sm-6 col-xs-12">
          <div class="info-box bg-green">
            <span class="info-box-icon"><i class="fa fa-check-circle"></i></span>
            <div class="info-box-content">
              <span class="info-box-text">Autorizados</span>
              <span class="info-box-number"><%= autorizados.count %></span>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12">
          <div class="info-box bg-red">
            <span class="info-box-icon"><i class="fa fa-times-circle"></i></span>
            <div class="info-box-content">
              <span class="info-box-text">No Autorizados</span>
              <span class="info-box-number"><%= no_autorizados.count %></span>
            </div>
          </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12">
          <div class="info-box bg-orange">
            <span class="info-box-icon"><i class="fa fa-clock-o"></i></span>
            <div class="info-box-content">
              <span class="info-box-text">Pendientes</span>
              <span class="info-box-number"><%= pendientes.count %></span>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# ── TABLA ───────────────────────────────────────────────────────── %>
  <div class="box-body table-responsive">
    <table class="table table-bordered table-hover table-striped">
      <thead>
      <tr class="thcolor">
        <th class="text-center" style="width: 60px;">Ver</th>
        <th class="text-center">Identificación</th>
        <th>Nombre Completo</th>
        <th class="text-center">Edad</th>
        <th class="text-center">Celular</th>
        <th>Email</th>
        <th class="text-center">Inscripción</th>
        <th>Acudiente / Celular</th>
      </tr>
      </thead>

      <tbody id="tbody_eventospersonas">
      <% @eventospersonas.each do |ep| %>
        <%
          edad     = ep.fecha_nacimiento.present? ? ((Date.today - ep.fecha_nacimiento.to_date).to_i / 365.25).floor : nil
          es_menor = edad.present? && edad < 18
          persona_doc = Persona.find_by(identificacion: ep.identificacion)
          documento = persona_doc.present? ? Documento.find_by(persona_id: persona_doc.id) : nil
        %>

        <tr class="<%= es_menor ? 'warning' : '' %>">

          <%# Botón Ver Detalle %>
          <td class="text-center">
            <button class="btn btn-xs btn-primary btn-detalle-persona"
                    data-id="<%= ep.id %>"
                    data-toggle="tooltip"
                    title="Ver detalle completo">
              <i class="fa fa-eye"></i>
            </button>
          </td>

          <td class="text-center"><%= ep.identificacion %></td>
          <td><%= "#{ep.nombre} #{ep.apellido}".strip %></td>

          <td class="text-center">
            <% if edad.present? %>
              <span class="badge <%= es_menor ? 'bg-yellow' : 'bg-green' %>">
                <%= edad %> años
              </span>
            <% else %>
              <span class="label label-default">N/D</span>
            <% end %>
          </td>

          <td class="text-center"><%= ep.celular %></td>
          <td><%= ep.email %></td>

          <td class="text-center">
            <%= ep.created_at.strftime('%d/%m/%Y %H:%M') rescue 'N/D' %>
          </td>

          <td>
            <% if es_menor %>
              <% nombre_ac = "#{ep.acudiente_nombre} #{ep.acudiente_apellido}".strip %>
              <% if nombre_ac.present? %>
                <i class="fa fa-user-circle text-yellow"></i>
                <strong><%= nombre_ac %></strong><br>
                <% if ep.acudiente_celular.present? %>
                  <i class="fa fa-phone text-muted"></i>
                  <small><%= ep.acudiente_celular %></small>
                <% end %>
              <% else %>
                <span class="label label-danger">Sin acudiente</span>
              <% end %>
              <%# ── Badge estado autorización ── %>
              <div style="margin-top:5px;">
                <% if ep.acudiente_firma == 'SI' %>
                  <span class="label label-success">
                    <i class="fa fa-check-circle"></i> Autorizado
                  </span>
                <% elsif ep.acudiente_firma == 'NO' %>
                  <span class="label label-danger">
                    <i class="fa fa-times-circle"></i> No Autorizado
                  </span>
                <% else %>
                  <span class="label label-warning">
                    <i class="fa fa-clock-o"></i> Pendiente
                  </span>
                <% end %>
              </div>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>

        </tr>

        <%# ── MODAL DE DETALLE ─────────────────────────────────────── %>
        <div class="modal fade"
             id="modal-persona-<%= ep.id %>"
             tabindex="-1"
             role="dialog">
          <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

              <div class="modal-header <%= es_menor ? 'bg-yellow' : 'bg-primary' %>"
                   style="color:#fff; border-radius: 3px 3px 0 0;">
                <button type="button" class="close" data-dismiss="modal"
                        style="color:#fff; opacity:1;">
                  <span>&times;</span>
                </button>
                <h4 class="modal-title">
                  <i class="fa fa-user"></i>
                  <%= "#{ep.nombre} #{ep.apellido}".strip %>
                  <% if es_menor %>
                    <small style="font-size:12px; margin-left:8px;">
                      <span class="label label-warning">
                        <i class="fa fa-child"></i> MENOR DE EDAD
                      </span>
                    </small>
                  <% end %>
                </h4>
              </div>

              <div class="modal-body" style="padding: 20px 25px;">

                <%# ── Datos Personales ── %>
                <div class="box box-solid box-primary" style="margin-bottom:15px;">
                  <div class="box-header with-border" style="padding: 8px 12px;">
                    <h4 class="box-title"><i class="fa fa-id-card"></i> Datos Personales</h4>
                  </div>
                  <div class="box-body" style="padding: 12px 15px;">
                    <div class="row">

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Identificación</small></p>
                        <p><strong><%= ep.identificacion %></strong></p>
                      </div>

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Nombre Completo</small></p>
                        <p><strong><%= "#{ep.nombre} #{ep.apellido}".strip %></strong></p>
                      </div>

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Fecha de Nacimiento</small></p>
                        <p>
                          <strong><%= ep.fecha_nacimiento.present? ? ep.fecha_nacimiento.strftime('%d/%m/%Y') : 'N/D' %></strong>
                          <% if edad.present? %>
                            <span class="badge <%= es_menor ? 'bg-yellow' : 'bg-green' %>">
                              <%= edad %> años
                            </span>
                          <% end %>
                        </p>
                      </div>

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Sexo</small></p>
                        <p>
                          <% if ep.sexo == 'M' %>
                            <i class="fa fa-mars text-primary"></i> <strong>Masculino</strong>
                          <% elsif ep.sexo == 'F' %>
                            <i class="fa fa-venus text-danger"></i> <strong>Femenino</strong>
                          <% else %>
                            <strong><%= ep.sexo.presence || 'N/D' %></strong>
                          <% end %>
                        </p>
                      </div>

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Estado Civil</small></p>
                        <p><strong><%= ep.estado_civil.nombre rescue 'N/D' %></strong></p>
                      </div>

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Tipo Persona</small></p>
                        <p><strong><%= ep.tipo_persona.presence || 'N/D' %></strong></p>
                      </div>

                    </div>
                  </div>
                </div>

                <%# ── Contacto ── %>
                <div class="box box-solid box-info" style="margin-bottom:15px;">
                  <div class="box-header with-border" style="padding: 8px 12px;">
                    <h4 class="box-title"><i class="fa fa-phone"></i> Contacto</h4>
                  </div>
                  <div class="box-body" style="padding: 12px 15px;">
                    <div class="row">

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Celular</small></p>
                        <p>
                          <i class="fa fa-mobile text-info"></i>
                          <strong><%= ep.celular.presence || 'N/D' %></strong>
                        </p>
                      </div>

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Email</small></p>
                        <p>
                          <i class="fa fa-envelope text-info"></i>
                          <strong><%= ep.email.presence || 'N/D' %></strong>
                        </p>
                      </div>

                      <div class="col-md-4 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Dirección</small></p>
                        <p>
                          <i class="fa fa-map-marker text-info"></i>
                          <strong><%= ep.direccion.presence || 'N/D' %></strong>
                        </p>
                      </div>

                    </div>
                  </div>
                </div>

                <%# ── Documentos de Identidad ── %>
                <% if documento.present? %>
                  <div class="box box-solid box-success" style="margin-bottom:15px;">
                    <div class="box-header with-border" style="padding: 8px 12px;">
                      <h4 class="box-title">
                        <i class="fa fa-id-card-o"></i> Documentos de Identidad
                      </h4>
                    </div>
                    <div class="box-body" style="padding: 16px 20px;">
                      <div class="row">

                        <%# ── Cédula Frente ── %>
                        <div class="col-md-6 col-sm-12" style="margin-bottom: 10px;">
                          <p class="text-muted text-center" style="margin-bottom: 8px;">
                            <i class="fa fa-id-card text-success"></i>
                            <small><strong>Cédula — Frente</strong></small>
                          </p>
                          <% if documento.cedula_frente.present? %>
                            <% if documento.cedula_frente_content_type == 'application/pdf' %>
                              <div class="text-center" style="padding: 20px; background: #f9f9f9; border: 1px dashed #ccc; border-radius: 6px;">
                                <i class="fa fa-file-pdf-o fa-3x text-danger"></i><br>
                                <a href="<%= documento.cedula_frente.url %>"
                                   target="_blank"
                                   class="btn btn-sm btn-danger" style="margin-top: 10px;">
                                  <i class="fa fa-download"></i> Ver PDF
                                </a>
                              </div>
                            <% else %>
                              <div class="doc-img-wrap" style="border: 2px solid #00a65a; border-radius: 8px; overflow: hidden; background: #f4f4f4; text-align: center; cursor: pointer;"
                                   onclick="abrirImagen('<%= documento.cedula_frente.url %>', 'Cédula Frente — <%= "#{ep.nombre} #{ep.apellido}".strip %>')">
                                <%= image_tag documento.cedula_frente.url,
                                              style: 'width:100%; max-height:180px; object-fit:cover; display:block;',
                                              alt: 'Cédula Frente' %>
                                <div style="padding: 6px; font-size: 11px; color: #555;">
                                  <i class="fa fa-search-plus"></i> Click para ampliar
                                </div>
                              </div>
                            <% end %>
                          <% else %>
                            <div class="text-center text-muted" style="padding: 30px; background: #f9f9f9; border: 1px dashed #ddd; border-radius: 6px;">
                              <i class="fa fa-picture-o fa-2x"></i><br>
                              <small>Sin imagen</small>
                            </div>
                          <% end %>
                        </div>

                        <%# ── Cédula Reverso ── %>
                        <div class="col-md-6 col-sm-12" style="margin-bottom: 10px;">
                          <p class="text-muted text-center" style="margin-bottom: 8px;">
                            <i class="fa fa-id-card-o text-success"></i>
                            <small><strong>Cédula — Reverso</strong></small>
                          </p>
                          <% if documento.cedula_reverso.present? %>
                            <% if documento.cedula_reverso_content_type == 'application/pdf' %>
                              <div class="text-center" style="padding: 20px; background: #f9f9f9; border: 1px dashed #ccc; border-radius: 6px;">
                                <i class="fa fa-file-pdf-o fa-3x text-danger"></i><br>
                                <a href="<%= documento.cedula_reverso.url %>"
                                   target="_blank"
                                   class="btn btn-sm btn-danger" style="margin-top: 10px;">
                                  <i class="fa fa-download"></i> Ver PDF
                                </a>
                              </div>
                            <% else %>
                              <div class="doc-img-wrap" style="border: 2px solid #00a65a; border-radius: 8px; overflow: hidden; background: #f4f4f4; text-align: center; cursor: pointer;"
                                   onclick="abrirImagen('<%= documento.cedula_reverso.url %>', 'Cédula Reverso — <%= "#{ep.nombre} #{ep.apellido}".strip %>')">
                                <%= image_tag documento.cedula_reverso.url,
                                              style: 'width:100%; max-height:180px; object-fit:cover; display:block;',
                                              alt: 'Cédula Reverso' %>
                                <div style="padding: 6px; font-size: 11px; color: #555;">
                                  <i class="fa fa-search-plus"></i> Click para ampliar
                                </div>
                              </div>
                            <% end %>
                          <% else %>
                            <div class="text-center text-muted" style="padding: 30px; background: #f9f9f9; border: 1px dashed #ddd; border-radius: 6px;">
                              <i class="fa fa-picture-o fa-2x"></i><br>
                              <small>Sin imagen</small>
                            </div>
                          <% end %>
                        </div>

                      </div>
                    </div>
                  </div>
                <% end %>

                <%# ── Acudiente (solo menores) ── %>
                <% if es_menor %>
                  <div class="box box-solid box-warning" style="margin-bottom:15px;">
                    <div class="box-header with-border" style="padding: 8px 12px;">
                      <h4 class="box-title"><i class="fa fa-user-plus"></i> Datos del Acudiente</h4>
                    </div>
                    <div class="box-body" style="padding: 12px 15px;">
                      <div class="row">

                        <div class="col-md-4 col-sm-6">
                          <p class="text-muted" style="margin-bottom:2px;"><small>Nombre Acudiente</small></p>
                          <p><strong><%= "#{ep.acudiente_nombre} #{ep.acudiente_apellido}".strip.presence || 'N/D' %></strong></p>
                        </div>

                        <div class="col-md-4 col-sm-6">
                          <p class="text-muted" style="margin-bottom:2px;"><small>Identificación</small></p>
                          <p><strong><%= ep.acudiente_identificacion.presence || 'N/D' %></strong></p>
                        </div>

                        <div class="col-md-4 col-sm-6">
                          <p class="text-muted" style="margin-bottom:2px;"><small>Celular</small></p>
                          <p>
                            <i class="fa fa-mobile text-warning"></i>
                            <strong><%= ep.acudiente_celular.presence || 'N/D' %></strong>
                          </p>
                        </div>

                        <div class="col-md-4 col-sm-6">
                          <p class="text-muted" style="margin-bottom:2px;"><small>Email</small></p>
                          <p>
                            <i class="fa fa-envelope text-warning"></i>
                            <strong><%= ep.acudiente_email.presence || 'N/D' %></strong>
                          </p>
                        </div>

                        <div class="col-md-4 col-sm-6">
                          <p class="text-muted" style="margin-bottom:2px;"><small>Código Validación</small></p>
                          <p><strong><%= ep.acudiente_codigoval.presence || 'N/D' %></strong></p>
                        </div>

                        <div class="col-md-4 col-sm-6">
                          <p class="text-muted" style="margin-bottom:2px;"><small>Código Recepción</small></p>
                          <p><strong><%= ep.acudiente_codigorec.presence || 'N/D' %></strong></p>
                        </div>

                        <div class="col-md-12">
                          <p class="text-muted" style="margin-bottom:2px;"><small>Autorización</small></p>
                          <% if ep.acudiente_firma == 'SI' %>
                            <span class="label label-success" style="font-size:13px; padding:5px 10px;">
                              <i class="fa fa-check-circle"></i> Autorizado por el acudiente
                            </span>
                          <% elsif ep.acudiente_firma == 'NO' %>
                            <span class="label label-danger" style="font-size:13px; padding:5px 10px;">
                              <i class="fa fa-times-circle"></i> No autorizado por el acudiente
                            </span>
                          <% else %>
                            <span class="label label-warning" style="font-size:13px; padding:5px 10px;">
                              <i class="fa fa-clock-o"></i> Pendiente de autorización
                            </span>
                          <% end %>
                        </div>

                      </div>
                    </div>
                  </div>
                <% end %>

                <%# ── Autorizaciones y Registro ── %>
                <div class="box box-solid box-default" style="margin-bottom:0;">
                  <div class="box-header with-border" style="padding: 8px 12px;">
                    <h4 class="box-title"><i class="fa fa-check-square-o"></i> Autorizaciones y Registro</h4>
                  </div>
                  <div class="box-body" style="padding: 12px 15px;">
                    <div class="row">

                      <div class="col-md-3 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Acepta Política</small></p>
                        <p>
                          <% if ep.acepta_politica == 'SI' %>
                            <span class="label label-success"><i class="fa fa-check"></i> SI</span>
                          <% else %>
                            <span class="label label-danger"><i class="fa fa-times"></i> NO</span>
                          <% end %>
                        </p>
                      </div>

                      <div class="col-md-3 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Acepta Cultura</small></p>
                        <p>
                          <% if ep.acepta_cultura == 'SI' %>
                            <span class="label label-success"><i class="fa fa-check"></i> SI</span>
                          <% else %>
                            <span class="label label-danger"><i class="fa fa-times"></i> NO</span>
                          <% end %>
                        </p>
                      </div>

                      <div class="col-md-3 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Fecha Inscripción</small></p>
                        <p>
                          <i class="fa fa-calendar text-muted"></i>
                          <strong><%= ep.created_at.strftime('%d/%m/%Y %H:%M') rescue 'N/D' %></strong>
                        </p>
                      </div>

                      <div class="col-md-3 col-sm-6">
                        <p class="text-muted" style="margin-bottom:2px;"><small>Última Actualización</small></p>
                        <p>
                          <i class="fa fa-refresh text-muted"></i>
                          <strong><%= ep.updated_at.strftime('%d/%m/%Y %H:%M') rescue 'N/D' %></strong>
                        </p>
                      </div>

                    </div>
                  </div>
                </div>

              </div><%# fin modal-body %>

              <div class="modal-footer">
                <small class="text-muted pull-left">
                  ID: <strong>#<%= ep.id %></strong> &nbsp;|&nbsp;
                  Evento: <strong>#<%= ep.evento_id %></strong>
                </small>
                <button type="button" class="btn btn-default" data-dismiss="modal">
                  <i class="fa fa-times"></i> Cerrar
                </button>
              </div>

            </div>
          </div>
        </div><%# fin modal %>

        <% end %><%# fin each %>

      <% if @eventospersonas.empty? %>
        <tr>
          <td colspan="8" class="text-center text-muted" style="padding: 30px;">
            <i class="fa fa-info-circle"></i> No se encontraron personas inscritas.
          </td>
        </tr>
      <% end %>

      </tbody>
    </table>
  </div>

  <%# ── PAGINACIÓN ──────────────────────────────────────────────────── %>
  <div class="box-footer clearfix">
    <div class="pull-right">
      <%= will_paginate @eventospersonas, renderer: BootstrapPagination::Rails %>
    </div>
    <div class="pull-left text-muted" style="padding-top: 6px;">
      <small>
        Mostrando <%= @eventospersonas.offset_value + 1 %> –
        <%= [@eventospersonas.offset_value + @eventospersonas.length, @eventospersonas.total_entries].min %>
        de <%= @eventospersonas.total_entries %> registros
      </small>
    </div>
  </div>

</div>

<%# ── LIGHTBOX PARA AMPLIAR IMÁGENES ─────────────────────────────────── %>
<div id="lightbox-doc"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85);
       z-index:99999; align-items:center; justify-content:center; flex-direction:column;">
  <div style="position:relative; max-width:90vw; max-height:88vh;">
    <button onclick="cerrarLightbox()"
            style="position:absolute; top:-14px; right:-14px; background:#fff;
              border:none; border-radius:50%; width:32px; height:32px;
              font-size:18px; cursor:pointer; line-height:30px; text-align:center;
              box-shadow:0 2px 8px rgba(0,0,0,0.4); color:#333;">
      &times;
    </button>
    <p id="lightbox-titulo"
       style="color:#fff; text-align:center; font-size:13px; margin-bottom:8px; font-weight:600;"></p>
    <img id="lightbox-img"
         src=""
         style="max-width:90vw; max-height:80vh; border-radius:8px;
           box-shadow:0 8px 40px rgba(0,0,0,0.6); display:block;">
  </div>
</div>

<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();

        $('.btn-detalle-persona').on('click', function () {
            var id = $(this).data('id');
            $('#modal-persona-' + id).modal('show');
        });
    });

    function abrirImagen(url, titulo) {
        $('#lightbox-img').attr('src', url);
        $('#lightbox-titulo').text(titulo);
        $('#lightbox-doc').css('display', 'flex');
    }

    function cerrarLightbox() {
        $('#lightbox-doc').css('display', 'none');
        $('#lightbox-img').attr('src', '');
    }

    // Cerrar con click fuera de la imagen
    document.getElementById('lightbox-doc').addEventListener('click', function (e) {
        if (e.target === this) cerrarLightbox();
    });

    // Cerrar con ESC
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') cerrarLightbox();
    });
</script>
