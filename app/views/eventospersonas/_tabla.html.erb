                              <%= select_tag "eventospersona[acudiente_documento_tipo_id]",
                                             options_from_collection_for_select(DocumentoTipo.where(estado: 'activo').order(:nombre), :id, :nombre, ep.acudiente_documento_tipo_id),
                                             class: 'form-control input-sm', include_blank: 'Seleccione...' %>
