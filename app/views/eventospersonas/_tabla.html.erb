<%
    hoy          = Date.today
    todos        = @q.result
    menores      = todos.select { |p| p.fecha_nacimiento.present? && ((hoy - p.fecha_nacimiento.to_date).to_i / 365.25) < 18 }
    mayores      = todos.select { |p| p.fecha_nacimiento.present? && ((hoy - p.fecha_nacimiento.to_date).to_i / 365.25) >= 18 }
    sin_fecha    = todos.select { |p| p.fecha_nacimiento.blank? }
    presbiteros  = todos.select { |p| p.tipo_persona == 'PRESBÍTERO' }
    
    # Matrimonios
    matrimonios_todos = todos.select { |p| p.tipo_persona == 'MATRIMONIO' }
    
    # Matrimonios completos (entrelazados): ambos tienen conyuge_id apuntando al otro
    matrimonios_completos = matrimonios_todos.select do |p|
      if p.conyuge_id.present? && p.conyuge_pendiente != 1
        conyuge = todos.find { |c| c.id == p.conyuge_id }
        conyuge.present? && conyuge.conyuge_id == p.id
      else
        false
      end
    end
    
    # Matrimonios pendientes: tienen conyuge_pendiente = 1
    matrimonios_pendientes = matrimonios_todos.select { |p| p.conyuge_pendiente == 1 }
%>

<div class="box box-danger">

  <%# ── HEADER ──────────────────────────────────────────────────────── %>
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-users"></i> Personas Inscritas</h3>
    <div class="box-tools pull-right">
      <%= search_form_for @q,
                          url: edit_evento_path(@evento),
                          method: :get do |f| %>
        <div class="input-group input-group-sm" style="width: 250px;">
          <%= f.search_field :identificacion_or_nombre_or_apellido_or_email_or_celular_cont,
                             onChange: 'javascript:this.value=this.value.toUpperCase();',
                             class: 'form-control input_uppercase',
                             placeholder: 'Buscar...' %>
          <div class="input-group-btn">
            <%= button_tag(type: "submit", class: "btn btn-default") do %>
              <i class="fa fa-search"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── INDICADORES ─────────────────────────────────────────────────── %>
  <div class="box-body" style="padding-bottom: 0;">
    <div class="row">

      <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-aqua">
          <span class="info-box-icon"><i class="fa fa-users"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Total Inscritos</span>
            <span class="info-box-number"><%= todos.count %></span>
          </div>
        </div>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-green">
          <span class="info-box-icon"><i class="fa fa-user"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Mayores de Edad</span>
            <span class="info-box-number"><%= mayores.count %></span>
          </div>
        </div>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-yellow">
          <span class="info-box-icon"><i class="fa fa-child"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Menores de Edad</span>
            <span class="info-box-number"><%= menores.count %></span>
          </div>
        </div>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-purple">
          <span class="info-box-icon"><i class="fa fa-cross"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Presbíteros</span>
            <span class="info-box-number"><%= presbiteros.count %></span>
          </div>
        </div>
      </div>

    </div>

    <%# Segunda fila de indicadores - Matrimonios %>
    <div class="row">

      <div class="col-md-4 col-sm-6 col-xs-12">
        <div class="info-box bg-teal">
          <span class="info-box-icon"><i class="fa fa-heart"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Matrimonios Completos</span>
            <span class="info-box-number"><%= matrimonios_completos.count / 2 %></span>
            <span class="info-box-text" style="font-size: 11px;">(<%= matrimonios_completos.count %> personas)</span>
          </div>
        </div>
      </div>

      <div class="col-md-4 col-sm-6 col-xs-12">
        <div class="info-box bg-orange">
          <span class="info-box-icon"><i class="fa fa-clock-o"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Matrimonios Pendientes</span>
            <span class="info-box-number"><%= matrimonios_pendientes.count %></span>
          </div>
        </div>
      </div>

      <% if sin_fecha.any? %>
        <div class="col-md-4 col-sm-6 col-xs-12">
          <div class="info-box bg-red">
            <span class="info-box-icon"><i class="fa fa-question-circle"></i></span>
            <div class="info-box-content">
              <span class="info-box-text">Sin Fecha Nac.</span>
              <span class="info-box-number"><%= sin_fecha.count %></span>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# ── TABLA ───────────────────────────────────────────────────────── %>
  <div class="box-body table-responsive">
    <table class="table table-bordered table-hover table-striped">
      <thead>
      <tr class="thcolor">
        <th class="text-center" style="width: 120px;">Acciones</th>
        <th class="text-center">Identificación</th>
        <th>Nombre Completo</th>
        <th class="text-center">Edad</th>
        <th class="text-center">Celular</th>
        <th>Email</th>
        <th class="text-center">Inscripción</th>
        <th>Acudiente / Celular</th>
      </tr>
      </thead>

      <tbody id="tbody_eventospersonas">
      <% @eventospersonas.each do |ep| %>
        <%
            edad          = ep.fecha_nacimiento.present? ? ((Date.today - ep.fecha_nacimiento.to_date).to_i / 365.25).floor : nil
            es_menor      = edad.present? && edad < 18
            es_presbitero = ep.tipo_persona == 'PRESBÍTERO'
            
            # Determinar clase de fila: presbítero tiene prioridad sobre menor
            clase_fila = if es_presbitero
                          'info'  # Color azul/celeste para presbíteros
                        elsif es_menor
                          'warning'  # Color amarillo para menores
                        else
                          ''
                        end
        %>

        <tr class="<%= clase_fila %>">

          <td class="text-center">
            <%# Solo guardamos el id — el contenido del modal se carga por AJAX %>
            <button class="btn btn-xs btn-primary btn-detalle-persona"
                    data-id="<%= ep.id %>"
                    data-toggle="tooltip"
                    title="Ver detalle completo">
              <i class="fa fa-eye"></i>
            </button>
            <% if is_auth_c('eventos') %>
              <button class="btn btn-xs btn-warning btn-editar-persona"
                      data-id="<%= ep.id %>"
                      data-toggle="tooltip"
                      title="Editar persona">
                <i class="fa fa-pencil"></i>
              </button>

              <%= link_to eventospersona_path(ep),
                          method: :delete,
                          data: { confirm: "¿Estás seguro de eliminar a #{ep.nombre} #{ep.apellido}?\n\nEsta acción guardará el registro en el historial de eliminados." },
                          class: 'btn btn-xs btn-danger',
                          title: 'Eliminar persona' do %>
                <i class="fa fa-trash"></i>
              <% end %>
            <% end %>
          </td>

          <td class="text-center"><%= ep.identificacion %></td>
          <td><%= "#{ep.nombre} #{ep.apellido}".strip %></td>

          <td class="text-center">
            <% if edad.present? %>
                <span class="badge <%= es_menor ? 'bg-yellow' : 'bg-green' %>">
                  <%= edad %> años
                </span>
            <% else %>
              <span class="label label-default">N/D</span>
            <% end %>
          </td>

          <td class="text-center"><%= ep.celular %></td>
          <td><%= ep.email %></td>

          <td class="text-center">
            <%= ep.created_at.strftime('%d/%m/%Y %H:%M') rescue 'N/D' %>
          </td>

          <td>
            <% if es_menor %>
              <% nombre_ac = "#{ep.acudiente_nombre} #{ep.acudiente_apellido}".strip %>
              <% if nombre_ac.present? %>
                <i class="fa fa-user-circle text-yellow"></i>
                <strong><%= nombre_ac %></strong><br>
                <% if ep.acudiente_celular.present? %>
                  <i class="fa fa-phone text-muted"></i>
                  <small><%= ep.acudiente_celular %></small>
                <% end %>
              <% else %>
                <span class="label label-danger">Sin acudiente</span>
              <% end %>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>

        </tr>
      <% end %>

      <% if @eventospersonas.empty? %>
        <tr>
          <td colspan="8" class="text-center text-muted" style="padding: 30px;">
            <i class="fa fa-info-circle"></i> No se encontraron personas inscritas.
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <%# ── PAGINACIÓN ──────────────────────────────────────────────────── %>
  <div class="box-footer clearfix">
    <div class="pull-right">
      <%= will_paginate @eventospersonas, renderer: BootstrapPagination::Rails %>
    </div>
    <div class="pull-left text-muted" style="padding-top: 6px;">
      <small>
        Mostrando <%= @eventospersonas.offset_value + 1 %> –
        <%= [@eventospersonas.offset_value + @eventospersonas.length, @eventospersonas.total_entries].min %>
        de <%= @eventospersonas.total_entries %> registros
      </small>
    </div>
  </div>

</div><%# fin box %>

<%# ══════════════════════════════════════════════════════════════════════
    DOS MODALES GLOBALES — vacíos, se llenan por AJAX bajo demanda
    Solo se renderizan UNA VEZ, independientemente de cuántas personas haya
    ══════════════════════════════════════════════════════════════════════ %>

<%# Modal DETALLE %>
<div class="modal fade" id="modal-detalle-global" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content" id="modal-detalle-content">
      <%# Contenido inyectado por AJAX %>
    </div>
  </div>
</div>

<%# Modal EDITAR %>
<div class="modal fade" id="modal-editar-global" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content" id="modal-editar-content">
      <%# Contenido inyectado por AJAX %>
    </div>
  </div>
</div>

<%# Modal CÁMARA — sigue siendo único, sin cambios %>
<div class="modal fade" id="modalCamara" tabindex="-1" role="dialog"
     style="padding:0 !important; overflow:hidden !important;">
  <div class="modal-dialog modal-camara-custom" role="document">
    <div class="modal-content modal-camara-content">

      <div class="modal-camara-header">
        <span id="modal-titulo" class="modal-camara-titulo">
          <i class="fa fa-camera"></i> Capturar Documento
        </span>
        <button type="button" class="modal-camara-close" data-dismiss="modal">
          <i class="fa fa-times"></i>
        </button>
      </div>

      <div class="modal-camara-body">
        <div id="camara-flash" class="camara-flash"></div>
        <video id="camara-video" autoplay playsinline class="camara-video" style="display:block;"></video>
        <canvas id="camara-canvas" class="camara-canvas" style="display:none;"></canvas>
        <div id="camara-guia" class="camara-guia">
          <div class="guia-esquina guia-tl"></div>
          <div class="guia-esquina guia-tr"></div>
          <div class="guia-esquina guia-bl"></div>
          <div class="guia-esquina guia-br"></div>
          <span class="guia-texto">Encuadra el documento</span>
        </div>
        <div id="camara-error" class="camara-error-overlay" style="display:none;">
          <i class="fa fa-exclamation-triangle fa-2x"></i>
          <p>No se pudo acceder a la cámara.<br>Verifica los permisos del navegador.</p>
        </div>
        <div id="footer-capturar" class="snap-flotante">
          <button type="button" id="btn-snap" class="btn-camara-snap">
            <span class="btn-snap-circulo"><i class="fa fa-camera"></i></span>
            <span class="btn-snap-label">Tomar Foto</span>
          </button>
        </div>
      </div>

      <div class="modal-camara-footer">
        <div class="footer-cancelar-wrap">
          <button type="button" class="btn-camara-cancelar" data-dismiss="modal" id="btn-cancelar-camara">
            <i class="fa fa-times"></i> Cancelar
          </button>
        </div>
        <div id="footer-confirmar" class="footer-estado" style="display:none;">
          <button type="button" id="btn-usar-foto" class="btn-camara-usar">
            <i class="fa fa-check"></i> Usar esta foto
          </button>
          <button type="button" id="btn-repetir" class="btn-camara-repetir">
            <i class="fa fa-refresh"></i> Repetir
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<%# ── LIGHTBOX ─────────────────────────────────────────────────────────── %>
<div id="lightbox-doc"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85);
       z-index:99999; align-items:center; justify-content:center; flex-direction:column;">
  <div style="position:relative; max-width:90vw; max-height:88vh;">
    <button onclick="cerrarLightbox()"
            style="position:absolute; top:-14px; right:-14px; background:#fff;
              border:none; border-radius:50%; width:32px; height:32px;
              font-size:18px; cursor:pointer; line-height:30px; text-align:center;
              box-shadow:0 2px 8px rgba(0,0,0,0.4); color:#333;">
      &times;
    </button>
    <p id="lightbox-titulo"
       style="color:#fff; text-align:center; font-size:13px; margin-bottom:8px; font-weight:600;"></p>
    <img id="lightbox-img" src=""
         style="max-width:90vw; max-height:80vh; border-radius:8px;
           box-shadow:0 8px 40px rgba(0,0,0,0.6); display:block;">
  </div>
</div>
