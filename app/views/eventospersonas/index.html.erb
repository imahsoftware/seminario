<div class="box box-primary">
  <div class="box-header">
    <legend>
      Personas Inscritas
    </legend>

    <!-- Botón Nuevo a la izquierda -->
    <div class="box-tools pull-left">
      <% if is_auth_c('eventospersonas') %>
        <%= link_to new_eventospersona_path, remote: true, class: 'btn btn-sm btn-info' do %>
          <i class="fa fa-plus-square"></i> <span>Nuevo</span>
        <% end %>&nbsp;&nbsp;
      <% end %>

      <!-- Buscador a la derecha -->
      <div class="box-tools pull-right">
        <%= search_form_for @q do |f| %>
          <div class="input-group input-group-sm" style="width: 200px;">
            <%= f.search_field :identificacion_or_nombre_or_apellido_cont,
                               onChange: 'javascript:this.value=this.value.toUpperCase();',
                               class: 'form-control pull-right input_uppercase',
                               placeholder: 'Buscar...' %>
            <div class="input-group-btn">
              <%= button_tag(type: "submit", class: "btn btn-default") do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <div class="flash_messages"></div>

  <div class="box-body">

    <div id="eventospersonas_form"></div>

    <div id="eventospersonas">
      <% if @eventospersonas.present? %>
        <%= render 'tabla' %>
      <% else %>
        <div class="alert alert-warning">
          <h4><i class="fa fa-info-circle"></i> Atención</h4>
          No hay registros disponibles.
        </div>
      <% end %>
    </div>

    <!-- Paginación -->
    <div class="box-tools pull-right">
      <%= will_paginate @eventospersonas, renderer: BootstrapPagination::Rails %>
    </div>

  </div>
</div>
