<p id="notice"><%= notice %></p>

<h1>Eventospersonas</h1>

<table>
  <thead>
    <tr>
      <th>Evento</th>
      <th>Identificacion</th>
      <th>Nombre</th>
      <th>Apellido</th>
      <th>Fecha nacimiento</th>
      <th>Direccion</th>
      <th>Celular</th>
      <th>Email</th>
      <th>Sexo</th>
      <th>Estado civil</th>
      <th>Acudiente nombre</th>
      <th>Acudiente apellido</th>
      <th>Acudiente identificacion</th>
      <th>Acudiente email</th>
      <th>Acudiente celular</th>
      <th>Acudiente codigoval</th>
      <th>Acudiente codigorec</th>
      <th>Acudiente firma</th>
      <th>Acepta politica</th>
      <th>Acepta cultura</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @eventospersonas.each do |eventospersona| %>
      <tr>
        <td><%= eventospersona.evento %></td>
        <td><%= eventospersona.identificacion %></td>
        <td><%= eventospersona.nombre %></td>
        <td><%= eventospersona.apellido %></td>
        <td><%= eventospersona.fecha_nacimiento %></td>
        <td><%= eventospersona.direccion %></td>
        <td><%= eventospersona.celular %></td>
        <td><%= eventospersona.email %></td>
        <td><%= eventospersona.sexo %></td>
        <td><%= eventospersona.estado_civil %></td>
        <td><%= eventospersona.acudiente_nombre %></td>
        <td><%= eventospersona.acudiente_apellido %></td>
        <td><%= eventospersona.acudiente_identificacion %></td>
        <td><%= eventospersona.acudiente_email %></td>
        <td><%= eventospersona.acudiente_celular %></td>
        <td><%= eventospersona.acudiente_codigoval %></td>
        <td><%= eventospersona.acudiente_codigorec %></td>
        <td><%= eventospersona.acudiente_firma %></td>
        <td><%= eventospersona.acepta_politica %></td>
        <td><%= eventospersona.acepta_cultura %></td>
        <td><%= link_to 'Show', eventospersona %></td>
        <td><%= link_to 'Edit', edit_eventospersona_path(eventospersona) %></td>
        <td><%= link_to 'Destroy', eventospersona, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Eventospersona', new_eventospersona_path %>
