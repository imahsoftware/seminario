<div id="wrapper">
  <div id="right">
    <div id="showcase">
      <div class="showcase-content">
        <div class="showcase-logos">
          <%= image_tag('logos/Recurso_4logo.png', class: 'logo-principal') %>
          <div class="logos-divider"></div>
          <%= image_tag('logos/ancla.png', class: 'logo-ancla') %>
        </div>
      </div>
    </div>
  </div>
  <div id="left">
    <div id="signin">

      <%# ── Logos visibles solo en móvil ── %>
      <div class="mobile-logos">
        <%= image_tag('logos/Recurso_4logo.png', class: 'mobile-logo-principal') %>
        <div class="mobile-logos-divider"></div>
        <%= image_tag('logos/ancla.png', class: 'mobile-logo-ancla') %>
      </div>

      <div class="logo-imah">
        <%= image_tag('Imah-logo.png', class: 'imah-logo-img') %>
      </div>
      <div class="logo">
        <%= render 'users/flash_message_session', titulo: 'Recuperar Contraseña' %>
      </div>
      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <div>
          <label>Usuario</label>
          <%= f.input_field :username, autocomplete: 'off', required: false, autofocus: true, class: 'form-control', placeholder: 'Usuario' %>
        </div>
        <br/>
        <div>
          <%= f.button :submit, 'Aceptar', class: 'primary-btn', disabled_with: 'Iniciando...' %>
        </div>
      <% end %>

      <div class="links">
        <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' and devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
          <ul>
            <li>
              <%= link_to new_password_path(resource_name) do %>
                <span>¿Olvidaste tu contraseña?</span>
              <% end %>
            </li>
          </ul>
        <% else %>
          <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <%= link_to new_password_path(resource_name) do %>
              <span>¿Olvidaste tu contraseña?</span>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <%= render 'layouts/flash_messages' %>
    </div>
    <footer id="main-footer">
      Copyright &copy; <%= Time.now.strftime("%Y") %> <b>ImahSoftware</b> | Todos los derechos reservados.
      <em>(Seminario 2.0)</em>
    </footer>
  </div>
</div>

<style>
    .alert_remove {
        font-size: 14px;
    }

    .callout_message-danger {
        background-color: #071B7D;
        color: #fff;
        padding: 10px;
        border-radius: 5px;
        position: fixed;
        bottom: 10px;
        left: 10px;
        width: calc(100% - 20px);
        max-width: 300px;
        box-shadow: 2px 2px 2px 1px rgba(0, 0, 0, 0.2);
    }

    .callout_message-success {
        background-color: green;
        color: #fff;
        padding: 10px;
        border-radius: 5px;
        position: fixed;
        bottom: 10px;
        left: 10px;
        width: calc(100% - 20px);
        max-width: 300px;
        box-shadow: 2px 2px 2px 1px rgba(0, 0, 0, 0.2);
    }

    @import url('https://fonts.googleapis.com/css?family=Roboto:300');

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Roboto', sans-serif;
        font-weight: 300;
        background: #fff;
        color: #fff;
        overflow: hidden;
        margin: 0;
    }

    h1, h2, h3, h4, h5, h6 {
        font-weight: 300;
    }

    #wrapper {
        display: flex;
        flex-direction: row;
    }

    #left {
        display: flex;
        flex-direction: column;
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background-color: white;
    }

    #right {
        flex: 1;
    }

    /* ── Showcase ── */
    #showcase {
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #E6E6E6;
        height: 100vh;
        text-align: center;
    }

    #showcase .showcase-text {
        font-size: 3rem;
        width: 100%;
        color: #fff;
        margin-bottom: 1.5rem;
    }

    #showcase .secondary-btn {
        width: 60%;
        margin: auto;
    }

    /* ── Logos lado a lado ── */
    .showcase-logos {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 32px;
        padding: 28px 48px;
        background: rgba(255, 255, 255, 0.88);
        border-radius: 18px;
        box-shadow: 0 8px 40px rgba(7, 27, 125, 0.13),
        0 2px 8px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(4px);
    }

    .logo-principal {
        height: 72px;
        width: auto;
        object-fit: contain;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .logo-ancla {
        height: 72px;
        width: auto;
        object-fit: contain;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .logo-principal:hover,
    .logo-ancla:hover {
        transform: scale(1.04);
        opacity: 0.88;
    }

    .logos-divider {
        width: 1px;
        height: 56px;
        background: linear-gradient(to bottom,
        transparent 0%,
        #071B7D44 30%,
        #071B7D88 50%,
        #071B7D44 70%,
        transparent 100%);
        flex-shrink: 0;
    }

    /* ── Logos mobile (ocultos en desktop) ── */
    .mobile-logos {
        display: none;
    }

    /* ── Logo Imah encima del formulario ── */
    .logo-imah {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 2vh;
    }

    .imah-logo-img {
        width: 180px;
        height: auto;
        object-fit: contain;
    }

    /* ── Sign In ── */
    #signin {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 80%;
        padding-bottom: 1rem;
    }

    #signin form {
        width: 80%;
        padding-bottom: 1.8rem;
    }

    #signin .logo {
        margin-bottom: 3vh;
    }

    #signin .logo img {
        width: 300px;
    }

    #signin label {
        font-size: 0.9rem;
        line-height: 2rem;
        font-weight: 500;
        color: #000;
    }

    #signin .text-input {
        margin-bottom: 1.3rem;
        width: 100%;
        border-radius: 2px;
        background: #f1f1f1;
        border: 1px solid #555;
        color: #000;
        padding: 0.5rem 1rem;
        line-height: 1.3rem;
    }

    #signin .primary-btn {
        width: 100%;
    }

    #signin .secondary-btn,
    .or,
    .links {
        width: 60%;
    }

    #signin .links a {
        display: block;
        color: #000000;
        text-decoration: none;
        margin-bottom: 1rem;
        text-align: center;
        font-size: 0.9rem;
    }

    #signin .or {
        display: flex;
        flex-direction: row;
        margin-bottom: 1.2rem;
        align-items: center;
    }

    #signin .or .bar {
        flex: auto;
        border: none;
        height: 1px;
        background: #aaa;
    }

    #signin .or span {
        color: #ccc;
        padding: 0 0.8rem;
    }

    /* ── Footer ── */
    #main-footer {
        color: #C8C8C8;
        text-align: center;
        font-size: 0.8rem;
        max-width: 80%;
        padding-top: 5rem;
    }

    /* ── Botones ── */
    .primary-btn {
        padding: 5px;
        height: 3.7rem;
        display: block;
        border: 0;
        border-radius: 2px;
        font-weight: 500;
        background: #071B7D;
        color: #fff;
        text-decoration: none;
        cursor: pointer;
        text-align: center;
        transition: all 0.5s;
    }

    .primary-btn:hover {
        background-color: #06176B;
        color: #fff;
    }

    .secondary-btn {
        padding: 0.7rem 1rem;
        height: 2.7rem;
        display: block;
        border: 1px solid #f4f4f4;
        border-radius: 2px;
        font-weight: 500;
        background: none;
        color: #fff;
        text-decoration: none;
        cursor: pointer;
        text-align: center;
        transition: all 0.5s;
    }

    .secondary-btn:hover {
        border-color: #071B7D;
        color: #071B7D;
    }

    /* ── Media Queries ── */
    @media (min-width: 1200px) {
        #left  { flex: 4; }
        #right { flex: 6; }
    }

    @media (max-width: 768px) {
        body { overflow: auto; }

        #right { display: none; }

        /* Arriba, sin altura fija para que el scroll funcione */
        #left {
            justify-content: flex-start;
            align-items: center;
            height: auto;
            min-height: 100vh;
            padding: 0 0 2rem 0;
        }

        #signin {
            width: 90%;
            padding-top: 0;
        }

        #signin form { width: 100%; }

        #signin .logo      { margin-bottom: 1.5vh; }
        #signin .text-input { margin-bottom: 0.7rem; }
        #main-footer       { padding-top: 1.5rem; }

        /* Ocultar logo Imah en móvil */
        .logo-imah { display: none; }

        /* Logos mobile: ancho completo, sin que el fondo se quede corto */
        .mobile-logos {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 16px;
            padding: 14px 20px;
            background: #f4f6fb;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(7, 27, 125, 0.10);
            margin-bottom: 2.5vh;
            margin-top: 3vh;
            width: 90%;
            box-sizing: border-box;
        }

        .mobile-logo-principal {
            flex: 1;
            max-width: 65%;
            height: auto;
            max-height: 56px;
            object-fit: contain;
        }

        .mobile-logo-ancla {
            flex: 0 0 auto;
            height: 52px;
            width: auto;
            object-fit: contain;
        }

        .mobile-logos-divider {
            width: 1px;
            height: 40px;
            flex-shrink: 0;
            background: linear-gradient(to bottom,
            transparent 0%,
            #071B7D44 30%,
            #071B7D88 50%,
            #071B7D44 70%,
            transparent 100%);
        }
    }

    .hidden { display: none !important; }
</style>
