<!-- app/views/registro_eventos/exito.html.erb -->
<div class="container" style="margin-top: 50px;">
  <div class="row">
    <div class="col-md-6 col-md-offset-3">
      <div class="panel panel-success">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="fa fa-check-circle"></i> Registro Exitoso
          </h3>
        </div>
        <div class="panel-body text-center">
          <i class="fa fa-check-circle-o" style="font-size: 100px; color: #5cb85c; margin: 30px 0;"></i>
          <h2 style="color: #5cb85c; font-weight: 600;">¡Felicitaciones!</h2>
          <p class="lead" style="font-size: 18px; margin: 20px 0;">
            Tu registro ha sido completado con éxito.
          </p>

          <div class="callout callout-success" style="margin-top: 30px; text-align: left;">
            <h4 style="margin-top: 0;">
              <i class="fa fa-info-circle"></i> Detalles del Evento
            </h4>
            <p style="margin: 10px 0;">
              <strong>Evento:</strong> <%= @evento.detalle %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Fecha del Evento:</strong> <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Fecha del Fin:</strong> <%= @evento.fecha_fin_e.strftime("%d/%m/%Y") rescue '' %>
            </p>
          </div>

          <div style="background: #f9f9f9; padding: 20px; border-radius: 5px; margin-top: 30px;">
            <p class="text-muted" style="margin: 0;">
              <i class="fa fa-envelope"></i> Recibirás más información sobre el evento próximamente. <br>
              <strong>Gracias por tu participación.</strong>
            </p>
          </div>
          <% if is_auth_c('eventos') %>
          <div style="margin-top: 40px;">
            <a href="/" class="btn btn-primary btn-lg" style="background: #071B7D; border-color: #071B7D;">
              <i class="fa fa-home"></i> Volver al Inicio
            </a>
          </div>
            <% end  %>
        </div>
      </div>
    </div>
  </div>
</div>
