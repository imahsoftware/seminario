<!-- app/views/registro_eventos/exito.html.erb -->
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap');

    .ex-page {
        min-height: 100vh;
        background: #f0f2f5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 32px 16px 48px;
        font-family: 'Outfit', sans-serif;
        box-sizing: border-box;
    }

    /* ── Header logos ── */
    .ex-header {
        width: 100%;
        max-width: 560px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 20px 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        margin-bottom: 28px;
        box-sizing: border-box;
    }

    .ex-header-logo-main {
        height: 56px;
        width: auto;
        object-fit: contain;
        flex: 1;
        max-width: 60%;
    }

    .ex-header-divider {
        width: 1px;
        height: 44px;
        flex-shrink: 0;
        background: linear-gradient(to bottom,
        transparent 0%,
        #071B7D55 30%,
        #071B7D99 50%,
        #071B7D55 70%,
        transparent 100%);
    }

    .ex-header-logo-ancla {
        height: 52px;
        width: auto;
        object-fit: contain;
        flex-shrink: 0;
    }

    /* ── Card principal ── */
    .ex-card {
        width: 100%;
        max-width: 560px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.10);
        overflow: hidden;
        box-sizing: border-box;
    }

    /* ── Card top band ── */
    .ex-card-band {
        background: linear-gradient(135deg, #1a7a2e 0%, #27ae60 100%);
        padding: 18px 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ex-card-band h3 {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        letter-spacing: 0.3px;
    }

    .ex-card-band i {
        color: #fff;
        font-size: 20px;
    }

    /* ── Logo Imah dentro de la card ── */
    .ex-imah-wrap {
        display: flex;
        justify-content: center;
        padding: 24px 24px 0;
    }

    .ex-imah-logo {
        height: 52px;
        width: auto;
        object-fit: contain;
    }

    /* ── Card body ── */
    .ex-card-body {
        padding: 20px 28px 30px;
        text-align: center;
    }

    .ex-icon-wrap {
        margin: 10px auto 18px;
        width: 88px;
        height: 88px;
        background: linear-gradient(135deg, #27ae6022, #27ae6011);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #27ae6033;
    }

    .ex-icon-wrap i {
        font-size: 44px;
        color: #27ae60;
    }

    .ex-title {
        font-size: 28px;
        font-weight: 700;
        color: #27ae60;
        margin: 0 0 10px;
    }

    .ex-subtitle {
        font-size: 16px;
        color: #555;
        font-weight: 400;
        margin: 0 0 24px;
        line-height: 1.5;
    }

    /* ── Detalles del evento ── */
    .ex-detalles {
        background: linear-gradient(135deg, #1a7a2e, #27ae60);
        border-radius: 12px;
        padding: 18px 20px;
        text-align: left;
        margin-bottom: 20px;
    }

    .ex-detalles h4 {
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 12px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .ex-detalles ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .ex-detalles ul li {
        color: #e8faf0;
        font-size: 14px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        line-height: 1.4;
    }

    .ex-detalles ul li i {
        color: #a8e6c0;
        font-size: 13px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .ex-detalles ul li strong {
        color: #fff;
    }

    /* ── Info box ── */
    .ex-info {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 14px;
        color: #666;
        display: flex;
        align-items: center;
        gap: 10px;
        text-align: left;
        margin-bottom: 0;
    }

    .ex-info i {
        color: #999;
        font-size: 16px;
        flex-shrink: 0;
    }

    /* ── Botón volver ── */
    .ex-btn-wrap {
        margin-top: 24px;
    }

    .ex-btn-home {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #071B7D;
        color: #fff !important;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        transition: background 0.25s, transform 0.2s;
        border: none;
        cursor: pointer;
    }

    .ex-btn-home:hover {
        background: #06176B;
        transform: translateY(-1px);
        color: #fff !important;
        text-decoration: none;
    }

    /* ── Responsive ── */
    @media (max-width: 600px) {
        .ex-page { padding: 20px 12px 40px; }

        .ex-header {
            padding: 14px 20px;
            gap: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .ex-header-logo-main  { height: 44px; }
        .ex-header-logo-ancla { height: 40px; }
        .ex-header-divider    { height: 36px; }

        .ex-card              { border-radius: 16px; }
        .ex-card-band h3      { font-size: 16px; }
        .ex-card-body         { padding: 16px 18px 24px; }

        .ex-icon-wrap         { width: 72px; height: 72px; }
        .ex-icon-wrap i       { font-size: 36px; }

        .ex-title             { font-size: 24px; }
        .ex-subtitle          { font-size: 15px; }
        .ex-imah-logo         { height: 42px; }
    }
</style>

<div class="ex-page">

  <%# ── Header con logos ── %>
  <div class="ex-header">
    <%= image_tag 'logos/Recurso_4logo.png', class: 'ex-header-logo-main', alt: 'Logo' %>
    <div class="ex-header-divider"></div>
    <%= image_tag 'logos/ancla.png', class: 'ex-header-logo-ancla', alt: 'Ancla' %>
    <div class="ex-header-divider" style="background: linear-gradient(to bottom, transparent 0%, #ccc 30%, #aaa 50%, #ccc 70%, transparent 100%);"></div>
    <%= image_tag 'Imah-logo.png', class: 'ex-imah-logo', alt: 'Imah Software', style: 'height:38px;' %>
  </div>

  <%# ── Card ── %>
  <div class="ex-card">

    <div class="ex-card-band">
      <i class="fa fa-check-circle"></i>
      <h3>Registro Exitoso</h3>
    </div>

    <div class="ex-card-body">

      <div class="ex-icon-wrap">
        <i class="fa fa-check-circle"></i>
      </div>

      <h2 class="ex-title">¡Felicitaciones!</h2>
      <p class="ex-subtitle">
        Tu registro ha sido completado con éxito.
      </p>

      <div class="ex-detalles">
        <h4>
          <i class="fa fa-calendar"></i> Detalles del Evento
        </h4>
        <ul>
          <li>
            <i class="fa fa-bookmark"></i>
            <span><strong>Evento:</strong> <%= @evento.detalle %></span>
          </li>
          <li>
            <i class="fa fa-tag"></i>
            <span><strong>Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %></span>
          </li>
          <li>
            <i class="fa fa-calendar-check-o"></i>
            <span><strong>Fecha inicio:</strong> <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %></span>
          </li>
          <li>
            <i class="fa fa-calendar-times-o"></i>
            <span><strong>Fecha fin:</strong> <%= @evento.fecha_fin_e.strftime("%d/%m/%Y") rescue '' %></span>
          </li>
        </ul>
      </div>

      <div class="ex-info">
        <i class="fa fa-envelope"></i>
        <span>Recibirás más información sobre el evento próximamente. <strong>Gracias por tu participación.</strong></span>
      </div>

      <% if is_auth_c('eventos') %>
        <div class="ex-btn-wrap">
          <a href="/" class="ex-btn-home">
            <i class="fa fa-home"></i> Volver al Inicio
          </a>
        </div>
      <% end %>

    </div>
  </div>

</div>
