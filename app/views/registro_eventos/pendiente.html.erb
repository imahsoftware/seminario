<!-- app/views/registro_eventos/pendiente.html.erb -->
<div class="container" style="margin-top: 50px;">
  <div class="row">
    <div class="col-md-6 col-md-offset-3">
      <div class="panel panel-warning">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="fa fa-clock-o"></i> Registro Pendiente
          </h3>
        </div>
        <div class="panel-body text-center">
          <i class="fa fa-hourglass-half" style="font-size: 100px; color: #f0ad4e; margin: 30px 0;"></i>
          <h2 style="color: #f0ad4e; font-weight: 600;">Tu registro está en proceso</h2>
          <p class="lead" style="font-size: 18px; margin: 20px 0;">
            Hemos recibido tu inscripción correctamente.
          </p>

          <div class="alert alert-info" style="margin-top: 30px; text-align: left;">
            <h4 style="margin-top: 0;">
              <i class="fa fa-info-circle"></i> ¿Qué sigue?
            </h4>
            <p style="margin: 10px 0;">
              Debido a que el participante es menor de edad, el registro quedará
              <strong>pendiente de autorización por parte del acudiente</strong>.
            </p>
            <p style="margin: 10px 0;">
              Una vez se reciba la autorización correspondiente, la inscripción será confirmada.
            </p>
          </div>

          <div class="alert alert-info" style="margin-top: 20px; text-align: left;">
            <h4 style="margin-top: 0;">
              <i class="fa fa-calendar"></i> Detalles del Evento
            </h4>
            <p style="margin: 10px 0;">
              <strong>Evento:</strong> <%= @evento.detalle %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Fecha Inicio:</strong>
              <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Fecha Fin :</strong>
              <%= @evento.fecha_fin_e.strftime("%d/%m/%Y") rescue '' %>
            </p>
          </div>

          <div style="background: #f9f9f9; padding: 20px; border-radius: 5px; margin-top: 30px;">
            <p class="text-muted" style="margin: 0;">
              <i class="fa fa-envelope"></i> Se enviará una notificación cuando el proceso sea completado.
            </p>
          </div>
          <% if is_auth_c('eventos') %>
            <div style="margin-top: 40px;">
              <a href="/" class="btn btn-primary btn-lg">
                <i class="fa fa-home"></i> Volver al Inicio
              </a>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
