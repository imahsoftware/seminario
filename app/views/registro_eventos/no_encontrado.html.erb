<!-- app/views/registro_eventos/no_encontrado.html.erb -->
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap');

    .nf-page {
        min-height: 100vh;
        background: #f0f2f5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 32px 16px 48px;
        font-family: 'Outfit', sans-serif;
        box-sizing: border-box;
    }

    /* ── Header logos ── */
    .nf-header {
        width: 100%;
        max-width: 560px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 20px 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        margin-bottom: 28px;
        box-sizing: border-box;
    }

    .nf-header-logo-main {
        height: 56px;
        width: auto;
        object-fit: contain;
        flex: 1;
        max-width: 60%;
    }

    .nf-header-divider {
        width: 1px;
        height: 44px;
        flex-shrink: 0;
        background: linear-gradient(to bottom,
        transparent 0%,
        #071B7D55 30%,
        #071B7D99 50%,
        #071B7D55 70%,
        transparent 100%);
    }

    .nf-header-logo-ancla {
        height: 52px;
        width: auto;
        object-fit: contain;
        flex-shrink: 0;
    }

    /* ── Card principal ── */
    .nf-card {
        width: 100%;
        max-width: 560px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.10);
        overflow: hidden;
        box-sizing: border-box;
    }

    /* ── Card top band ── */
    .nf-card-band {
        background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
        padding: 18px 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .nf-card-band h3 {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        letter-spacing: 0.3px;
    }

    .nf-card-band i {
        color: #fff;
        font-size: 20px;
    }

    /* ── Logo Imah dentro de la card ── */
    .nf-imah-wrap {
        display: flex;
        justify-content: center;
        padding: 24px 24px 0;
    }

    .nf-imah-logo {
        height: 52px;
        width: auto;
        object-fit: contain;
    }

    /* ── Card body ── */
    .nf-card-body {
        padding: 20px 28px 30px;
        text-align: center;
    }

    .nf-icon-wrap {
        margin: 10px auto 18px;
        width: 88px;
        height: 88px;
        background: linear-gradient(135deg, #e74c3c22, #e74c3c11);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #e74c3c33;
    }

    .nf-icon-wrap i {
        font-size: 44px;
        color: #e74c3c;
    }

    .nf-title {
        font-size: 28px;
        font-weight: 700;
        color: #e74c3c;
        margin: 0 0 10px;
    }

    .nf-subtitle {
        font-size: 16px;
        color: #555;
        font-weight: 400;
        margin: 0 0 24px;
        line-height: 1.5;
    }

    /* ── Causas ── */
    .nf-causas {
        background: linear-gradient(135deg, #c0392b, #e74c3c);
        border-radius: 12px;
        padding: 18px 20px;
        text-align: left;
        margin-bottom: 20px;
    }

    .nf-causas h4 {
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 12px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .nf-causas ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .nf-causas ul li {
        color: #ffe8e8;
        font-size: 14px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        line-height: 1.4;
    }

    .nf-causas ul li::before {
        content: '•';
        color: #ffaaaa;
        font-size: 16px;
        flex-shrink: 0;
        line-height: 1.3;
    }

    /* ── Info box ── */
    .nf-info {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 14px;
        color: #666;
        display: flex;
        align-items: center;
        gap: 10px;
        text-align: left;
        margin-bottom: 0;
    }

    .nf-info i {
        color: #999;
        font-size: 16px;
        flex-shrink: 0;
    }

    /* ── Botón volver ── */
    .nf-btn-wrap {
        margin-top: 24px;
    }

    .nf-btn-home {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #071B7D;
        color: #fff !important;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        transition: background 0.25s, transform 0.2s;
        border: none;
        cursor: pointer;
    }

    .nf-btn-home:hover {
        background: #06176B;
        transform: translateY(-1px);
        color: #fff !important;
        text-decoration: none;
    }

    /* ── Responsive ── */
    @media (max-width: 600px) {
        .nf-page { padding: 20px 12px 40px; }

        .nf-header {
            padding: 14px 20px;
            gap: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .nf-header-logo-main { height: 44px; }
        .nf-header-logo-ancla { height: 40px; }
        .nf-header-divider { height: 36px; }

        .nf-card { border-radius: 16px; }
        .nf-card-band h3 { font-size: 16px; }
        .nf-card-body { padding: 16px 18px 24px; }

        .nf-icon-wrap { width: 72px; height: 72px; }
        .nf-icon-wrap i { font-size: 36px; }

        .nf-title { font-size: 24px; }
        .nf-subtitle { font-size: 15px; }
        .nf-imah-logo { height: 42px; }
    }
</style>

<div class="nf-page">

  <%# ── Header con logos ── %>
  <div class="nf-header">
    <%= image_tag 'logos/Recurso_4logo.png', class: 'nf-header-logo-main', alt: 'Logo' %>
    <div class="nf-header-divider"></div>
    <%= image_tag 'logos/ancla.png', class: 'nf-header-logo-ancla', alt: 'Ancla' %>
  </div>

  <%# ── Card ── %>
  <div class="nf-card">

    <div class="nf-card-band">
      <i class="fa fa-times-circle"></i>
      <h3>Evento No Encontrado</h3>
    </div>

    <%# Logo Imah ── %>
    <div class="nf-imah-wrap">
      <%= image_tag 'Imah-logo.png', class: 'nf-imah-logo', alt: 'Imah Software' %>
    </div>

    <div class="nf-card-body">

      <div class="nf-icon-wrap">
        <i class="fa fa-question-circle"></i>
      </div>

      <h2 class="nf-title">Lo sentimos</h2>
      <p class="nf-subtitle">
        No pudimos encontrar el evento que estás buscando.
      </p>

      <div class="nf-causas">
        <h4>
          <i class="fa fa-exclamation-triangle"></i> Posibles Causas
        </h4>
        <ul>
          <li>El enlace que utilizaste puede estar incorrecto</li>
          <li>El evento puede haber sido eliminado</li>
          <li>La URL puede haber expirado</li>
        </ul>
      </div>

      <div class="nf-info">
        <i class="fa fa-phone"></i>
        <span>Por favor, verifica el enlace o contacta con el organizador del evento.</span>
      </div>

      <% if is_auth_c('eventos') %>
        <div class="nf-btn-wrap">
          <a href="/" class="nf-btn-home">
            <i class="fa fa-home"></i> Volver al Inicio
          </a>
        </div>
      <% end %>

    </div>
  </div>

</div>
