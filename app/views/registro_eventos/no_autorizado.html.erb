<!-- app/views/registro_eventos/no_autorizado.html.erb -->

<div class="container" style="margin-top: 50px;">

  <div class="nf-header">
    <%= image_tag 'logos/Recurso_4logo.png', class: 'nf-header-logo-main', alt: 'Logo' %>
    <div class="nf-header-divider"></div>
    <%= image_tag 'logos/ancla.png', class: 'nf-header-logo-ancla', alt: 'Ancla' %>
  </div>

  <div class="row">
    <div class="col-md-8 col-md-offset-2">
      <div class="panel" style="border-radius:8px; overflow:hidden; box-shadow:0 4px 6px rgba(0,0,0,0.1);">

        <div class="panel-heading" style="background: linear-gradient(135deg,#a93226 0%,#e74c3c 100%); padding:20px; border:none;">
          <h3 class="panel-title">
            <i class="fa fa-times-circle"></i> Participación No Autorizada
          </h3>
        </div>

        <div class="panel-body" style="text-align:center; padding:40px 30px;">

          <div style="margin:0 auto 20px; width:88px; height:88px; border-radius:50%;
            background:linear-gradient(135deg,#e74c3c22,#e74c3c11);
            border:3px solid #e74c3c33;
            display:flex; align-items:center; justify-content:center;">
            <i class="fa fa-times-circle" style="font-size:44px; color:#e74c3c;"></i>
          </div>

          <h2 style="color:#e74c3c; font-weight:700; font-size:26px; margin:0 0 10px;">
            Participación No Autorizada
          </h2>
          <p style="color:#555; font-size:16px; margin:0 0 28px; line-height:1.5;">
            El acudiente ha indicado que <strong>no autoriza</strong> la participación del menor en el evento.
          </p>

          <div style="background:linear-gradient(135deg,#a93226,#e74c3c); border-radius:12px; padding:18px 20px; text-align:left; margin-bottom:20px;">
            <h4 style="color:#fff; font-size:15px; font-weight:700; margin:0 0 12px;">
              <i class="fa fa-calendar"></i> Detalles del Evento
            </h4>
            <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px;">
              <li style="color:#e8faf0; font-size:14px; display:flex; align-items:flex-start; gap:8px;">
                <i class="fa fa-bookmark" style="color:#ffb3b0; margin-top:2px; flex-shrink:0;"></i>
                <span><strong style="color:#fff;">Evento:</strong> <%= @evento.detalle %></span>
              </li>
              <li style="color:#e8faf0; font-size:14px; display:flex; align-items:flex-start; gap:8px;">
                <i class="fa fa-tag" style="color:#ffb3b0; margin-top:2px; flex-shrink:0;"></i>
                <span><strong style="color:#fff;">Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %></span>
              </li>
              <li style="color:#e8faf0; font-size:14px; display:flex; align-items:flex-start; gap:8px;">
                <i class="fa fa-calendar-check-o" style="color:#ffb3b0; margin-top:2px; flex-shrink:0;"></i>
                <span><strong style="color:#fff;">Fecha:</strong> <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %></span>
              </li>
            </ul>
          </div>

          <div style="background:#f8f9fa; border:1px solid #e9ecef; border-left:4px solid #3498db;
            border-radius:10px; padding:14px 18px; font-size:14px; color:#666;
            display:flex; align-items:center; gap:10px; text-align:left;">
            <i class="fa fa-info-circle" style="color:#3498db; font-size:16px; flex-shrink:0;"></i>
            <span>Si esto fue un error, comunícate con el organizador del evento para más información.</span>
          </div>

          <% begin; show_home = is_auth_c('eventos'); rescue; show_home = false; end %>
          <% if show_home %>
            <div style="margin-top:24px;">
              <a href="/" style="display:inline-flex; align-items:center; gap:8px; background:#071B7D;
                color:#fff !important; text-decoration:none; padding:12px 28px;
                border-radius:8px; font-size:15px; font-weight:600;">
                <i class="fa fa-home"></i> Volver al Inicio
              </a>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>
