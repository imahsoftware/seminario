<div class="container" style="margin-top: 50px;">
  <div class="row">
    <div class="col-md-6 col-md-offset-3">
      <div class="panel panel-danger">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="fa fa-users"></i> Evento sin Cupos
          </h3>
        </div>
        <div class="panel-body text-center">
          <i class="fa fa-times-circle" style="font-size: 100px; color: #d9534f; margin: 30px 0;"></i>

          <h2 style="color: #d9534f; font-weight: 600;">
            Ya no hay cupos disponibles
          </h2>

          <p class="lead" style="font-size: 18px; margin: 20px 0;">
            Este evento ha alcanzado el número máximo de participantes permitidos.
          </p>

          <div class="alert alert-info" style="margin-top: 30px; text-align: left;">
            <h4 style="margin-top: 0;">
              <i class="fa fa-info-circle"></i> Información del Evento
            </h4>

            <p style="margin: 10px 0;">
              <strong>Evento:</strong> <%= @evento.detalle %>
            </p>

            <p style="margin: 10px 0;">
              <strong>Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %>
            </p>

            <p style="margin: 10px 0;">
              <strong>Fecha:</strong>
              <%= @evento.fecha_inicio.strftime("%d/%m/%Y") rescue '' %>
            </p>

            <p style="margin: 10px 0;">
              <strong>Cupos disponibles:</strong> 0
            </p>
          </div>

          <div style="background: #f9f9f9; padding: 20px; border-radius: 5px; margin-top: 30px;">
            <p class="text-muted" style="margin: 0;">
              <i class="fa fa-envelope"></i>
              Si deseas más información sobre próximos eventos,
              comunícate con los organizadores.
            </p>
          </div>

          <% if is_auth_c('eventos') %>
          <div style="margin-top: 40px;">
            <a href="/" class="btn btn-default btn-lg">
              <i class="fa fa-home"></i> Volver al Inicio
            </a>
          </div>
            <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
