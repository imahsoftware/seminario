<!-- app/views/registro_eventos/no_iniciado.html.erb -->
<div class="container" style="margin-top: 50px;">
  <div class="row">
    <div class="col-md-6 col-md-offset-3">
      <div class="panel panel-warning">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="fa fa-clock-o"></i> Evento Próximamente
          </h3>
        </div>
        <div class="panel-body text-center">
          <i class="fa fa-hourglass-start" style="font-size: 100px; color: #f0ad4e; margin: 30px 0;"></i>
          <h2 style="color: #f0ad4e; font-weight: 600;">Aún no está disponible</h2>
          <p class="lead" style="font-size: 18px; margin: 20px 0;">
            Este evento aún no ha abierto su periodo de inscripción.
          </p>

          <div class="callout callout-info" style="margin-top: 30px; text-align: left;">
            <h4 style="margin-top: 0;">
              <i class="fa fa-info-circle"></i> Información del Evento
            </h4>
            <p style="margin: 10px 0;">
              <strong>Evento:</strong> <%= @evento.detalle %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Registro disponible desde:</strong> <%= @evento.fecha_inicio.strftime("%d/%m/%Y") rescue '' %>
            </p>
            <p style="margin: 10px 0;">
              <strong>Registro disponible hasta:</strong> <%= @evento.fecha_fin.strftime("%d/%m/%Y") rescue '' %>
            </p>
          </div>

          <div style="background: #f9f9f9; padding: 20px; border-radius: 5px; margin-top: 30px;">
            <p class="text-muted" style="margin: 0;">
              <i class="fa fa-calendar"></i> Por favor, vuelve a intentarlo a partir de la fecha indicada.
            </p>
          </div>
          <% if is_auth_c('eventos') %>
            <div style="margin-top: 40px;">
              <a href="/" class="btn btn-primary btn-lg">
                <i class="fa fa-home"></i> Volver al Inicio
              </a>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
