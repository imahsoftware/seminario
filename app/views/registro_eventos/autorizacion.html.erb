<!-- app/views/registro_eventos/autorizacion.html.erb -->

<div class="container" style="margin-top: 50px;">
  <div class="row">
    <div class="col-md-8 col-md-offset-2">
      <div class="panel panel-primary">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="fa fa-file-text-o"></i> Autorización de Participación - Menor de Edad
          </h3>
        </div>

        <div class="panel-body">

          <!-- DATOS DEL EVENTO -->
          <div class="alert alert-info">
            <h4><i class="fa fa-calendar"></i> Información del Evento</h4>
            <p><strong>Evento:</strong> <%= @evento.detalle %></p>
            <p><strong>Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %></p>
            <p><strong>Fecha:</strong> <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %></p>
          </div>

          <!-- DATOS DEL MENOR -->
          <div class="alert alert-info">
            <h4><i class="fa fa-user"></i> Información del Participante</h4>
            <p><strong>Nombre:</strong> <%= @eventospersona.nombre %></p>
            <p><strong>Apellido:</strong> <%= @eventospersona.apellido %> </p>
            <p><strong>Identificación:</strong> <%= @eventospersona.identificacion %></p>
            <p><strong>Edad:</strong> <%= @eventospersona.calcular_edad %> años</p>
          </div>

          <!-- HABEAS DATA -->
          <div style="background:#f9f9f9; padding:20px; border-radius:5px; margin-top:20px;">
            <h4><i class="fa fa-shield"></i> Autorización de Tratamiento de Datos (Habeas Data)</h4>
            <iframe src="<%= @evento.habeas_data.url %>"
                    width="100%"
                    height="500px"
                    style="border:1px solid #ccc; margin-top:15px;">
            </iframe>
          </div>

          <!-- BOTÓN AUTORIZAR -->
          <div style="margin-top:30px; text-align:center;">

            <%= button_to "Autorizar Participación del Menor",
                          autorizar_participacion_registro_evento_path(@evento.guid, @eventospersona.id),
                          method: :post,
                          class: "btn btn-success btn-lg",
                          data: { confirm: "¿Confirma que autoriza la participación del menor en este evento?" } %>

          </div>

        </div>
      </div>
    </div>
  </div>
</div>
