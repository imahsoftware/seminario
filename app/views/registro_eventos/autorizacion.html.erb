<!-- app/views/registro_eventos/autorizacion.html.erb -->

<%# ── Guardia: si ya fue respondida, mostrar página no disponible ── %>
<% if @eventospersona.acudiente_firma.present? %>
  <div class="container" style="margin-top: 50px;">
    <div class="nf-header">
      <%= image_tag 'logos/Recurso_4logo.png', class: 'nf-header-logo-main', alt: 'Logo' %>
      <div class="nf-header-divider"></div>
      <%= image_tag 'logos/ancla.png', class: 'nf-header-logo-ancla', alt: 'Ancla' %>
    </div>
    <div class="row">
      <div class="col-md-6 col-md-offset-3">
        <div class="panel" style="border-radius:8px; overflow:hidden; box-shadow:0 4px 6px rgba(0,0,0,0.1);">
          <div class="panel-heading" style="background: linear-gradient(135deg,#555 0%,#888 100%); padding:20px; border:none;">
            <h3 class="panel-title"><i class="fa fa-ban"></i> Página no disponible</h3>
          </div>
          <div class="panel-body" style="text-align:center; padding: 40px 30px;">
            <div style="margin: 0 auto 20px; width:80px; height:80px; border-radius:50%;
              background:linear-gradient(135deg,#88888822,#88888811);
              border:3px solid #88888844;
              display:flex; align-items:center; justify-content:center;">
              <i class="fa fa-ban" style="font-size:38px; color:#999;"></i>
            </div>
            <h3 style="color:#888; font-weight:700; margin:0 0 10px;">Esta página ya no está disponible</h3>
            <p style="color:#999; font-size:15px; margin:0;">
              La autorización de participación ya fue respondida anteriormente y no puede modificarse.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

<% else %>

<%# ════════════════════════════════════════════════════
    FORMULARIO DE AUTORIZACIÓN
    ════════════════════════════════════════════════════ %>
  <div class="container" style="margin-top: 50px;">
    <div class="nf-header">
      <%= image_tag 'logos/Recurso_4logo.png', class: 'nf-header-logo-main', alt: 'Logo' %>
      <div class="nf-header-divider"></div>
      <%= image_tag 'logos/ancla.png', class: 'nf-header-logo-ancla', alt: 'Ancla' %>
    </div>

    <div class="row">
      <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-primary">
          <div class="panel-heading">
            <h3 class="panel-title">
              <i class="fa fa-file-text-o"></i> Autorización de Participación — Menor de Edad
            </h3>
          </div>

          <div class="panel-body">

            <%# ── DATOS DEL EVENTO ── %>
            <div class="alert alert-info">
              <h4><i class="fa fa-calendar"></i> Información del Evento</h4>
              <p><strong>Evento:</strong> <%= @evento.detalle %></p>
              <p><strong>Tipo:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %></p>
              <p><strong>Fecha:</strong> <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %></p>
            </div>

            <%# ── DATOS DEL MENOR ── %>
            <div class="alert alert-info">
              <h4><i class="fa fa-user"></i> Información del Participante</h4>
              <p><strong>Nombre:</strong> <%= @eventospersona.nombre %> <%= @eventospersona.apellido %></p>
              <p><strong>Identificación:</strong> <%= @eventospersona.identificacion %></p>
              <p><strong>Edad:</strong> <%= @eventospersona.calcular_edad %> años</p>
            </div>

            <%# ── HABEAS DATA ── %>
            <div style="margin-top: 20px; margin-bottom: 20px;">
              <a href="<%= @evento.habeas_data.url %>" target="_blank" class="btn btn-default">
                <i class="fa fa-file-pdf-o"></i> Ver Tratamiento de Datos
              </a>
            </div>

            <hr>

            <%# ══════════════════════════════════════════════════════════
              DECISIÓN: ¿AUTORIZA O NO AUTORIZA?
              Primero se elige; la sección de documentos solo aparece
              si el acudiente elige "SÍ AUTORIZO".
              ══════════════════════════════════════════════════════════ %>
            <h4 class="text-primary"><i class="fa fa-question-circle"></i> ¿Autoriza la participación del menor?</h4>
            <p class="text-muted"><small>Selecciona una opción para continuar.</small></p>

            <div class="row" style="margin-top:15px; margin-bottom:25px;">
              <div class="col-xs-6">
                <button type="button" id="btn-si-autorizo" class="btn btn-success btn-block btn-lg"
                        onclick="autoriz.seleccionarDecision('SI')">
                  <i class="fa fa-check"></i> Sí, Autorizo
                </button>
              </div>
              <div class="col-xs-6">
                <button type="button" id="btn-no-autorizo" class="btn btn-danger btn-block btn-lg"
                        onclick="autoriz.seleccionarDecision('NO')">
                  <i class="fa fa-times"></i> No Autorizo
                </button>
              </div>
            </div>

            <%# ══════════════════════════════════════════════════════════
              SECCIÓN DOCUMENTOS — solo visible si autoriza
              ══════════════════════════════════════════════════════════ %>
            <div id="seccion-documentos" style="display:none;">
              <h4 class="text-primary" style="margin-top: 10px;">
                <i class="fa fa-id-card"></i> Documento de Identidad del Acudiente
              </h4>
              <p class="text-muted">
                <small><i class="fa fa-info-circle"></i> Fotografía el frente y reverso de tu documento para completar la autorización.</small>
              </p>
              <hr>

              <input type="hidden" id="acu_frente_b64"  value="">
              <input type="hidden" id="acu_reverso_b64" value="">

              <div class="row" style="margin-top: 10px;">
                <div class="col-md-6">
                  <div class="form-group">
                    <label><i class="fa fa-image"></i> Cédula Frente <span class="text-danger">*</span></label>
                    <div>
                      <button type="button" class="btn btn-warning btn-camara-doc"
                              onclick="autoriz.abrirCamara('frente','acu_frente_b64')">
                        <i class="fa fa-camera"></i> Capturar Frente
                      </button>
                    </div>
                    <small class="text-muted">Parte frontal de tu documento</small>
                    <div id="preview-acu-frente" style="display:none; margin-top:10px;">
                      <p class="text-success" style="margin-bottom:5px;"><i class="fa fa-check-circle"></i> <strong>Vista previa:</strong></p>
                      <img id="preview-acu-frente-img" src="#" alt="Frente" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-group">
                    <label><i class="fa fa-image"></i> Cédula Reverso <span class="text-danger">*</span></label>
                    <div>
                      <button type="button" class="btn btn-warning btn-camara-doc"
                              onclick="autoriz.abrirCamara('reverso','acu_reverso_b64')">
                        <i class="fa fa-camera"></i> Capturar Reverso
                      </button>
                    </div>
                    <small class="text-muted">Parte trasera de tu documento</small>
                    <div id="preview-acu-reverso" style="display:none; margin-top:10px;">
                      <p class="text-success" style="margin-bottom:5px;"><i class="fa fa-check-circle"></i> <strong>Vista previa:</strong></p>
                      <img id="preview-acu-reverso-img" src="#" alt="Reverso" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                    </div>
                  </div>
                </div>
              </div>
            </div><%# fin seccion-documentos %>

            <%# ══════════════════════════════════════════════════════════
              FORMULARIOS (uno para SI, uno para NO)
              Se muestran según la decisión
              ══════════════════════════════════════════════════════════ %>

            <%# Form SI AUTORIZO %>
            <%= form_tag autorizar_participacion_registro_evento_path(@evento.guid, @eventospersona.id),
                         method: :post, id: 'form-autorizar-si' do %>
              <input type="hidden" name="decision"                         value="SI">
              <input type="hidden" name="acudiente_cedula_frente_base64"   id="h_frente"  value="">
              <input type="hidden" name="acudiente_cedula_reverso_base64"  id="h_reverso" value="">
              <input type="hidden" name="acudiente_documento_tipo_id"      id="h_tipo"    value="<%= @eventospersona.acudiente_documento_tipo_id %>">

              <div id="btn-confirmar-si-wrap" style="display:none; margin-top:25px; text-align:center;">
                <button type="submit" id="btn-confirmar-si"
                        class="btn btn-success btn-lg"
                        disabled="disabled"
                        style="opacity:0.5; cursor:not-allowed;">
                  <i class="fa fa-check-circle"></i> Confirmar Autorización
                </button>
                <p class="text-muted" style="margin-top:10px;">
                  <small><i class="fa fa-info-circle"></i> Captura las dos fotos para habilitar este botón.</small>
                </p>
              </div>
            <% end %>

            <%# Form NO AUTORIZO %>
            <%= form_tag autorizar_participacion_registro_evento_path(@evento.guid, @eventospersona.id),
                         method: :post, id: 'form-autorizar-no' do %>
              <input type="hidden" name="decision" value="NO">

              <div id="btn-confirmar-no-wrap" style="display:none; margin-top:25px; text-align:center;">
                <div class="alert alert-warning" style="text-align:left;">
                  <i class="fa fa-exclamation-triangle"></i>
                  <strong>Atención:</strong> Al confirmar, el menor quedará <strong>sin autorización</strong> para participar en el evento.
                </div>
                <button type="submit" id="btn-confirmar-no" class="btn btn-danger btn-lg"
                        onclick="return confirm('¿Confirma que NO autoriza la participación del menor en este evento?')">
                  <i class="fa fa-times-circle"></i> Confirmar No Autorización
                </button>
              </div>
            <% end %>

          </div><%# fin panel-body %>
        </div>
      </div>
    </div>
  </div>

<%# ════════════════════════════════════════════════════════════════
    MODAL DE CÁMARA
    ════════════════════════════════════════════════════════════════ %>
  <div class="modal fade" id="modalCamara" tabindex="-1" role="dialog"
       style="padding:0 !important; overflow:hidden !important;">
    <div class="modal-dialog modal-camara-custom" role="document">
      <div class="modal-content modal-camara-content">

        <div class="modal-camara-header">
          <span id="modal-titulo" class="modal-camara-titulo"><i class="fa fa-camera"></i> Capturar Documento</span>
          <button type="button" class="modal-camara-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
        </div>

        <div class="modal-camara-body">
          <div id="camara-flash" class="camara-flash"></div>
          <video id="camara-video" autoplay playsinline class="camara-video" style="display:block;"></video>
          <canvas id="camara-canvas" class="camara-canvas" style="display:none;"></canvas>
          <div id="camara-guia" class="camara-guia">
            <div class="guia-esquina guia-tl"></div>
            <div class="guia-esquina guia-tr"></div>
            <div class="guia-esquina guia-bl"></div>
            <div class="guia-esquina guia-br"></div>
            <span class="guia-texto">Encuadra el documento</span>
          </div>
          <div id="camara-error" class="camara-error-overlay" style="display:none;">
            <i class="fa fa-exclamation-triangle fa-2x"></i>
            <p>No se pudo acceder a la cámara.<br>Verifica los permisos del navegador.</p>
          </div>
          <div id="footer-capturar" class="snap-flotante">
            <button type="button" id="btn-snap" class="btn-camara-snap">
              <span class="btn-snap-circulo"><i class="fa fa-camera"></i></span>
              <span class="btn-snap-label">Tomar Foto</span>
            </button>
          </div>
        </div>

        <div class="modal-camara-footer">
          <div class="footer-cancelar-wrap">
            <button type="button" class="btn-camara-cancelar" data-dismiss="modal" id="btn-cancelar-camara">
              <i class="fa fa-times"></i> Cancelar
            </button>
          </div>
          <div id="footer-confirmar" class="footer-estado" style="display:none;">
            <button type="button" id="btn-usar-foto" class="btn-camara-usar"><i class="fa fa-check"></i> Usar esta foto</button>
            <button type="button" id="btn-repetir"   class="btn-camara-repetir"><i class="fa fa-refresh"></i> Repetir</button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
      var autoriz = (function ($) {

          var streamActual = null, campoObjetivo = null, previewObjetivo = null;
          var decisionActual = null;

          var titulosCamara = { 'frente':'Capturar Documento – Frente', 'reverso':'Capturar Documento – Reverso' };

          // ── Seleccionar decisión ───────────────────────────────────────────
          function seleccionarDecision(decision) {
              decisionActual = decision;

              // Reset estilos de ambos botones
              $('#btn-si-autorizo').removeClass('btn-success btn-default').addClass(decision==='SI' ? 'btn-success' : 'btn-default');
              $('#btn-no-autorizo').removeClass('btn-danger  btn-default').addClass(decision==='NO' ? 'btn-danger'  : 'btn-default');

              if (decision === 'SI') {
                  $('#seccion-documentos').slideDown(300);
                  $('#btn-confirmar-si-wrap').show();
                  $('#btn-confirmar-no-wrap').hide();
              } else {
                  $('#seccion-documentos').slideUp(300);
                  $('#btn-confirmar-si-wrap').hide();
                  $('#btn-confirmar-no-wrap').show();
              }
          }

          // ── Verificar si habilitar el botón Confirmar SI ───────────────────
          function verificarHabilitarBoton() {
              var frente  = document.getElementById('acu_frente_b64').value;
              var reverso = document.getElementById('acu_reverso_b64').value;
              var btn     = document.getElementById('btn-confirmar-si');
              if (frente && reverso) {
                  btn.disabled = false; btn.style.opacity = '1'; btn.style.cursor = 'pointer';
              } else {
                  btn.disabled = true;  btn.style.opacity = '0.5'; btn.style.cursor = 'not-allowed';
              }
          }

          // ── Al enviar el form SI: copiar base64 a campos hidden ────────────
          $('#form-autorizar-si').on('submit', function (e) {
              var frente  = document.getElementById('acu_frente_b64').value;
              var reverso = document.getElementById('acu_reverso_b64').value;
              if (!frente || !reverso) {
                  e.preventDefault();
                  alert('⚠️ Debes capturar el frente y reverso de tu documento para autorizar.');
                  return false;
              }
              document.getElementById('h_frente').value  = frente;
              document.getElementById('h_reverso').value = reverso;
          });

          // ── Abrir cámara ───────────────────────────────────────────────────
          function abrirCamara(prefixPreview, campoId) {
              campoObjetivo = campoId; previewObjetivo = prefixPreview;
              document.getElementById('modal-titulo').innerHTML = '<i class="fa fa-camera"></i> ' + (titulosCamara[prefixPreview] || 'Capturar Documento');
              document.getElementById('camara-canvas').style.display        = 'none';
              document.getElementById('camara-video').style.display         = 'block';
              document.getElementById('footer-capturar').style.display      = 'flex';
              document.getElementById('footer-confirmar').style.display     = 'none';
              document.getElementById('btn-cancelar-camara').style.display  = 'block';
              document.getElementById('camara-guia').style.display          = 'flex';
              document.getElementById('camara-error').style.display         = 'none';
              $('#modalCamara').modal('show');
          }

          $('#modalCamara').on('shown.bs.modal', function () {
              navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 }, height: { ideal: 720 } } })
                  .then(function (stream) { streamActual = stream; var v=document.getElementById('camara-video'); v.srcObject=stream; v.play(); })
                  .catch(function (err)   { console.error('Error cámara:', err); document.getElementById('camara-error').style.display='flex'; });
          });

          $('#modalCamara').on('hidden.bs.modal', function () {
              if (streamActual) { streamActual.getTracks().forEach(function(t){t.stop();}); streamActual=null; }
              document.getElementById('camara-video').srcObject = null;
          });

          document.getElementById('btn-snap').addEventListener('click', function () {
              var video=document.getElementById('camara-video'), canvas=document.getElementById('camara-canvas');
              canvas.width=video.videoWidth||1280; canvas.height=video.videoHeight||720;
              canvas.getContext('2d').drawImage(video,0,0,canvas.width,canvas.height);
              var flash=document.getElementById('camara-flash');
              flash.classList.remove('disparar'); void flash.offsetWidth; flash.classList.add('disparar');
              setTimeout(function(){
                  video.style.display='none'; canvas.style.display='block';
                  document.getElementById('camara-guia').style.display        ='none';
                  document.getElementById('footer-capturar').style.display    ='none';
                  document.getElementById('footer-confirmar').style.display   ='flex';
                  document.getElementById('btn-cancelar-camara').style.display='none';
              }, 150);
          });

          document.getElementById('btn-repetir').addEventListener('click', function () {
              document.getElementById('camara-canvas').style.display        = 'none';
              document.getElementById('camara-video').style.display         = 'block';
              document.getElementById('camara-guia').style.display          = 'flex';
              document.getElementById('footer-capturar').style.display      = 'flex';
              document.getElementById('footer-confirmar').style.display     = 'none';
              document.getElementById('btn-cancelar-camara').style.display  = 'block';
          });

          document.getElementById('btn-usar-foto').addEventListener('click', function () {
              var dataUrl = document.getElementById('camara-canvas').toDataURL('image/jpeg', 0.85);
              document.getElementById(campoObjetivo).value = dataUrl.split(',')[1];
              var div=document.getElementById('preview-acu-'+previewObjetivo);
              var img=document.getElementById('preview-acu-'+previewObjetivo+'-img');
              if(div&&img){ img.src=dataUrl; div.style.display='block'; }
              $('#modalCamara').modal('hide');
              verificarHabilitarBoton();
          });

          // ── Viewport height (Safari/Chrome móvil) ─────────────────────────
          (function(){
              function setVh(){ document.documentElement.style.setProperty('--vh',(window.innerHeight*0.01)+'px'); }
              setVh();
              window.addEventListener('resize', setVh);
              window.addEventListener('orientationchange', function(){ setTimeout(setVh,200); });
              document.getElementById('modalCamara').addEventListener('shown.bs.modal', function(){ setTimeout(setVh,100); });
          })();

          console.log('✅ autoriz inicializado');
          return { abrirCamara: abrirCamara, seleccionarDecision: seleccionarDecision };

      }(jQuery));
  </script>

<% end %><%# fin guardia acudiente_firma %>
