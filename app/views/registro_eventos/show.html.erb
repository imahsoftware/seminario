<!-- app/views/registro_eventos/show.html.erb -->

<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap');
</style>
<div class="container" style="margin-top: 30px;">

  <%# ── Header con logos ── %>
  <div class="nf-header">
    <%= image_tag 'logos/Recurso_4logo.png', class: 'nf-header-logo-main', alt: 'Logo' %>
    <div class="nf-header-divider"></div>
    <%= image_tag 'logos/ancla.png', class: 'nf-header-logo-ancla', alt: 'Ancla' %>
  </div>

  <div class="row">
    <div class="col-md-10 col-md-offset-1">
      <div class="panel panel-primary">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="fa fa-calendar"></i> Registro de Evento
          </h3>
        </div>
        <div class="panel-body">
          <div class="alert alert-info">
            <h4><strong><%= @evento.detalle %></strong></h4>
            <p><strong>Tipo de Evento:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %></p>
            <p><strong>Fecha del Evento:</strong> <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %></p>
            <p><strong>Vigencia de Registro:</strong> Hasta el <%= @evento.fecha_fin_e.strftime("%d/%m/%Y") rescue '' %>
            </p>
          </div>

          <% if @eventospersona.errors.any? %>
            <div class="alert alert-danger">
              <h4><i class="fa fa-exclamation-triangle"></i> Se encontraron <%= @eventospersona.errors.count %> errores:
              </h4>
              <ul style="margin-bottom: 0;">
                <% @eventospersona.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= simple_form_for @eventospersona, url: registro_evento_path(@evento.guid), method: :post,
                              html: { id: 'form-registro-evento', multipart: true } do |f| %>

            <input type="hidden" id="cedula_frente_base64" name="eventospersona[cedula_frente_base64]" value="<%= @frente_b64 %>">
            <input type="hidden" id="cedula_reverso_base64" name="eventospersona[cedula_reverso_base64]" value="<%= @reverso_b64 %>">
            <input type="hidden" id="acudiente_cedula_frente_base64" name="eventospersona[acudiente_cedula_frente_base64]" value="<%= @acu_frente_b64 %>">
            <input type="hidden" id="acudiente_cedula_reverso_base64" name="eventospersona[acudiente_cedula_reverso_base64]" value="<%= @acu_rev_b64 %>">
            <input type="hidden" id="persona_ya_tiene_documentos" name="eventospersona[persona_ya_tiene_documentos]" value="0">
            <input type="hidden" id="area_voluntariado_final" name="eventospersona[area_voluntariado]" value="<%= @eventospersona.area_voluntariado.to_s %>">
            <input type="hidden" id="acudiente_ya_tiene_documentos" name="eventospersona[acudiente_ya_tiene_documentos]" value="0">

            <h4 class="text-primary"><i class="fa fa-user"></i> Información Personal</h4>
            <hr>

            <div class="row">
              <div class="col-md-3">
                <%= f.association :documento_tipo, label: "Tipo de Documento *",
                                  collection: DocumentoTipo.where(estado: 'activo').order(:nombre),
                                  value_method: :id, label_method: :nombre, required: true,
                                  input_html: { class: 'select2' }, include_blank: 'Seleccione...' %>
              </div>
              <div class="col-md-3">
                <%= f.input :identificacion, label: "Identificación", required: true, input_html: { class: 'form-control' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :nombre, label: "Nombre", required: true, input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :apellido, label: "Apellido", required: true, input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
            </div>

            <div class="row">
              <% unless @evento.evento_especial? %>
              <div class="col-md-4">
                <%= f.input :tipo_persona, label: "Tipo",
                            collection: Iparametro.where("campo = 'TIPO_PERSONA'").order(:descripcion).collect { |p| [p.descripcion.to_s, p.valor.to_s] },
                            input_html: { class: 'select2', id: 'tipo_persona', style: "width: 100%" },
                            as: :select, include_blank: true %>
              </div>
              <% else %>
                <%= hidden_field_tag 'eventospersona[tipo_persona]', 'SEMINARISTA' %>
              <% end %>
              <div class="col-md-4">
                <label>Fecha de Nacimiento <span class="text-danger">*</span></label>
                <div class="input-group">
                  <div class="input-group-addon" style="background: #EDEDED;"><i class="fa fa-calendar"></i></div>
                  <%= f.input :fecha_nacimiento, as: :string, label: false, required: true,
                              input_html: { class: 'form-control', autocomplete: 'off',
                                            placeholder: 'dd/mm/yyyy', id: 'fecha_nacimiento', readonly: true } %>
                </div>
                <small class="text-muted" id="edad-info" style="margin-top: 5px; display: none;">
                  <i class="fa fa-info-circle"></i> <span id="edad-texto"></span>
                </small>
              </div>
              <div class="col-md-4">
                <%= f.input :celular, label: "Celular", required: true, input_html: { class: 'form-control', maxlength: 20 } %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-3">
                <%= f.input :sexo, label: "Género",
                            collection: Iparametro.where("campo = 'GENERO'").order(:descripcion).collect { |p| [p.descripcion.to_s, p.valor.to_s] },
                            input_html: { class: 'select2', style: "width: 100%" },
                            as: :select, include_blank: true, required: true %>
              </div>
              <div class="col-md-4">
                <%= f.input :email, label: "Email", required: true, input_html: { class: 'form-control', type: 'email' } %>
              </div>
              <div class="col-md-5">
                <%= f.input :direccion, label: "Dirección", required: true, input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
            </div>

            <% if @evento.evento_especial? %>
            <div class="row">
              <div class="col-md-3">
                <%= f.input :barrio, label: "Barrio", required: true,
                            input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :municipio, label: "Municipio", required: true,
                            input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :lugar_nacimiento, label: "Lugar de Nacimiento", required: true,
                            input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :eps, label: "EPS", required: true,
                            input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
            </div>
            <div class="row">
              <div class="col-md-4">
                <%= f.input :ocupacion, label: "Ocupación", required: true,
                            input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-4">
                <%= f.input :parroquia, label: "Parroquia",
                            input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();',
                                          placeholder: 'Ej: Parroquia San Juan Bosco' } %>
              </div>
              <div class="col-md-4">
                <%= f.input :comunidad, label: "Comunidad",
                            input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();',
                                          placeholder: 'Ej: Comunidad Juvenil SRM' } %>
              </div>
            </div>
            <% end %>

            <h4 class="text-primary" style="margin-top: 30px;">
              <i class="fa fa-id-card"></i> Documento de Identidad
            </h4>
            <p class="text-muted">
              <small><i class="fa fa-info-circle"></i> Usa la cámara para fotografiar el frente y reverso de tu
                documento</small>
            </p>
            <hr>

            <div id="badge-docs-existentes" class="alert alert-info" style="display:none; margin-top:15px;">
              <i class="fa fa-info-circle"></i> <strong>Esta persona ya tiene documentos registrados.</strong>
              Puedes usar los existentes o capturar nuevos con la cámara.
            </div>

            <div class="row" style="margin-top: 10px;">
              <div class="col-md-6">
                <div class="form-group">
                  <label><i class="fa fa-image"></i> Documento Frente <span class="text-danger">*</span></label>
                  <div>
                    <button type="button" class="btn btn-warning btn-camara-doc" onclick="reEvento.abrirCamara('frente', 'cedula_frente_base64')">
                      <i class="fa fa-camera"></i> Capturar Frente
                    </button>
                  </div>
                  <small class="text-muted">Parte frontal de tu documento</small>
                  <div id="preview-frente" style="display:none; margin-top: 10px;">
                    <p class="text-success" style="margin-bottom: 5px;"><i class="fa fa-check-circle"></i>
                      <strong>Vista previa:</strong></p>
                    <img id="preview-frente-img" src="#" alt="Frente" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label><i class="fa fa-image"></i> Documento Reverso <span class="text-danger">*</span></label>
                  <div>
                    <button type="button" class="btn btn-warning btn-camara-doc" onclick="reEvento.abrirCamara('reverso', 'cedula_reverso_base64')">
                      <i class="fa fa-camera"></i> Capturar Reverso
                    </button>
                  </div>
                  <small class="text-muted">Parte trasera de tu documento</small>
                  <div id="preview-reverso" style="display:none; margin-top: 10px;">
                    <p class="text-success" style="margin-bottom: 5px;"><i class="fa fa-check-circle"></i>
                      <strong>Vista previa:</strong></p>
                    <img id="preview-reverso-img" src="#" alt="Reverso" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                  </div>
                </div>
              </div>
            </div>

            <%# ══════════════════════════════════════════
                SECCIÓN ACUDIENTE
                ══════════════════════════════════════════ %>
            <div id="seccion-acudiente" style="display: none;">
              <h4 class="text-primary" style="margin-top: 30px;">
                <i class="fa fa-users"></i> Información del Acudiente
                <span class="label label-danger">OBLIGATORIO - MENOR DE EDAD</span>
              </h4>
              <p class="text-danger">
                <small><i class="fa fa-exclamation-triangle"></i> Debes completar esta sección porque eres menor de 18
                  años</small>
              </p>
              <hr>

              <%# Fila 1: Tipo doc + Nombre + Apellido + Identificación %>
              <div class="row">
                <div class="col-md-3">
                  <%# ── NUEVO: Tipo de documento del acudiente (obligatorio) ── %>
                  <%= f.association :acudiente_documento_tipo,
                                    label: "Tipo Doc. Acudiente *",
                                    collection: DocumentoTipo.where(estado: 'activo').order(:nombre),
                                    value_method: :id, label_method: :nombre,
                                    input_html: { class: 'select2 acudiente-field', style: 'width: 100%', id: 'acudiente_documento_tipo_id_select' },
                                    include_blank: 'Seleccione...' %>
                </div>
                <div class="col-md-3">
                  <%= f.input :acudiente_identificacion, label: "Identificación del Acudiente",
                              input_html: { class: 'form-control acudiente-field', maxlength: 30, id: 'acudiente_identificacion' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :acudiente_nombre, label: "Nombre del Acudiente",
                              input_html: { class: 'form-control acudiente-field', onchange: 'this.value=this.value.toUpperCase();', id: 'acudiente_nombre' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :acudiente_apellido, label: "Apellido del Acudiente",
                              input_html: { class: 'form-control acudiente-field', onchange: 'this.value=this.value.toUpperCase();', id: 'acudiente_apellido' } %>
                </div>

              </div>

              <%# Fila 2: Email + Celular %>
              <div class="row">
                <div class="col-md-6">
                  <%= f.input :acudiente_email, label: "Email del Acudiente",
                              input_html: { class: 'form-control acudiente-field', type: 'email', id: 'acudiente_email' } %>
                </div>
                <div class="col-md-6">
                  <div class="form-group">
                    <%= f.input :acudiente_celular, label: "Celular del Acudiente",
                                input_html: { class: 'form-control acudiente-field', maxlength: 20, id: 'acudiente_celular' } %>
                    <span id="error-celular-acudiente" style="display:none; color:#d9534f; font-size:13px;">
                      <i class="fa fa-exclamation-circle"></i> El celular del acudiente no puede ser igual al del menor.
                    </span>
                  </div>
                </div>
              </div>

              <% if @evento.evento_especial? %>
              <%# ── Datos extendidos del acudiente (evento especial) ── %>
              <div id="seccion-acudiente-especial">
                <h5 class="text-primary" style="margin-top: 15px;"><i class="fa fa-info-circle"></i> Datos adicionales del Acudiente</h5>
                <hr style="margin-top: 5px;">
                <div class="row">
                  <div class="col-md-6">
                    <%= f.input :acudiente_fecha_lugar_nacimiento,
                                label: "Fecha y Lugar de Nacimiento del Acudiente",
                                input_html: { class: 'form-control acudiente-especial-field',
                                              id: 'acudiente_fecha_lugar_nacimiento',
                                              placeholder: 'Ej: 15/03/1985 - Medellín, Antioquia',
                                              onchange: 'this.value=this.value.toUpperCase();' } %>
                  </div>
                  <div class="col-md-6">
                    <%= f.input :acudiente_ocupacion, label: "Ocupación del Acudiente",
                                input_html: { class: 'form-control acudiente-especial-field',
                                              id: 'acudiente_ocupacion',
                                              onchange: 'this.value=this.value.toUpperCase();' } %>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <%= f.input :acudiente_direccion, label: "Dirección del Acudiente",
                                input_html: { class: 'form-control acudiente-especial-field',
                                              id: 'acudiente_direccion',
                                              onchange: 'this.value=this.value.toUpperCase();' } %>
                  </div>
                  <div class="col-md-3">
                    <%= f.input :acudiente_barrio, label: "Barrio",
                                input_html: { class: 'form-control acudiente-especial-field',
                                              id: 'acudiente_barrio',
                                              onchange: 'this.value=this.value.toUpperCase();' } %>
                  </div>
                  <div class="col-md-3">
                    <%= f.input :acudiente_municipio, label: "Municipio",
                                input_html: { class: 'form-control acudiente-especial-field',
                                              id: 'acudiente_municipio',
                                              onchange: 'this.value=this.value.toUpperCase();' } %>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <%= f.input :acudiente_parroquia_comunidad, label: "Parroquia / Comunidad del Acudiente",
                                input_html: { class: 'form-control acudiente-especial-field',
                                              id: 'acudiente_parroquia_comunidad',
                                              onchange: 'this.value=this.value.toUpperCase();' } %>
                  </div>
                </div>

                <%# ── Selector de Área de Voluntariado del menor ── %>
                <div class="form-group" style="margin-top: 10px;">
                  <label>
                    <i class="fa fa-th-large"></i> <strong style="color: #071B7D;">Área de Voluntariado del Menor</strong>
                    <span class="text-danger"> *</span>
                  </label>
                  <%# Sin name= para que no sobreescriba el campo oculto #area_voluntariado_final %>
                  <%= select_tag nil,
                                 options_for_select([
                                   ['Seleccione un área...', ''],
                                   ['RECREACIÓN', 'RECREACIÓN'],
                                   ['FINANZAS (BANCOS Y CAJAS)', 'FINANZAS (BANCOS Y CAJAS)'],
                                   ['LOGISTICA SEGURIDAD Y TRANSPORTE', 'LOGISTICA SEGURIDAD Y TRANSPORTE'],
                                   ['APOYO PARROQUIA (COMIDAS)', 'APOYO PARROQUIA (COMIDAS)'],
                                   ['EVENTOS', 'EVENTOS'],
                                   ['PROMOCIONALES', 'PROMOCIONALES'],
                                   ['ALMACÉN CALZADO', 'ALMACÉN CALZADO'],
                                   ['ALMACÉN ROPA', 'ALMACÉN ROPA'],
                                   ['ALMACÉN VARIADOS', 'ALMACÉN VARIADOS'],
                                   ['SANITARIO', 'SANITARIO'],
                                   ['PRIMEROS AUXILIOS', 'PRIMEROS AUXILIOS'],
                                   ['OTROS', 'OTROS']
                                 ], @eventospersona.area_voluntariado),
                                 class: "form-control select2 acudiente-especial-field area-vol-visible",
                                 id: "area_voluntariado_menor_select",
                                 style: "width: 100%" %>
                </div>

                <%# Texto de autorización con fecha auto ── %>
                <div class="alert alert-info" style="margin-top: 15px; border-left: 5px solid #071B7D;">
                  <p style="margin: 0; font-size: 13px;">
                    <i class="fa fa-calendar-check-o"></i>
                    <strong>Autorización:</strong>
                    Se autoriza a los <%= Date.today.day %> días del mes de
                    <strong><%= I18n.l(Date.today, format: "%B %Y").capitalize %></strong>.
                  </p>
                </div>
              </div><%# fin seccion-acudiente-especial %>
              <% end %>

            </div><%# fin seccion-acudiente %>
            <%# ══════════════════════════════════════════
            SECCIÓN CÓNYUGE
            ══════════════════════════════════════════ %>
            <div id="seccion-conyuge" style="display: none;">
              <h4 class="text-primary" style="margin-top: 30px;">
                <i class="fa fa-heart"></i> Información del Cónyuge
                <span class="label label-danger">OBLIGATORIO - MATRIMONIO</span>
              </h4>
              <p class="text-muted">
                <small><i class="fa fa-info-circle"></i> Ingresa la identificación de tu cónyuge para vincularlo al
                  evento</small>
              </p>
              <hr>

              <%# ── NUEVO: Checkbox "pendiente por registrar" ── %>
              <div class="checkbox" style="margin-bottom: 15px;">
                <label>
                  <input type="checkbox" id="conyuge_pendiente" name="eventospersona[conyuge_pendiente]" value="1">
                  <strong style="color: #071B7D;">
                    <i class="fa fa-clock-o"></i> Mi cónyuge aún no está registrado (pendiente por registrar)
                  </strong>
                </label>
                <small class="text-muted" style="display:block; padding-left: 22px;">
                  Marca esta casilla si tu pareja todavía no se ha inscrito. Podrás vincularla más adelante.
                </small>
              </div>

              <div id="conyuge-campos-wrap">
                <div class="row">
                  <div class="col-md-4">
                    <%= f.input :conyuge_id,
                                label: "Identificación del Cónyuge *",
                                input_html: { class: 'form-control conyuge-field',
                                              id: 'conyuge_identificacion',
                                              maxlength: 30,
                                              autocomplete: 'off' } %>
                    <span id="error-conyuge" style="display:none; color:#d9534f; font-size:13px;">
                      <i class="fa fa-exclamation-circle"></i> <span id="error-conyuge-texto"></span>
                    </span>
                  </div>
                  <div class="col-md-4" id="conyuge-nombre-wrap" style="display:none;">
                    <label class="text-muted"><small>Nombre encontrado</small></label>
                    <p id="conyuge-nombre-display" class="text-success" style="margin-top:6px;">
                      <i class="fa fa-check-circle"></i> <strong></strong>
                    </p>
                  </div>
                </div>
              </div>

              <%# campo oculto para enviar el conyuge_id resuelto %>
              <input type="hidden" id="conyuge_id_hidden" name="eventospersona[conyuge_id]" value="">
            </div>


            <%# ══════════════════════════════════════════
                SECCIÓN VOLUNTARIO (solo eventos especiales)
                ══════════════════════════════════════════ %>
            <% if @evento.evento_especial? %>
              <div style="margin-top: 30px;">
                <div class="panel panel-default" id="panel-voluntario-toggle" style="border: 2px dashed #071B7D; cursor: pointer; transition: all 0.3s;">
                  <div class="panel-body text-center" style="padding: 20px;">
                    <h4 style="color: #071B7D; margin: 0;">
                      <i class="fa fa-hand-paper-o"></i> ¿Quieres ser <strong>Voluntario</strong> en este evento?
                    </h4>
                    <p class="text-muted" style="margin: 8px 0 0;">Haz clic aquí para registrarte como voluntario</p>
                  </div>
                </div>

                <div id="seccion-voluntario" style="display: none;">
                  <div class="alert alert-warning" style="border-left: 5px solid #f0ad4e;">
                    <i class="fa fa-star"></i> <strong>Registro como Voluntario</strong> — Todos los campos de esta sección son obligatorios.
                    <button type="button" id="btn-cancelar-voluntario" class="btn btn-xs btn-default pull-right" style="margin-top:2px;">
                      <i class="fa fa-times"></i> No quiero ser voluntario
                    </button>
                  </div>

                  <input type="hidden" name="eventospersona[es_voluntario]" id="es_voluntario_hidden" value="0">

                  <h5 class="text-primary"><i class="fa fa-check-square-o"></i> Documentos requeridos</h5>
                  <hr>

                  <%# ── Documentos dinámicos de la biblioteca ── %>
                  <% if @evento.evento_check_documentos.any? %>
                    <div style="margin-bottom: 20px;">
                      <p class="text-muted"><small><i class="fa fa-info-circle"></i> Debes abrir y leer cada documento antes de poder marcarlo.</small></p>
                      <% @evento.evento_check_documentos.includes(:check_documento).order(:orden).each do |ecd| %>
                        <% doc = ecd.check_documento %>
                        <div class="panel panel-default" style="margin-bottom: 8px;"
                             id="panel_doc_<%= ecd.id %>"
                             data-aplica-para="<%= ecd.aplica_para %>">
                          <div class="panel-body" style="padding: 10px 15px;">
                            <div class="row">
                              <div class="col-md-7">
                                <div class="checkbox" style="margin: 0;">
                                  <label id="label_check_doc_<%= ecd.id %>" style="opacity: 0.4; cursor: not-allowed;" title="Primero debes abrir el documento">
                                    <input type="checkbox"
                                           name="eventospersona[checks][<%= ecd.id %>]"
                                           id="check_doc_<%= ecd.id %>"
                                           value="1"
                                           class="voluntario-doc-check"
                                           data-ecd-id="<%= ecd.id %>"
                                           disabled>
                                    <strong style="color: #071B7D;">
                                      <i class="fa fa-file-pdf-o"></i> <%= doc.titulo %>
                                    </strong>
                                    <span class="text-danger"> *</span>
                                  </label>
                                </div>
                                <small class="text-muted" style="padding-left: 22px;"><%= doc.descripcion %></small>
                              </div>
                              <div class="col-md-5 text-right">
                                <button type="button"
                                        class="btn btn-info btn-sm btn-abrir-doc"
                                        data-ecd-id="<%= ecd.id %>"
                                        data-url="<%= doc.documento.url %>"
                                        data-titulo="<%= doc.titulo %>">
                                  <i class="fa fa-eye"></i> Leer documento
                                </button>
                                <span id="leido_badge_<%= ecd.id %>" class="label label-success" style="display:none; margin-left: 5px;">
                                  <i class="fa fa-check"></i> Leído
                                </span>
                              </div>
                            </div>

                            <%# ── Selección de fecha (el voluntario elige una) ── %>
                            <% tiene_fechas = (doc.requiere_fecha_1? && doc.fecha_actividad_1.present?) || (doc.requiere_fecha_2? && doc.fecha_actividad_2.present?) %>
                            <% if tiene_fechas %>
                              <div id="fechas_doc_<%= ecd.id %>"
                                   data-ecd-id="<%= ecd.id %>"
                                   data-tiene-fechas="true"
                                   style="display:none; margin-top: 10px; padding: 10px 15px; background: #f0f4ff; border-left: 3px solid #071B7D; border-radius: 3px;">
                                <small style="color: #333; display: block; margin-bottom: 8px; font-size: 13px;">
                                  <i class="fa fa-calendar text-primary"></i>
                                  <strong>¿En qué fecha puedes participar?</strong>
                                  <span class="text-danger"> *</span>
                                </small>
                                <% if doc.requiere_fecha_1? && doc.fecha_actividad_1.present? %>
                                  <div class="radio" style="margin: 4px 0 4px 5px;">
                                    <label style="font-size: 14px; cursor: pointer;">
                                      <input type="radio"
                                             name="eventospersona[checks_fecha][<%= ecd.id %>]"
                                             value="<%= doc.fecha_actividad_1.strftime('%d/%m/%Y') %>"
                                             class="doc-fecha-radio"
                                             data-ecd-id="<%= ecd.id %>">
                                      <i class="fa fa-calendar-o" style="color: #071B7D;"></i>
                                      <strong><%= doc.fecha_actividad_1.strftime("%d/%m/%Y") %></strong>
                                    </label>
                                  </div>
                                <% end %>
                                <% if doc.requiere_fecha_2? && doc.fecha_actividad_2.present? %>
                                  <div class="radio" style="margin: 4px 0 4px 5px;">
                                    <label style="font-size: 14px; cursor: pointer;">
                                      <input type="radio"
                                             name="eventospersona[checks_fecha][<%= ecd.id %>]"
                                             value="<%= doc.fecha_actividad_2.strftime('%d/%m/%Y') %>"
                                             class="doc-fecha-radio"
                                             data-ecd-id="<%= ecd.id %>">
                                      <i class="fa fa-calendar-o" style="color: #071B7D;"></i>
                                      <strong><%= doc.fecha_actividad_2.strftime("%d/%m/%Y") %></strong>
                                    </label>
                                  </div>
                                <% end %>
                              </div>
                            <% end %>

                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                  <%# Select: Área de Voluntariado (adultos voluntarios) %>
                  <div class="form-group" style="margin-top: 15px;">
                    <label>
                      <i class="fa fa-th-large"></i> <strong style="color: #071B7D;">Área de Voluntariado</strong>
                      <span class="text-danger"> *</span>
                    </label>
                    <%# Sin name= para que no sobreescriba el campo oculto #area_voluntariado_final %>
                    <%= select_tag nil,
                                   options_for_select([
                                     ['Seleccione un área...', ''],
                                     ['RECREACIÓN', 'RECREACIÓN'],
                                     ['FINANZAS (BANCOS Y CAJAS)', 'FINANZAS (BANCOS Y CAJAS)'],
                                     ['LOGISTICA SEGURIDAD Y TRANSPORTE', 'LOGISTICA SEGURIDAD Y TRANSPORTE'],
                                     ['APOYO PARROQUIA (COMIDAS)', 'APOYO PARROQUIA (COMIDAS)'],
                                     ['EVENTOS', 'EVENTOS'],
                                     ['PROMOCIONALES', 'PROMOCIONALES'],
                                     ['ALMACÉN CALZADO', 'ALMACÉN CALZADO'],
                                     ['ALMACÉN ROPA', 'ALMACÉN ROPA'],
                                     ['ALMACÉN VARIADOS', 'ALMACÉN VARIADOS'],
                                     ['SANITARIO', 'SANITARIO'],
                                     ['PRIMEROS AUXILIOS', 'PRIMEROS AUXILIOS'],
                                     ['OTROS', 'OTROS']
                                   ], @eventospersona.area_voluntariado),
                                   class: "form-control select2 voluntario-select area-vol-visible",
                                   id: "area_voluntariado_select",
                                   style: "width: 100%" %>
                  </div>

                  <%# Campo: Otro área (visible solo si se selecciona OTROS) %>
                  <div class="form-group" id="area-voluntariado-otro-wrap" style="display:none;">
                    <label>
                      <i class="fa fa-pencil"></i> <strong style="color: #071B7D;">Especifique el área</strong>
                      <span class="text-danger"> *</span>
                    </label>
                    <%= f.input :area_voluntariado_otro, label: false,
                                input_html: { class: 'form-control', id: 'area_voluntariado_otro',
                                              placeholder: 'Describe el área de voluntariado...',
                                              onchange: 'this.value=this.value.toUpperCase();' } %>
                  </div>

                  <%# Select: Apoyo Parroquia — solo para eventos normales %>
                  <% unless @evento.evento_especial? %>
                  <div class="form-group" style="margin-top: 15px;">
                    <label>
                      <i class="fa fa-map-marker"></i> <strong style="color: #071B7D;">Apoyo Parroquia</strong>
                      <span class="text-danger"> *</span>
                    </label>
                    <%= select_tag "eventospersona[iglesiascomunidad_apoyo_id]",
                                   options_from_collection_for_select(
                                     Iglesiascomunidad.joins(:iglesia).order('iglesias.nombre, iglesiascomunidades.nombre'),
                                     :id,
                                     ->(ic) { "#{ic.iglesia.nombre rescue ''} – #{ic.nombre}" }
                                   ),
                                   include_blank: "Seleccione la parroquia...",
                                   class: "form-control select2 voluntario-select",
                                   id: "iglesiascomunidad_apoyo_id",
                                   style: "width: 100%" %>
                    <small class="text-muted">Selecciona la comunidad/parroquia donde prestarás apoyo.</small>
                  </div>
                  <% end %>

                  <%# ── Contacto de emergencia (adultos) ── %>
                  <h5 class="text-primary" style="margin-top: 25px;"><i class="fa fa-phone"></i> Contacto de Emergencia</h5>
                  <hr>
                  <div class="row">
                    <div class="col-md-4">
                      <%= f.input :emergencia_nombre, label: "Nombre",
                                  input_html: { class: 'form-control voluntario-field', id: 'emergencia_nombre',
                                                onchange: 'this.value=this.value.toUpperCase();' } %>
                    </div>
                    <div class="col-md-4">
                      <%= f.input :emergencia_apellido, label: "Apellido",
                                  input_html: { class: 'form-control voluntario-field', id: 'emergencia_apellido',
                                                onchange: 'this.value=this.value.toUpperCase();' } %>
                    </div>
                    <div class="col-md-4">
                      <%= f.input :emergencia_telefono, label: "Teléfono",
                                  input_html: { class: 'form-control voluntario-field', id: 'emergencia_telefono',
                                                maxlength: 20 } %>
                    </div>
                  </div>

                </div><%# fin seccion-voluntario %>
              </div>
            <% end %>

            <h4 class="text-primary" style="margin-top: 30px;"><i class="fa fa-file-text-o"></i> Aceptación de Políticas
            </h4>
            <hr>

            <div class="checkbox-required">
              <div class="checkbox">
                <label>
                  <%= f.check_box :acepta_politica, { required: true }, "SI", "NO" %>
                  <strong style="color: #071B7D;"><i class="fa fa-shield"></i> Acepto las políticas de tratamiento de
                    datos personales <span class="text-danger">*</span></strong>
                </label>
              </div>
              <small class="text-muted" style="display: block; margin-top: 10px; padding-left: 26px;">Al marcar esta
                casilla, acepto que mis datos personales sean utilizados de acuerdo con la política de
                privacidad.</small>
            </div>

            <div class="checkbox-required">
              <div class="checkbox">
                <label>
                  <%= f.check_box :acepta_cultura, { required: true }, "SI", "NO" %>
                  <strong style="color: #071B7D;"><i class="fa fa-heart"></i> Acepto la cultura organizacional
                    <span class="text-danger">*</span></strong>
                </label>
              </div>
              <small class="text-muted" style="display: block; margin-top: 10px; padding-left: 26px;">Me comprometo a
                seguir los valores y principios de la organización.</small>
            </div>

            <div class="form-group" style="margin-top: 30px;">
              <%= f.button :submit, "#{t :inscribir}", class: "btn btn-primary btn-lg btn-block" do %>
                <i class="fa fa-check-circle"></i> Registrarse en el Evento
              <% end %>
            </div>

            <p class="text-muted text-center">
              <small><i class="fa fa-info-circle"></i> Los campos marcados con (<span class="text-danger">*</span>) son
                obligatorios</small>
            </p>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ════════════════════════════════════════════════════════════════
    MODAL VISOR DE DOCUMENTO
    ════════════════════════════════════════════════════════════════ %>
<div class="modal fade" id="modalDocumento" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document" style="width: 90%; max-width: 1000px;">
    <div class="modal-content">
      <div class="modal-header" style="background: #071B7D; color: white; padding: 12px 20px;">
        <button type="button" class="close" data-dismiss="modal" style="color: white; opacity: 1;">
          <span>&times;</span>
        </button>
        <h4 class="modal-title" id="modal-doc-titulo" style="color: white;">
          <i class="fa fa-file-pdf-o"></i> Documento
        </h4>
      </div>
      <div class="modal-body" style="padding: 0; height: 70vh;">
        <iframe id="modal-doc-iframe" src="" width="100%" height="100%"
                style="border: none; display: block;"></iframe>
      </div>
      <div class="modal-footer" style="text-align: center;">
        <p class="text-muted" style="margin-bottom: 10px;">
          <small><i class="fa fa-info-circle"></i> Una vez leído el documento, haz clic en "He leído el documento" para habilitarlo.</small>
        </p>
        <button type="button" class="btn btn-default" data-dismiss="modal">
          <i class="fa fa-times"></i> Cerrar
        </button>
        <button type="button" class="btn btn-success" id="btn-doc-leido">
          <i class="fa fa-check"></i> He leído el documento
        </button>
      </div>
    </div>
  </div>
</div>

<%# ════════════════════════════════════════════════════════════════
    MODAL DE CÁMARA
    ════════════════════════════════════════════════════════════════ %>
<div class="modal fade" id="modalCamara" tabindex="-1" role="dialog" style="padding:0 !important; overflow:hidden !important;">
  <div class="modal-dialog modal-camara-custom" role="document">
    <div class="modal-content modal-camara-content">

      <div class="modal-camara-header">
        <span id="modal-titulo" class="modal-camara-titulo"><i class="fa fa-camera"></i> Capturar Documento</span>
        <button type="button" class="modal-camara-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
      </div>

      <div class="modal-camara-body">
        <div id="camara-flash" class="camara-flash"></div>
        <video id="camara-video" autoplay playsinline class="camara-video" style="display:block;"></video>
        <canvas id="camara-canvas" class="camara-canvas" style="display:none;"></canvas>
        <div id="camara-guia" class="camara-guia">
          <div class="guia-esquina guia-tl"></div>
          <div class="guia-esquina guia-tr"></div>
          <div class="guia-esquina guia-bl"></div>
          <div class="guia-esquina guia-br"></div>
          <span class="guia-texto">Encuadra el documento</span>
        </div>
        <div id="camara-error" class="camara-error-overlay" style="display:none;">
          <i class="fa fa-exclamation-triangle fa-2x"></i>
          <p>No se pudo acceder a la cámara.<br>Verifica los permisos del navegador.</p>
        </div>
        <div id="footer-capturar" class="snap-flotante">
          <button type="button" id="btn-snap" class="btn-camara-snap">
            <span class="btn-snap-circulo"><i class="fa fa-camera"></i></span>
            <span class="btn-snap-label">Tomar Foto</span>
          </button>
        </div>
      </div>

      <div class="modal-camara-footer">
        <div class="footer-cancelar-wrap">
          <button type="button" class="btn-camara-cancelar" data-dismiss="modal" id="btn-cancelar-camara">
            <i class="fa fa-times"></i> Cancelar
          </button>
        </div>
        <div id="footer-confirmar" class="footer-estado" style="display:none;">
          <button type="button" id="btn-usar-foto" class="btn-camara-usar"><i class="fa fa-check"></i> Usar esta foto
          </button>
          <button type="button" id="btn-repetir" class="btn-camara-repetir"><i class="fa fa-refresh"></i> Repetir
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
    var reEvento = (function ($) {

        var streamActual = null, campoObjetivo = null, previewObjetivo = null;

        var titulosCamara = {
            'frente': 'Capturar Documento – Frente',
            'reverso': 'Capturar Documento – Reverso'
        };

        function abrirCamara(prefixPreview, campoId) {
            campoObjetivo = campoId;
            previewObjetivo = prefixPreview;
            document.getElementById('modal-titulo').innerHTML = '<i class="fa fa-camera"></i> ' + (titulosCamara[prefixPreview] || 'Capturar Documento');
            document.getElementById('camara-canvas').style.display = 'none';
            document.getElementById('camara-video').style.display = 'block';
            document.getElementById('footer-capturar').style.display = 'flex';
            document.getElementById('footer-confirmar').style.display = 'none';
            document.getElementById('btn-cancelar-camara').style.display = 'block';
            document.getElementById('camara-guia').style.display = 'flex';
            document.getElementById('camara-error').style.display = 'none';
            $('#modalCamara').modal('show');
        }

        $('#modalCamara').on('shown.bs.modal', function () {
            navigator.mediaDevices.getUserMedia({
                video: {
                    facingMode: {ideal: 'environment'},
                    width: {ideal: 1280},
                    height: {ideal: 720}
                }
            })
                .then(function (stream) {
                    streamActual = stream;
                    var v = document.getElementById('camara-video');
                    v.srcObject = stream;
                    v.play();
                })
                .catch(function (err) {
                    console.error('Error cámara:', err);
                    document.getElementById('camara-error').style.display = 'flex';
                });
        });

        $('#modalCamara').on('hidden.bs.modal', function () {
            if (streamActual) {
                streamActual.getTracks().forEach(function (t) {
                    t.stop();
                });
                streamActual = null;
            }
            document.getElementById('camara-video').srcObject = null;
        });

        document.getElementById('btn-snap').addEventListener('click', function () {
            var video = document.getElementById('camara-video'), canvas = document.getElementById('camara-canvas');
            canvas.width = video.videoWidth || 1280;
            canvas.height = video.videoHeight || 720;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
            var flash = document.getElementById('camara-flash');
            flash.classList.remove('disparar');
            void flash.offsetWidth;
            flash.classList.add('disparar');
            setTimeout(function () {
                video.style.display = 'none';
                canvas.style.display = 'block';
                document.getElementById('camara-guia').style.display = 'none';
                document.getElementById('footer-capturar').style.display = 'none';
                document.getElementById('footer-confirmar').style.display = 'flex';
                document.getElementById('btn-cancelar-camara').style.display = 'none';
            }, 150);
        });

        document.getElementById('btn-repetir').addEventListener('click', function () {
            document.getElementById('camara-canvas').style.display = 'none';
            document.getElementById('camara-video').style.display = 'block';
            document.getElementById('camara-guia').style.display = 'flex';
            document.getElementById('footer-capturar').style.display = 'flex';
            document.getElementById('footer-confirmar').style.display = 'none';
            document.getElementById('btn-cancelar-camara').style.display = 'block';
        });

        document.getElementById('btn-usar-foto').addEventListener('click', function () {
            var dataUrl = document.getElementById('camara-canvas').toDataURL('image/jpeg', 0.85);
            document.getElementById(campoObjetivo).value = dataUrl.split(',')[1];
            var div = document.getElementById('preview-' + previewObjetivo);
            var img = document.getElementById('preview-' + previewObjetivo + '-img');
            if (div && img) {
                img.src = dataUrl;
                div.style.display = 'block';
            }
            $('#modalCamara').modal('hide');
        });

        // ── Datepicker ─────────────────────────────────────────────────────
        $('#fecha_nacimiento').datepicker({
            changeMonth: true, changeYear: true, dateFormat: 'dd/mm/yy',
            maxDate: new Date(), minDate: '-100y', yearRange: '-100:+0',
            dayNamesMin: ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'],
            monthNames: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
            monthNamesShort: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
            firstDay: 1, showOtherMonths: true, selectOtherMonths: true,
            onSelect: function (dt) {
                $(this).val(dt).trigger('change');
                setTimeout(validarEdad, 100);
            }
        });

        function convertirFecha(s) {
            try {
                var p = (s || '').split('/');
                if (p.length !== 3) return null;
                var d = parseInt(p[0], 10), m = parseInt(p[1], 10) - 1, y = parseInt(p[2], 10);
                if (y < 100) y += y < 30 ? 2000 : 1900;
                return (isNaN(d) || isNaN(m) || isNaN(y)) ? null : new Date(y, m, d);
            } catch (e) {
                return null;
            }
        }

        function calcularEdad(fn) {
            var hoy = new Date(), e = hoy.getFullYear() - fn.getFullYear(), m = hoy.getMonth() - fn.getMonth();
            if (m < 0 || (m === 0 && hoy.getDate() < fn.getDate())) e--;
            return e;
        }

        var $fn = $('#fecha_nacimiento');

        // ── Filtrar documentos según edad ────────────────────────────────────
        function filtrarDocumentosPorEdad(esMenor) {
            $('[data-aplica-para]').each(function () {
                var aplica = $(this).data('aplica-para');
                if (aplica === 'AMBOS') {
                    $(this).show();
                } else if (aplica === 'MENOR') {
                    esMenor ? $(this).show() : $(this).hide();
                } else if (aplica === 'ADULTO') {
                    esMenor ? $(this).hide() : $(this).show();
                }
            });
        }

        function validarEdad() {
            try {
                var f = convertirFecha($fn.val());
                if (!f || isNaN(f.getTime())) {
                    $('#seccion-acudiente').hide();
                    $('#edad-info').hide();
                    return;
                }
                var edad = calcularEdad(f);
                if (edad < 18) {
                    $('#edad-texto').text('Edad: ' + edad + ' años - Debes completar la información del acudiente');
                    $('#edad-info').show().css('color', '#d9534f');
                    $('#seccion-acudiente').slideDown(400);
                    $('.acudiente-field').prop('required', true);
                    // ── Menores NO pueden ser voluntarios ─────────────────
                    $('#panel-voluntario-toggle').hide();
                    $('#seccion-voluntario').slideUp(300);
                    $('#es_voluntario_hidden').val('0');
                    $('.voluntario-check').prop('checked', false);
                    $('.voluntario-select').val('').trigger('change');
                    // ── Mostrar documentos de menores ─────────────────────
                    filtrarDocumentosPorEdad(true);
                } else {
                    $('#edad-texto').text('Edad: ' + edad + ' años');
                    $('#edad-info').show().css('color', '#5cb85c');
                    $('#seccion-acudiente').slideUp(400);
                    $('.acudiente-field').prop('required', false).val('');
                    // ── Mayores sí pueden ver la opción de voluntario ─────
                    $('#panel-voluntario-toggle').show();
                    // ── Mostrar documentos de adultos ─────────────────────
                    filtrarDocumentosPorEdad(false);
                }
            } catch (e) {
                console.error('validarEdad:', e);
            }
        }

        $fn.on('changeDate change blur', function () {
            setTimeout(validarEdad, 100);
        });
        setTimeout(function () {
            if ($fn.val()) validarEdad();
        }, 500);

        // ── Validación celular acudiente ≠ menor ───────────────────────────
        $('#acudiente_celular').on('blur change', function () {
            var cm = $('[name="eventospersona[celular]"]').val().trim(), ca = $(this).val().trim();
            if (cm && ca && cm === ca) {
                $(this).addClass('celular-error');
                $('#error-celular-acudiente').show();
            } else {
                $(this).removeClass('celular-error');
                $('#error-celular-acudiente').hide();
            }
        });

        // ── Restaurar previews si el form volvió con errores ──────────────
        (function () {
            [{i: 'cedula_frente_base64', d: 'preview-frente', m: 'preview-frente-img'},
                {i: 'cedula_reverso_base64', d: 'preview-reverso', m: 'preview-reverso-img'}].forEach(function (f) {
                var inp = document.getElementById(f.i);
                if (inp && inp.value) {
                    var div = document.getElementById(f.d), img = document.getElementById(f.m);
                    if (div && img) {
                        img.src = 'data:image/jpeg;base64,' + inp.value;
                        div.style.display = 'block';
                    }
                }
            });
        })();

        // ── Validación al enviar ───────────────────────────────────────────
        $('#form-registro-evento').on('submit', function (e) {
            try {
                if (!$('input[name="eventospersona[acepta_politica]"]').is(':checked')) {
                    e.preventDefault();
                    alert('⚠️ Debe aceptar las políticas de tratamiento de datos personales.');
                    return false;
                }
                if (!$('input[name="eventospersona[acepta_cultura]"]').is(':checked')) {
                    e.preventDefault();
                    alert('⚠️ Debe aceptar la cultura organizacional.');
                    return false;
                }
                if ($('#persona_ya_tiene_documentos').val() !== '1') {
                    if (!$('#cedula_frente_base64').val()) {
                        e.preventDefault();
                        alert('⚠️ Debes capturar la foto del Documento Frente.');
                        return false;
                    }
                    if (!$('#cedula_reverso_base64').val()) {
                        e.preventDefault();
                        alert('⚠️ Debes capturar la foto del Documento Reverso.');
                        return false;
                    }
                }
                // ── Validación cónyuge ──────────────────────────────────────
                if ($('#tipo_persona').val() === 'MATRIMONIO' && !$('#conyuge_pendiente').is(':checked')) {
                    var idConyuge = $('#conyuge_identificacion').val().trim();
                    var conyugeId = $('#conyuge_id_hidden').val();

                    if (!idConyuge) {
                        e.preventDefault();
                        alert('⚠️ Debes ingresar la identificación del cónyuge.');
                        $('#conyuge_identificacion').focus();
                        return false;
                    }

                    if (!conyugeId) {
                        e.preventDefault();
                        alert('⚠️ Debes seleccionar un cónyuge válido.');
                        $('#conyuge_identificacion').focus();
                        return false;
                    }
                }
                // ── Validación documentos dinámicos ───────────────────────
                if ($('#es_voluntario_hidden').val() === '1') {
                    var docsNoLeidos = [];
                    $('.voluntario-doc-check').each(function () {
                        if (!$(this).is(':checked')) {
                            docsNoLeidos.push($(this).closest('.panel').find('strong').first().text().trim());
                        }
                    });
                    if (docsNoLeidos.length > 0) {
                        e.preventDefault();
                        alert('⚠️ Debes leer y aceptar los siguientes documentos:\n\n• ' + docsNoLeidos.join('\n• '));
                        return false;
                    }
                    // ── Validación fechas de documentos ──────────────────────
                    var docsSinFecha = [];
                    $('[data-tiene-fechas="true"]').each(function () {
                        var ecdId = $(this).data('ecd-id');
                        // Solo validar si el documento fue marcado como leído
                        if ($('#check_doc_' + ecdId).is(':checked')) {
                            var radioSeleccionado = $('input[name="eventospersona[checks_fecha][' + ecdId + ']"]:checked').val();
                            if (!radioSeleccionado) {
                                var titulo = $('#label_check_doc_' + ecdId + ' strong').text().trim();
                                docsSinFecha.push(titulo);
                            }
                        }
                    });
                    if (docsSinFecha.length > 0) {
                        e.preventDefault();
                        alert('⚠️ Debes seleccionar una fecha para:\n\n• ' + docsSinFecha.join('\n• '));
                        return false;
                    }
                }
                // ── Validación voluntario ──────────────────────────────────
                if ($('#es_voluntario_hidden').val() === '1') {
                    var vaciosVol = [];
                    // Parroquia de Apoyo solo requerida en eventos normales (no especiales)
                    if ($('#iglesiascomunidad_apoyo_id').length && !$('#iglesiascomunidad_apoyo_id').val()) vaciosVol.push('Parroquia de Apoyo');
                    // Evento especial: campos adicionales del voluntario adulto
                    var areaVol = $('#area_voluntariado_final').val();
                    if ($('#area_voluntariado_select').length && !areaVol) vaciosVol.push('Área de Voluntariado');
                    if (areaVol === 'OTROS' && !$('#area_voluntariado_otro').val().trim()) vaciosVol.push('Especificación del área (OTROS)');
                    if ($('#emergencia_nombre').length && !$('#emergencia_nombre').val().trim()) vaciosVol.push('Nombre del Contacto de Emergencia');
                    if ($('#emergencia_apellido').length && !$('#emergencia_apellido').val().trim()) vaciosVol.push('Apellido del Contacto de Emergencia');
                    if ($('#emergencia_telefono').length && !$('#emergencia_telefono').val().trim()) vaciosVol.push('Teléfono del Contacto de Emergencia');
                    if (vaciosVol.length > 0) {
                        e.preventDefault();
                        alert('⚠️ Como voluntario debes completar:\n\n• ' + vaciosVol.join('\n• '));
                        document.getElementById('seccion-voluntario').scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return false;
                    }
                }

                // ── Validación menores en evento especial ──────────────────
                if ($('#seccion-acudiente-especial').length && $('#seccion-acudiente-especial').is(':visible')) {
                    var f2 = convertirFecha($fn.val());
                    if (f2 && calcularEdad(f2) < 18) {
                        var vaciosAcu = [];
                        if (!$('#acudiente_fecha_lugar_nacimiento').val().trim()) vaciosAcu.push('Fecha y Lugar de Nacimiento del Acudiente');
                        if (!$('#acudiente_ocupacion').val().trim()) vaciosAcu.push('Ocupación del Acudiente');
                        if (!$('#acudiente_direccion').val().trim()) vaciosAcu.push('Dirección del Acudiente');
                        if (!$('#acudiente_barrio').val().trim()) vaciosAcu.push('Barrio del Acudiente');
                        if (!$('#acudiente_municipio').val().trim()) vaciosAcu.push('Municipio del Acudiente');
                        if (!$('#acudiente_parroquia_comunidad').val().trim()) vaciosAcu.push('Parroquia/Comunidad del Acudiente');
                        if (!$('#area_voluntariado_final').val()) vaciosAcu.push('Área de Voluntariado del Menor');
                        if (vaciosAcu.length > 0) {
                            e.preventDefault();
                            alert('⚠️ Para menores en evento especial debes completar:\n\n• ' + vaciosAcu.join('\n• '));
                            document.getElementById('seccion-acudiente').scrollIntoView({ behavior: 'smooth', block: 'center' });
                            return false;
                        }
                    }
                }
                var f = convertirFecha($fn.val());
                if (f && calcularEdad(f) < 18) {
                    var cm = $('[name="eventospersona[celular]"]').val().trim(),
                        ca = $('#acudiente_celular').val().trim();
                    if (cm && ca && cm === ca) {
                        e.preventDefault();
                        alert('⚠️ El celular del Acudiente no puede ser igual al del menor.');
                        $('#acudiente_celular').addClass('celular-error').focus();
                        $('#error-celular-acudiente').show();
                        document.getElementById('seccion-acudiente').scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });
                        return false;
                    }
                    var vacios = [];
                    if (!$('#acudiente_documento_tipo_id_select').val()) vacios.push('Tipo de Documento del Acudiente');
                    if (!$('#acudiente_nombre').val().trim()) vacios.push('Nombre del Acudiente');
                    if (!$('#acudiente_apellido').val().trim()) vacios.push('Apellido del Acudiente');
                    if (!$('#acudiente_identificacion').val().trim()) vacios.push('Identificación del Acudiente');
                    if (!$('#acudiente_email').val().trim()) vacios.push('Email del Acudiente');
                    if (!$('#acudiente_celular').val().trim()) vacios.push('Celular del Acudiente');
                    if (vacios.length > 0) {
                        e.preventDefault();
                        alert('⚠️ Debes completar:\n\n• ' + vacios.join('\n• '));
                        document.getElementById('seccion-acudiente').scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });
                        return false;
                    }
                }
            } catch (err) {
                console.error('submit error:', err);
            }
        });

        // ── CONTROL CÓNYUGE (edad + tipo_persona) ─────────────────────────
        function actualizarSeccionConyuge() {
            try {
                var tipo = $('#tipo_persona').val();
                var f = convertirFecha($('#fecha_nacimiento').val());

                var esMayor = false;
                if (f && !isNaN(f.getTime())) {
                    esMayor = calcularEdad(f) >= 18;
                }

                if (tipo === 'MATRIMONIO' && esMayor) {
                    $('#seccion-conyuge').slideDown(400);
                    $('.conyuge-field').prop('required', true);
                } else {
                    $('#seccion-conyuge').slideUp(400);
                    $('.conyuge-field').prop('required', false).val('');
                    $('#conyuge_id_hidden').val('');
                    $('#conyuge-nombre-wrap').hide();
                    $('#error-conyuge').hide();
                }

            } catch (e) {
                console.error('actualizarSeccionConyuge:', e);
            }
        }

        // ── Toggle "pendiente por registrar cónyuge" ──────────────────────
        $('#conyuge_pendiente').on('change', function () {
            if ($(this).is(':checked')) {
                $('#conyuge-campos-wrap').slideUp(200);
                $('.conyuge-field').prop('required', false).val('');
                $('#conyuge_id_hidden').val('');
                $('#conyuge-nombre-wrap').hide();
                $('#error-conyuge').hide();
            } else {
                $('#conyuge-campos-wrap').slideDown(200);
                if ($('#tipo_persona').val() === 'MATRIMONIO') {
                    $('.conyuge-field').prop('required', true);
                }
            }
        });

        $('#tipo_persona').on('change', actualizarSeccionConyuge);
        $('#fecha_nacimiento').on('change blur', function () {
            setTimeout(actualizarSeccionConyuge, 100);
        });

// ── Buscar cónyuge ────────────────────────────────────────────────
        var buscarConyugeTimer = null;

        $('#conyuge_identificacion').on('blur', function () {
            var id = $(this).val().trim();

            $('#error-conyuge').hide();
            $('#conyuge-nombre-wrap').hide();
            $('#conyuge_id_hidden').val('');

            if (id.length < 5) return;

            clearTimeout(buscarConyugeTimer);

            buscarConyugeTimer = setTimeout(function () {
                $.ajax({
                    url: '<%= buscar_conyuge_registro_evento_path(guid: @evento.guid) %>',
                    method: 'GET',
                    data: {identificacion: id},
                    success: function (data) {
                        if (data.encontrado) {
                            $('#conyuge_id_hidden').val(data.id);
                            $('#conyuge-nombre-wrap').show();
                            $('#conyuge-nombre-display strong').text(data.nombre_completo);
                            $('#error-conyuge').hide();
                        } else {
                            $('#conyuge_id_hidden').val('');
                            $('#conyuge-nombre-wrap').hide();
                            $('#error-conyuge-texto').text(
                                data.mensaje || 'No se encontró ningún cónyuge con esa identificación.'
                            );
                            $('#error-conyuge').show();
                        }
                    },
                    error: function (xhr) {
                        console.error('ERROR AJAX:', xhr.responseText);
                        console.error('STATUS:', xhr.status);

                        $('#error-conyuge-texto').text('Error al buscar el cónyuge.');
                        $('#error-conyuge').show();
                    }
                });
            }, 300);
        });

        $('#tipo_persona').on('change', actualizarSeccionConyuge);
        $('#fecha_nacimiento').on('change blur', function () {
            setTimeout(actualizarSeccionConyuge, 100);
        });

        // Ejecutar al cargar (IMPORTANTE)
        setTimeout(function () {
            actualizarSeccionConyuge();
        }, 300);


        // ── Limpiar formulario al cambiar cédula ──────────────────────────
        var ultimaCedula = $('#eventospersona_identificacion').val();

        function limpiarFormulario() {
            ['nombre', 'apellido', 'celular', 'email', 'direccion'].forEach(function (f) {
                $('#eventospersona_' + f).val('').trigger('change');
            });
            $fn.val('');
            $('#eventospersona_sexo').val('').trigger('change');
            $('#cedula_frente_base64,#cedula_reverso_base64').val('');
            $('#preview-frente,#preview-reverso').hide();
            $('#persona_ya_tiene_documentos').val('0');
            $('#badge-docs-existentes').hide();
            $('#seccion-acudiente,#edad-info').hide();
            $('#acudiente_celular').removeClass('celular-error');
            $('#error-celular-acudiente').hide();
        }

        var buscarTimer = null;
        $('#eventospersona_identificacion').on('blur', function () {
            var id = $(this).val().trim();
            var documento_tipo_id = $('#eventospersona_documento_tipo_id').val();
            if (id !== ultimaCedula) {
                ultimaCedula = id;
                limpiarFormulario();
            }
            if (id.length < 5) return;
            clearTimeout(buscarTimer);
            buscarTimer = setTimeout(function () {
                $.ajax({
                    url: '<%= buscar_persona_registro_evento_path(@evento.guid) %>',
                    method: 'GET',
                    data: {identificacion: id, documento_tipo_id: documento_tipo_id},
                    success: function (data) {
                        console.log('✅ data recibida:', data);
                        if (!data.encontrada) return;

                        $('#eventospersona_nombre').val(data.nombre).trigger('change');
                        $('#eventospersona_apellido').val(data.apellido).trigger('change');
                        $('#eventospersona_celular').val(data.celular).trigger('change');
                        $('#eventospersona_email').val(data.email).trigger('change');
                        $('#eventospersona_direccion').val(data.direccion).trigger('change');
                        if (data.sexo) $('#eventospersona_sexo').val(data.sexo).trigger('change');
                        if (data.documento_tipo_id) $('#eventospersona_documento_tipo_id').val(data.documento_tipo_id).trigger('change');

                        // 1) Cargar fecha primero para que validarEdad y actualizarSeccionConyuge
                        //    conozcan la edad antes de decidir qué secciones mostrar
                        if (data.fecha_nacimiento) {
                            $fn.val(data.fecha_nacimiento);
                            setTimeout(validarEdad, 100);
                        }

                        // 2) Cargar tipo_persona DESPUÉS de la fecha (con delay)
                        //    para que actualizarSeccionConyuge ya tenga la edad calculada
                        setTimeout(function () {
                            if (data.tipo_persona) {
                                $('#tipo_persona').val(data.tipo_persona).trigger('change');
                            } else {
                                $('#tipo_persona').val('').trigger('change');
                            }
                        }, 250);

                        // 3) Sección voluntario: abrir si ya era voluntario
                        setTimeout(function () {
                            if (data.es_voluntario) {
                                $('#es_voluntario_hidden').val('1');
                                $('#panel-voluntario-toggle').hide();
                                $('#seccion-voluntario').show();
                                if (data.area_voluntariado) {
                                    $('#area_voluntariado_final').val(data.area_voluntariado);
                                    if ($.fn.select2) {
                                        $('#area_voluntariado_select').val(data.area_voluntariado).trigger('change.select2');
                                        $('#area_voluntariado_menor_select').val(data.area_voluntariado).trigger('change.select2');
                                    }
                                    if (data.area_voluntariado === 'OTROS') {
                                        $('#area-voluntariado-otro-wrap').show();
                                    }
                                }
                            }
                        }, 300);

                        if (data.tiene_documentos && data.cedula_frente_url && data.cedula_reverso_url) {
                            document.getElementById('preview-frente-img').src = data.cedula_frente_url;
                            document.getElementById('preview-reverso-img').src = data.cedula_reverso_url;
                            $('#preview-frente,#preview-reverso').show();
                            $('#persona_ya_tiene_documentos').val('1');
                            $('#badge-docs-existentes').show();
                        } else {
                            $('#persona_ya_tiene_documentos').val('0');
                            $('#badge-docs-existentes,#preview-frente,#preview-reverso').hide();
                            $('#cedula_frente_base64,#cedula_reverso_base64').val('');
                        }
                    },
                    error: function () {
                        console.warn('Error al buscar persona');
                    }
                });
            }, 300);
        });

        // ── Autocompletar acudiente ────────────────────────────────────────
        $('#acudiente_identificacion').on('blur', function () {
            var id = $(this).val().trim();
            if (id.length < 5) return;
            $.ajax({
                url: '<%= buscar_persona_registro_evento_path(@evento.guid) %>',
                method: 'GET',
                data: {identificacion: id, documento_tipo_id: documento_tipo_id},
                success: function (data) {
                    if (!data.encontrada) return;
                    if (data.nombre) $('#acudiente_nombre').val(data.nombre).trigger('change');
                    if (data.apellido) $('#acudiente_apellido').val(data.apellido).trigger('change');
                    if (data.celular) $('#acudiente_celular').val(data.celular).trigger('change');
                    if (data.email) $('#acudiente_email').val(data.email).trigger('change');
                    if (data.documento_tipo_id) $('#acudiente_documento_tipo_id_select').val(data.documento_tipo_id).trigger('change');
                    setTimeout(function () {
                        $('#acudiente_celular').trigger('change');
                    }, 100);
                },
                error: function () {
                    console.warn('Error al buscar acudiente');
                }
            });


        });

        // ── MODAL DOCUMENTOS ──────────────────────────────────────────────────
        $('.btn-abrir-doc').on('click', function () {
            var ecdId  = $(this).data('ecd-id');
            var url    = $(this).data('url');
            var titulo = $(this).data('titulo');

            $('#modal-doc-titulo').text(titulo);
            $('#modal-doc-iframe').attr('src', url);
            $('#modalDocumento').modal('show');
            $('#modalDocumento').data('ecd-id', ecdId);
        });

        $('#btn-doc-leido').on('click', function () {
            var ecdId = $('#modalDocumento').data('ecd-id');
            // Habilitar el checkbox
            var $check = $('#check_doc_' + ecdId);
            var $label = $('#label_check_doc_' + ecdId);
            $check.prop('disabled', false).prop('checked', true);
            $label.css({ opacity: 1, cursor: 'pointer' }).attr('title', '');
            $('#leido_badge_' + ecdId).show();
            // Mostrar fechas informativas del documento si las tiene
            var $fechasDiv = $('#fechas_doc_' + ecdId);
            if ($fechasDiv.length) {
                $fechasDiv.slideDown(200);
            }
            // Marcar el panel en verde
            $('#panel_doc_' + ecdId).addClass('panel-success').removeClass('panel-default');
            $('#modalDocumento').modal('hide');
            $('#modal-doc-iframe').attr('src', '');
        });

        // Limpiar iframe al cerrar
        $('#modalDocumento').on('hidden.bs.modal', function () {
            $('#modal-doc-iframe').attr('src', '');
        });

        // ── Sincronizar selectores de área con el campo oculto ───────────
        // (#area_voluntariado_select para adultos y #area_voluntariado_menor_select
        //  para menores no tienen name= para evitar duplicados; actualizan el hidden)
        $(document).on('change', '.area-vol-visible', function () {
            var val = $(this).val();
            $('#area_voluntariado_final').val(val);
            // Sync el otro selector visible para que no queden desincronizados
            $('.area-vol-visible').not(this).val(val).trigger('change.select2');
            if (val === 'OTROS') {
                $('#area-voluntariado-otro-wrap').slideDown(200);
            } else {
                $('#area-voluntariado-otro-wrap').slideUp(200);
                $('#area_voluntariado_otro').val('');
            }
        });

        // Toggle apertura sección voluntario
        $('#panel-voluntario-toggle').on('click', function () {
            $('#seccion-voluntario').slideDown(400);
            $(this).hide();
            $('#es_voluntario_hidden').val('1');
            // Inicializar select2 dentro de la sección
            if ($.fn.select2) {
                $('#iglesiascomunidad_apoyo_id').select2({ placeholder: 'Seleccione la parroquia...' });
                $('#area_voluntariado_select').select2({ placeholder: 'Seleccione un área...' });
                // Restaurar valor guardado en el campo oculto
                var valorActual = $('#area_voluntariado_final').val();
                if (valorActual) $('#area_voluntariado_select').val(valorActual).trigger('change.select2');
            }
        });

        // Botón cancelar voluntario
        $('#btn-cancelar-voluntario').on('click', function (e) {
            e.stopPropagation();
            $('#seccion-voluntario').slideUp(400);
            $('#panel-voluntario-toggle').show();
            $('#es_voluntario_hidden').val('0');
            // Limpiar campos
            $('.voluntario-check').prop('checked', false);
            $('.voluntario-select').val('').trigger('change');
            $('.voluntario-date').val('');
        });

        console.log('✅ reEvento inicializado');
        return {abrirCamara: abrirCamara};

    }(jQuery));

    (function () {
        function setVh() {
            document.documentElement.style.setProperty('--vh', (window.innerHeight * 0.01) + 'px');
        }

        setVh();
        window.addEventListener('resize', setVh);
        window.addEventListener('orientationchange', function () {
            setTimeout(setVh, 200);
        });
        document.getElementById('modalCamara').addEventListener('shown.bs.modal', function () {
            setTimeout(setVh, 100);
        });
    })();
</script>
