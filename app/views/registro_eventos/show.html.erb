<!-- app/views/registro_eventos/show.html.erb -->
<div class="container" style="margin-top: 30px;">
  <div class="row">
    <div class="col-md-10 col-md-offset-1">
      <div class="panel panel-primary">
        <div class="panel-heading">
          <h3 class="panel-title">
            <i class="fa fa-calendar"></i> Registro de Evento
          </h3>
        </div>
        <div class="panel-body">
          <div class="alert alert-info">
            <h4><strong><%= @evento.detalle %></strong></h4>
            <p><strong>Tipo de Evento:</strong> <%= @evento.tiposevento.descripcion rescue 'N/A' %></p>
            <p><strong>Fecha del Evento:</strong> <%= @evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '' %></p>
            <p><strong>Vigencia de Registro:</strong> Hasta el <%= @evento.fecha_fin_e.strftime("%d/%m/%Y") rescue '' %></p>
          </div>

          <% if @eventospersona.errors.any? %>
            <div class="alert alert-danger">
              <h4><i class="fa fa-exclamation-triangle"></i> Se encontraron <%= @eventospersona.errors.count %> errores:</h4>
              <ul style="margin-bottom: 0;">
                <% @eventospersona.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= simple_form_for @eventospersona, url: registro_evento_path(@evento.guid), method: :post,
                              html: { id: 'form-registro-evento', multipart: true } do |f| %>

            <input type="hidden" id="cedula_frente_base64"            name="eventospersona[cedula_frente_base64]"            value="<%= @frente_b64 %>">
            <input type="hidden" id="cedula_reverso_base64"           name="eventospersona[cedula_reverso_base64]"           value="<%= @reverso_b64 %>">
            <input type="hidden" id="acudiente_cedula_frente_base64"  name="eventospersona[acudiente_cedula_frente_base64]"  value="<%= @acu_frente_b64 %>">
            <input type="hidden" id="acudiente_cedula_reverso_base64" name="eventospersona[acudiente_cedula_reverso_base64]" value="<%= @acu_rev_b64 %>">
            <input type="hidden" id="persona_ya_tiene_documentos"     name="eventospersona[persona_ya_tiene_documentos]"     value="0">
            <input type="hidden" id="acudiente_ya_tiene_documentos"   name="eventospersona[acudiente_ya_tiene_documentos]"   value="0">

            <h4 class="text-primary"><i class="fa fa-user"></i> Información Personal</h4>
            <hr>

            <div class="row">
              <div class="col-md-3">
                <%= f.input :identificacion, label: "Identificación", required: true, input_html: { class: 'form-control' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :nombre, label: "Nombre", required: true, input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :apellido, label: "Apellido", required: true, input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :tipo_persona, label: "Tipo", collection: ['CASADO', 'SEMINARISTA', 'SOLTERO'], required: true, input_html: { class: 'select2', id: 'tipo_persona' }, include_blank: 'Seleccione...' %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-4">
                <label>Fecha de Nacimiento <span class="text-danger">*</span></label>
                <div class="input-group">
                  <div class="input-group-addon" style="background: #EDEDED;"><i class="fa fa-calendar"></i></div>
                  <%= f.input :fecha_nacimiento, as: :string, label: false, required: true,
                              input_html: { class: 'form-control', autocomplete: 'off',
                                            placeholder: 'dd/mm/yyyy', id: 'fecha_nacimiento', readonly: true } %>
                </div>
                <small class="text-muted" id="edad-info" style="margin-top: 5px; display: none;">
                  <i class="fa fa-info-circle"></i> <span id="edad-texto"></span>
                </small>
              </div>
              <div class="col-md-4">
                <%= f.input :celular, label: "Celular", required: true, input_html: { class: 'form-control', maxlength: 20 } %>
              </div>
              <div class="col-md-4">
                <%= f.input :email, label: "Email", required: true, input_html: { class: 'form-control', type: 'email' } %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <%= f.input :direccion, label: "Dirección", required: true, input_html: { class: 'form-control', onchange: 'this.value=this.value.toUpperCase();' } %>
              </div>
              <div class="col-md-3">
                <%= f.input :sexo, label: "Sexo", collection: [['MASCULINO', 'M'], ['FEMENINO', 'F']], required: true, input_html: { class: 'select2' }, include_blank: 'Seleccione...' %>
              </div>
              <div class="col-md-3">
                <%= f.association :estado_civil, label: "Estado Civil",
                                  collection: EstadoCivil.where(estado: 'ACTIVO').order(:nombre),
                                  value_method: :id, label_method: :nombre, required: true,
                                  input_html: { class: 'select2' }, include_blank: 'Seleccione...' %>
              </div>
            </div>

            <h4 class="text-primary" style="margin-top: 30px;">
              <i class="fa fa-id-card"></i> Documento de Identidad
            </h4>
            <p class="text-muted"><small><i class="fa fa-info-circle"></i> Usa la cámara para fotografiar el frente y reverso de tu documento</small></p>
            <hr>

            <div class="row">
              <div class="col-md-4">
                <%= f.association :documento_tipo, label: "Tipo de Documento *",
                                  collection: DocumentoTipo.where(estado: 'activo').order(:nombre),
                                  value_method: :id, label_method: :nombre, required: true,
                                  input_html: { class: 'select2' }, include_blank: 'Seleccione...' %>
              </div>
            </div>

            <div id="badge-docs-existentes" class="alert alert-info" style="display:none; margin-top:15px;">
              <i class="fa fa-info-circle"></i> <strong>Esta persona ya tiene documentos registrados.</strong>
              Puedes usar los existentes o capturar nuevos con la cámara.
            </div>

            <div class="row" style="margin-top: 10px;">
              <div class="col-md-6">
                <div class="form-group">
                  <label><i class="fa fa-image"></i> Documento Frente <span class="text-danger">*</span></label>
                  <div>
                    <button type="button" class="btn btn-warning btn-camara-doc" onclick="reEvento.abrirCamara('frente', 'cedula_frente_base64')">
                      <i class="fa fa-camera"></i> Capturar Frente
                    </button>
                  </div>
                  <small class="text-muted">Parte frontal de tu documento</small>
                  <div id="preview-frente" style="display:none; margin-top: 10px;">
                    <p class="text-success" style="margin-bottom: 5px;"><i class="fa fa-check-circle"></i> <strong>Vista previa:</strong></p>
                    <img id="preview-frente-img" src="#" alt="Frente" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label><i class="fa fa-image"></i> Documento Reverso <span class="text-danger">*</span></label>
                  <div>
                    <button type="button" class="btn btn-warning btn-camara-doc" onclick="reEvento.abrirCamara('reverso', 'cedula_reverso_base64')">
                      <i class="fa fa-camera"></i> Capturar Reverso
                    </button>
                  </div>
                  <small class="text-muted">Parte trasera de tu documento</small>
                  <div id="preview-reverso" style="display:none; margin-top: 10px;">
                    <p class="text-success" style="margin-bottom: 5px;"><i class="fa fa-check-circle"></i> <strong>Vista previa:</strong></p>
                    <img id="preview-reverso-img" src="#" alt="Reverso" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sección Acudiente -->
            <div id="seccion-acudiente" style="display: none;">
              <h4 class="text-primary" style="margin-top: 30px;">
                <i class="fa fa-users"></i> Información del Acudiente
                <span class="label label-danger">OBLIGATORIO - MENOR DE EDAD</span>
              </h4>
              <p class="text-danger"><small><i class="fa fa-exclamation-triangle"></i> Debes completar esta sección porque eres menor de 18 años</small></p>
              <hr>

              <div class="row">
                <div class="col-md-4">
                  <%= f.input :acudiente_nombre, label: "Nombre del Acudiente",
                              input_html: { class: 'form-control acudiente-field', onchange: 'this.value=this.value.toUpperCase();', id: 'acudiente_nombre' } %>
                </div>
                <div class="col-md-4">
                  <%= f.input :acudiente_apellido, label: "Apellido del Acudiente",
                              input_html: { class: 'form-control acudiente-field', onchange: 'this.value=this.value.toUpperCase();', id: 'acudiente_apellido' } %>
                </div>
                <div class="col-md-4">
                  <%= f.input :acudiente_identificacion, label: "Identificación del Acudiente",
                              input_html: { class: 'form-control acudiente-field', maxlength: 30, id: 'acudiente_identificacion' } %>
                </div>
              </div>
              <div class="row">
                <div class="col-md-6">
                  <%= f.input :acudiente_email, label: "Email del Acudiente",
                              input_html: { class: 'form-control acudiente-field', type: 'email', id: 'acudiente_email' } %>
                </div>
                <div class="col-md-6">
                  <%= f.input :acudiente_celular, label: "Celular del Acudiente",
                              input_html: { class: 'form-control acudiente-field', maxlength: 20, id: 'acudiente_celular' } %>
                </div>
              </div>

              <h5 class="text-primary" style="margin-top: 20px;"><i class="fa fa-id-card"></i> Documento de Identidad del Acudiente</h5>
              <p class="text-muted"><small><i class="fa fa-info-circle"></i> Usa la cámara para fotografiar el documento del acudiente</small></p>
              <hr>

              <div class="row">
                <div class="col-md-4">
                  <div class="form-group">
                    <label>Tipo de Documento Acudiente <span class="text-danger">*</span></label>
                    <%= f.input :acudiente_documento_tipo_id, as: :select, label: false,
                                collection: DocumentoTipo.where(estado: 'activo').order(:nombre).map { |d| [d.nombre, d.id] },
                                input_html: { class: 'select2 acudiente-field', id: 'acudiente_documento_tipo_id' },
                                include_blank: 'Seleccione...' %>
                  </div>
                </div>
              </div>

              <div id="badge-docs-acudiente" class="alert alert-info" style="display:none; margin-top:10px;">
                <i class="fa fa-info-circle"></i> <strong>El acudiente ya tiene documentos registrados.</strong>
                Puedes usar los existentes o capturar nuevos con la cámara.
              </div>

              <div class="row" style="margin-top: 10px;">
                <div class="col-md-6">
                  <div class="form-group">
                    <label><i class="fa fa-image"></i> Cédula Acudiente Frente <span class="text-danger">*</span></label>
                    <div>
                      <button type="button" class="btn btn-warning btn-camara-doc" onclick="reEvento.abrirCamara('acudiente-frente', 'acudiente_cedula_frente_base64')">
                        <i class="fa fa-camera"></i> Capturar Frente Acudiente
                      </button>
                    </div>
                    <small class="text-muted">Parte frontal del documento del acudiente</small>
                    <div id="preview-acudiente-frente" style="display:none; margin-top: 10px;">
                      <p class="text-success" style="margin-bottom: 5px;"><i class="fa fa-check-circle"></i> <strong>Vista previa:</strong></p>
                      <img id="preview-acudiente-frente-img" src="#" alt="Frente acudiente" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-group">
                    <label><i class="fa fa-image"></i> Cédula Acudiente Reverso <span class="text-danger">*</span></label>
                    <div>
                      <button type="button" class="btn btn-warning btn-camara-doc" onclick="reEvento.abrirCamara('acudiente-reverso', 'acudiente_cedula_reverso_base64')">
                        <i class="fa fa-camera"></i> Capturar Reverso Acudiente
                      </button>
                    </div>
                    <small class="text-muted">Parte trasera del documento del acudiente</small>
                    <div id="preview-acudiente-reverso" style="display:none; margin-top: 10px;">
                      <p class="text-success" style="margin-bottom: 5px;"><i class="fa fa-check-circle"></i> <strong>Vista previa:</strong></p>
                      <img id="preview-acudiente-reverso-img" src="#" alt="Reverso acudiente" style="max-width:100%; max-height:200px; border:2px solid #5cb85c; border-radius:4px;"/>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <h4 class="text-primary" style="margin-top: 30px;"><i class="fa fa-file-text-o"></i> Aceptación de Políticas</h4>
            <hr>

            <div class="checkbox-required">
              <div class="checkbox">
                <label>
                  <%= f.check_box :acepta_politica, { required: true }, "SI", "NO" %>
                  <strong style="color: #071B7D;"><i class="fa fa-shield"></i> Acepto las políticas de tratamiento de datos personales <span class="text-danger">*</span></strong>
                </label>
              </div>
              <small class="text-muted" style="display: block; margin-top: 10px; padding-left: 26px;">Al marcar esta casilla, acepto que mis datos personales sean utilizados de acuerdo con la política de privacidad.</small>
            </div>

            <div class="checkbox-required">
              <div class="checkbox">
                <label>
                  <%= f.check_box :acepta_cultura, { required: true }, "SI", "NO" %>
                  <strong style="color: #071B7D;"><i class="fa fa-heart"></i> Acepto la cultura organizacional <span class="text-danger">*</span></strong>
                </label>
              </div>
              <small class="text-muted" style="display: block; margin-top: 10px; padding-left: 26px;">Me comprometo a seguir los valores y principios de la organización.</small>
            </div>

            <div class="form-group" style="margin-top: 30px;">
              <%= f.button :submit, "#{t :inscribir}", class: "btn btn-primary btn-lg btn-block" do %>
                <i class="fa fa-check-circle"></i> Registrarse en el Evento
              <% end %>
            </div>

            <p class="text-muted text-center">
              <small><i class="fa fa-info-circle"></i> Los campos marcados con (<span class="text-danger">*</span>) son obligatorios</small>
            </p>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ════════════════════════════════════════════════════════════════
    MODAL DE CÁMARA — rediseñado para móvil
    ════════════════════════════════════════════════════════════════ %>
<div class="modal fade" id="modalCamara" tabindex="-1" role="dialog" style="padding:0 !important; overflow:hidden !important;">
  <div class="modal-dialog modal-camara-custom" role="document">
    <div class="modal-content modal-camara-content">

      <%# ── Header compacto ── %>
      <div class="modal-camara-header">
        <span id="modal-titulo" class="modal-camara-titulo">
          <i class="fa fa-camera"></i> Capturar Documento
        </span>
        <button type="button" class="modal-camara-close" data-dismiss="modal">
          <i class="fa fa-times"></i>
        </button>
      </div>

      <%# ── Cuerpo: video + canvas superpuesto ── %>
      <div class="modal-camara-body">

        <%# Overlay de flash al tomar foto %>
        <div id="camara-flash" class="camara-flash"></div>

        <%# Video en vivo — ocupa toda la zona ── %>
        <video id="camara-video" autoplay playsinline
               class="camara-video" style="display:block;"></video>

        <%# Canvas — se muestra encima tras tomar foto ── %>
        <canvas id="camara-canvas" class="camara-canvas" style="display:none;"></canvas>

        <%# Líneas guía para encuadre del documento ── %>
        <div id="camara-guia" class="camara-guia">
          <div class="guia-esquina guia-tl"></div>
          <div class="guia-esquina guia-tr"></div>
          <div class="guia-esquina guia-bl"></div>
          <div class="guia-esquina guia-br"></div>
          <span class="guia-texto">Encuadra el documento</span>
        </div>

        <%# Error de cámara ── %>
        <div id="camara-error" class="camara-error-overlay" style="display:none;">
          <i class="fa fa-exclamation-triangle fa-2x"></i>
          <p>No se pudo acceder a la cámara.<br>Verifica los permisos del navegador.</p>
        </div>

        <%# Botón snap flotante sobre el video ── %>
        <div id="footer-capturar" class="snap-flotante">
          <button type="button" id="btn-snap" class="btn-camara-snap">
            <span class="btn-snap-circulo">
              <i class="fa fa-camera"></i>
            </span>
            <span class="btn-snap-label">Tomar Foto</span>
          </button>
        </div>

      </div><%# fin modal-camara-body %>

      <%# ── Footer: solo visible al confirmar foto ── %>
      <div class="modal-camara-footer">

        <%# Cancelar — siempre visible ── %>
        <div class="footer-cancelar-wrap">
          <button type="button" class="btn-camara-cancelar" data-dismiss="modal" id="btn-cancelar-camara">
            <i class="fa fa-times"></i> Cancelar
          </button>
        </div>

        <%# Estado: foto tomada, confirmar ── %>
        <div id="footer-confirmar" class="footer-estado" style="display:none;">
          <button type="button" id="btn-usar-foto" class="btn-camara-usar">
            <i class="fa fa-check"></i> Usar esta foto
          </button>
          <button type="button" id="btn-repetir" class="btn-camara-repetir">
            <i class="fa fa-refresh"></i> Repetir
          </button>
        </div>

      </div>

    </div><%# fin modal-content %>
  </div>
</div>

<%# ════════════════════════════════════════════════════
    CSS DEL MODAL DE CÁMARA
    ════════════════════════════════════════════════════ %>
<style>
    /* ── Sin scroll en el modal ── */
    #modalCamara { overflow: hidden !important; }
    #modalCamara .modal-dialog { overflow: hidden !important; }
    #modalCamara .modal-body   { overflow: hidden !important; padding: 0 !important; }

    /* ── Modal ocupa casi toda la pantalla en móvil ── */
    .modal-camara-custom {
        margin: 0 !important;
        padding: 0;
        width: 100%;
        max-width: 100%;
        height: calc(var(--vh, 1vh) * 100);
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
    }

    .modal-camara-content {
        display: flex;
        flex-direction: column;
        height: calc(var(--vh, 1vh) * 100);
        border-radius: 0;
        border: none;
        overflow: hidden;
        background: #000;
    }

    /* ── Header ── */
    .modal-camara-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(0,0,0,0.85);
        padding: 12px 16px;
        flex-shrink: 0;
        z-index: 10;
    }

    .modal-camara-titulo {
        color: #fff;
        font-size: 16px;
        font-weight: 600;
    }

    .modal-camara-close {
        background: rgba(255,255,255,0.15);
        border: none;
        color: #fff;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .modal-camara-close:hover { background: rgba(255,255,255,0.3); }

    /* ── Zona de cámara — ocupa todo el espacio disponible ── */
    .modal-camara-body {
        flex: 1;
        position: relative;
        overflow: hidden;
        background: #111;
        min-height: 0;
    }

    .camara-video,
    .camara-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ── Flash al tomar foto ── */
    .camara-flash {
        position: absolute;
        inset: 0;
        background: #fff;
        opacity: 0;
        pointer-events: none;
        z-index: 20;
        transition: opacity 0s;
    }

    .camara-flash.disparar {
        animation: flashAnim 0.4s ease-out forwards;
    }

    @keyframes flashAnim {
        0%   { opacity: 0.9; }
        100% { opacity: 0; }
    }

    /* ── Guías de encuadre ── */
    .camara-guia {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .guia-texto {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        color: rgba(255,255,255,0.7);
        font-size: 13px;
        background: rgba(0,0,0,0.4);
        padding: 3px 12px;
        border-radius: 20px;
        white-space: nowrap;
    }

    /* Esquinas del encuadre */
    .guia-esquina {
        position: absolute;
        width: 28px;
        height: 28px;
        border-color: rgba(255,255,255,0.8);
        border-style: solid;
    }

    .guia-tl { top: 16px;    left: 16px;    border-width: 3px 0 0 3px; border-radius: 4px 0 0 0; }
    .guia-tr { top: 16px;    right: 16px;   border-width: 3px 3px 0 0; border-radius: 0 4px 0 0; }
    .guia-bl { bottom: 60px; left: 16px;    border-width: 0 0 3px 3px; border-radius: 0 0 0 4px; }
    .guia-br { bottom: 60px; right: 16px;   border-width: 0 3px 3px 0; border-radius: 0 0 4px 0; }

    /* ── Overlay error ── */
    .camara-error-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.85);
        color: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        text-align: center;
        padding: 20px;
        z-index: 15;
    }

    /* ── Footer con botones — siempre visible ── */
    .modal-camara-footer {
        background: rgba(0,0,0,0.88);
        padding: 12px 20px;
        padding-bottom: max(12px, env(safe-area-inset-bottom));
        flex-shrink: 0;
        z-index: 10;
        min-height: 56px;
    }

    /* Botón snap flota en la parte inferior del body de cámara */
    .snap-flotante {
        position: absolute;
        bottom: 20px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 8;
        pointer-events: none;
    }

    .snap-flotante > * { pointer-events: auto; }

    .footer-cancelar-wrap {
        display: flex;
        justify-content: flex-end;
    }

    .footer-estado {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 10px;
    }

    /* Botón principal de disparo — círculo grande ── */
    .btn-camara-snap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        background: none;
        border: none;
        cursor: pointer;
    }

    .btn-snap-circulo {
        width: 72px;
        height: 72px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        color: #071B7D;
        box-shadow: 0 0 0 5px rgba(255,255,255,0.25), 0 4px 20px rgba(0,0,0,0.4);
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-camara-snap:active .btn-snap-circulo {
        transform: scale(0.91);
        box-shadow: 0 0 0 3px rgba(255,255,255,0.15), 0 2px 8px rgba(0,0,0,0.3);
    }

    .btn-snap-label {
        color: rgba(255,255,255,0.85);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    /* Botón cancelar ── */
    .btn-camara-cancelar {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.25);
        color: #fff;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-camara-cancelar:hover { background: rgba(255,255,255,0.22); }

    /* Botón usar foto ── */
    .btn-camara-usar {
        flex: 1;
        background: #27ae60;
        border: none;
        color: #fff;
        padding: 14px 20px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-camara-usar:active { transform: scale(0.97); background: #219a52; }

    /* Botón repetir ── */
    .btn-camara-repetir {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.25);
        color: #fff;
        padding: 14px 16px;
        border-radius: 10px;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: background 0.2s;
    }

    .btn-camara-repetir:hover { background: rgba(255,255,255,0.22); }

    /* ── En escritorio: modal más pequeño y bonito ── */
    @media (min-width: 768px) {
        .modal-camara-custom {
            width: 560px;
            max-width: 560px;
            margin: 40px auto;
            height: auto;
        }

        .modal-camara-content {
            height: auto;
            border-radius: 12px;
        }

        .modal-camara-body {
            height: 380px;
        }

        .guia-bl { bottom: 16px; }
        .guia-br { bottom: 16px; }
    }

    /* ── Botón de captura en el formulario ── */
    .btn-camara-doc {
        font-size: 15px;
        padding: 10px 18px;
    }
</style>

<script>
    var reEvento = (function($) {

        var streamActual    = null;
        var campoObjetivo   = null;
        var previewObjetivo = null;

        var titulosCamara = {
            'frente':            'Capturar Documento – Frente',
            'reverso':           'Capturar Documento – Reverso',
            'acudiente-frente':  'Capturar Documento Acudiente – Frente',
            'acudiente-reverso': 'Capturar Documento Acudiente – Reverso'
        };

        function abrirCamara(prefixPreview, campoId) {
            campoObjetivo   = campoId;
            previewObjetivo = prefixPreview;
            document.getElementById('modal-titulo').innerHTML =
                '<i class="fa fa-camera"></i> ' + (titulosCamara[prefixPreview] || 'Capturar Documento');

            // Reset estado
            var canvas = document.getElementById('camara-canvas');
            canvas.style.display = 'none';
            document.getElementById('camara-video').style.display = 'block';
            document.getElementById('footer-capturar').style.display = 'flex';
            document.getElementById('footer-confirmar').style.display = 'none';
            document.getElementById('btn-cancelar-camara').style.display = 'block';
            document.getElementById('camara-guia').style.display = 'flex';
            document.getElementById('camara-error').style.display = 'none';

            $('#modalCamara').modal('show');
        }

        // ── Abrir cámara al mostrar modal ───────────────────────────────
        $('#modalCamara').on('shown.bs.modal', function () {
            navigator.mediaDevices.getUserMedia({
                video: {
                    facingMode: { ideal: 'environment' },
                    width:  { ideal: 1280 },
                    height: { ideal: 720 }
                }
            })
                .then(function (stream) {
                    streamActual = stream;
                    var video = document.getElementById('camara-video');
                    video.srcObject = stream;
                    video.play();
                })
                .catch(function (err) {
                    console.error('Error cámara:', err);
                    document.getElementById('camara-error').style.display = 'flex';
                });
        });

        // ── Cerrar y limpiar stream ─────────────────────────────────────
        $('#modalCamara').on('hidden.bs.modal', function () {
            if (streamActual) {
                streamActual.getTracks().forEach(function (t) { t.stop(); });
                streamActual = null;
            }
            document.getElementById('camara-video').srcObject = null;
        });

        // ── Tomar foto ─────────────────────────────────────────────────
        document.getElementById('btn-snap').addEventListener('click', function () {
            var video  = document.getElementById('camara-video');
            var canvas = document.getElementById('camara-canvas');
            var ctx    = canvas.getContext('2d');

            canvas.width  = video.videoWidth  || 1280;
            canvas.height = video.videoHeight || 720;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            // Efecto flash
            var flash = document.getElementById('camara-flash');
            flash.classList.remove('disparar');
            void flash.offsetWidth; // reflow para reiniciar animación
            flash.classList.add('disparar');

            // Cambiar a modo "confirmar"
            setTimeout(function () {
                video.style.display  = 'none';
                canvas.style.display = 'block';
                document.getElementById('camara-guia').style.display     = 'none';
                document.getElementById('footer-capturar').style.display  = 'none';
                document.getElementById('footer-confirmar').style.display = 'flex';
                document.getElementById('btn-cancelar-camara').style.display = 'none';
            }, 150);
        });

        // ── Repetir ────────────────────────────────────────────────────
        document.getElementById('btn-repetir').addEventListener('click', function () {
            var video  = document.getElementById('camara-video');
            var canvas = document.getElementById('camara-canvas');
            canvas.style.display = 'none';
            video.style.display  = 'block';
            document.getElementById('camara-guia').style.display      = 'flex';
            document.getElementById('footer-capturar').style.display  = 'flex';
            document.getElementById('footer-confirmar').style.display = 'none';
            document.getElementById('btn-cancelar-camara').style.display = 'block';
        });

        // ── Usar foto ──────────────────────────────────────────────────
        document.getElementById('btn-usar-foto').addEventListener('click', function () {
            var canvas  = document.getElementById('camara-canvas');
            var dataUrl = canvas.toDataURL('image/jpeg', 0.85); // jpeg comprimido
            document.getElementById(campoObjetivo).value = dataUrl.split(',')[1];

            // Actualizar preview en el formulario
            var div = document.getElementById('preview-' + previewObjetivo);
            var img = document.getElementById('preview-' + previewObjetivo + '-img');
            if (div && img) { img.src = dataUrl; div.style.display = 'block'; }

            $('#modalCamara').modal('hide');
        });

        // ── Datepicker jQuery UI ───────────────────────────────────────
        $('#fecha_nacimiento').datepicker({
            changeMonth:       true,
            changeYear:        true,
            dateFormat:        'dd/mm/yy',
            maxDate:           new Date(),
            minDate:           '-100y',
            yearRange:         '-100:+0',
            dayNamesMin:       ['Do','Lu','Ma','Mi','Ju','Vi','Sa'],
            monthNames:        ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
                'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
            monthNamesShort:   ['Ene','Feb','Mar','Abr','May','Jun',
                'Jul','Ago','Sep','Oct','Nov','Dic'],
            firstDay:          1,
            showOtherMonths:   true,
            selectOtherMonths: true,
            onSelect: function(dateText) {
                $(this).val(dateText).trigger('change');
                setTimeout(validarEdad, 100);
            }
        });

        // ── Helpers de fecha ───────────────────────────────────────────
        function convertirFecha(fechaStr) {
            try {
                if (!fechaStr) return null;
                var partes = fechaStr.split('/');
                if (partes.length !== 3) return null;
                var dia  = parseInt(partes[0], 10);
                var mes  = parseInt(partes[1], 10) - 1;
                var anio = parseInt(partes[2], 10);
                if (anio < 100) anio += anio < 30 ? 2000 : 1900;
                if (isNaN(dia) || isNaN(mes) || isNaN(anio)) return null;
                return new Date(anio, mes, dia);
            } catch (e) { return null; }
        }

        function calcularEdad(fn) {
            try {
                var hoy  = new Date();
                var edad = hoy.getFullYear() - fn.getFullYear();
                var m    = hoy.getMonth() - fn.getMonth();
                if (m < 0 || (m === 0 && hoy.getDate() < fn.getDate())) edad--;
                return edad;
            } catch (e) { return null; }
        }

        // ── Validación de edad ─────────────────────────────────────────
        var $fn = $('#fecha_nacimiento');

        function validarEdad() {
            try {
                var val = $fn.val();
                if (!val) { $('#seccion-acudiente').hide(); $('#edad-info').hide(); return; }
                var f = convertirFecha(val);
                if (!f || isNaN(f.getTime())) return;
                var edad = calcularEdad(f);
                if (edad === null) return;

                if (edad < 18) {
                    $('#edad-texto').text('Edad: ' + edad + ' años - Debes completar la información del acudiente');
                    $('#edad-info').show().css('color', '#d9534f');
                    $('#seccion-acudiente').slideDown(400);
                    $('.acudiente-field').prop('required', true);
                } else {
                    $('#edad-texto').text('Edad: ' + edad + ' años');
                    $('#edad-info').show().css('color', '#5cb85c');
                    $('#seccion-acudiente').slideUp(400);
                    $('.acudiente-field').prop('required', false).val('');
                }
            } catch (e) { console.error('validarEdad:', e); }
        }

        $fn.on('changeDate change blur', function () { setTimeout(validarEdad, 100); });
        setTimeout(function () { if ($fn.val()) validarEdad(); }, 500);

        // ── Restaurar previews si el form volvió con errores ──────────
        (function restaurarPreviews() {
            [
                { i: 'cedula_frente_base64',            d: 'preview-frente',            m: 'preview-frente-img' },
                { i: 'cedula_reverso_base64',           d: 'preview-reverso',           m: 'preview-reverso-img' },
                { i: 'acudiente_cedula_frente_base64',  d: 'preview-acudiente-frente',  m: 'preview-acudiente-frente-img' },
                { i: 'acudiente_cedula_reverso_base64', d: 'preview-acudiente-reverso', m: 'preview-acudiente-reverso-img' }
            ].forEach(function(f) {
                var input = document.getElementById(f.i);
                if (input && input.value) {
                    var div = document.getElementById(f.d);
                    var img = document.getElementById(f.m);
                    if (div && img) { img.src = 'data:image/jpeg;base64,' + input.value; div.style.display = 'block'; }
                }
            });
        })();

        // ── Validación al enviar ───────────────────────────────────────
        $('#form-registro-evento').on('submit', function (e) {
            try {
                var politica = $('input[name="eventospersona[acepta_politica]"]');
                var cultura  = $('input[name="eventospersona[acepta_cultura]"]');

                if (!politica.is(':checked')) {
                    e.preventDefault();
                    alert('⚠️ Debe aceptar las políticas de tratamiento de datos personales.');
                    return false;
                }
                if (!cultura.is(':checked')) {
                    e.preventDefault();
                    alert('⚠️ Debe aceptar la cultura organizacional.');
                    return false;
                }

                var yaHayDocs = $('#persona_ya_tiene_documentos').val() === '1';
                if (!yaHayDocs) {
                    if (!$('#cedula_frente_base64').val()) {
                        e.preventDefault(); alert('⚠️ Debes capturar la foto del Documento Frente.'); return false;
                    }
                    if (!$('#cedula_reverso_base64').val()) {
                        e.preventDefault(); alert('⚠️ Debes capturar la foto del Documento Reverso.'); return false;
                    }
                }

                var fechaStr = $fn.val();
                if (fechaStr) {
                    var fecha = convertirFecha(fechaStr);
                    if (fecha) {
                        var edad = calcularEdad(fecha);
                        if (edad !== null && edad < 18) {
                            var vacios = [];
                            if (!$('#acudiente_nombre').val().trim())         vacios.push('Nombre del Acudiente');
                            if (!$('#acudiente_apellido').val().trim())       vacios.push('Apellido del Acudiente');
                            if (!$('#acudiente_identificacion').val().trim()) vacios.push('Identificación del Acudiente');
                            if (!$('#acudiente_email').val().trim())          vacios.push('Email del Acudiente');
                            if (!$('#acudiente_celular').val().trim())        vacios.push('Celular del Acudiente');

                            var acuDocs = $('#acudiente_ya_tiene_documentos').val() === '1';
                            if (!acuDocs) {
                                if (!$('#acudiente_cedula_frente_base64').val())  vacios.push('Foto frente del acudiente');
                                if (!$('#acudiente_cedula_reverso_base64').val()) vacios.push('Foto reverso del acudiente');
                            }

                            if (vacios.length > 0) {
                                e.preventDefault();
                                alert('⚠️ Eres menor de edad (' + edad + ' años).\n\nDebes completar:\n\n• ' + vacios.join('\n• '));
                                document.getElementById('seccion-acudiente').scrollIntoView({ behavior: 'smooth', block: 'center' });
                                return false;
                            }
                        }
                    }
                }
            } catch (err) { console.error('submit error:', err); }
        });

        // ── Limpiar formulario al cambiar cédula ──────────────────────
        var ultimaCedula = $('#eventospersona_identificacion').val();

        function limpiarFormulario() {
            ['nombre','apellido','celular','email','direccion'].forEach(function(f) {
                $('#eventospersona_' + f).val('').trigger('change');
            });
            $fn.val('');
            $('#eventospersona_sexo, #eventospersona_estado_civil_id, #eventospersona_documento_tipo_id').val('').trigger('change');
            $('#cedula_frente_base64, #cedula_reverso_base64').val('');
            $('#acudiente_cedula_frente_base64, #acudiente_cedula_reverso_base64').val('');
            $('#preview-frente, #preview-reverso, #preview-acudiente-frente, #preview-acudiente-reverso').hide();
            $('#persona_ya_tiene_documentos, #acudiente_ya_tiene_documentos').val('0');
            $('#badge-docs-existentes, #badge-docs-acudiente').hide();
            $('#seccion-acudiente, #edad-info').hide();
        }

        // ── Autocompletar desde identificación ────────────────────────
        var buscarTimer = null;

        $('#eventospersona_identificacion').on('blur', function () {
            var id = $(this).val().trim();
            if (id !== ultimaCedula) { ultimaCedula = id; limpiarFormulario(); }
            if (id.length < 5) return;

            clearTimeout(buscarTimer);
            buscarTimer = setTimeout(function () {
                $.ajax({
                    url: '<%= buscar_persona_registro_evento_path(@evento.guid) %>',
                    method: 'GET',
                    data: { identificacion: id },
                    success: function (data) {
                        if (!data.encontrada) return;
                        $('#eventospersona_nombre').val(data.nombre).trigger('change');
                        $('#eventospersona_apellido').val(data.apellido).trigger('change');
                        $('#eventospersona_celular').val(data.celular).trigger('change');
                        $('#eventospersona_email').val(data.email).trigger('change');
                        $('#eventospersona_direccion').val(data.direccion).trigger('change');
                        if (data.fecha_nacimiento) { $fn.val(data.fecha_nacimiento); setTimeout(validarEdad, 200); }
                        if (data.sexo)              $('#eventospersona_sexo').val(data.sexo).trigger('change');
                        if (data.estado_civil_id)   $('#eventospersona_estado_civil_id').val(data.estado_civil_id).trigger('change');
                        if (data.documento_tipo_id) $('#eventospersona_documento_tipo_id').val(data.documento_tipo_id).trigger('change');

                        if (data.tiene_documentos && data.cedula_frente_url && data.cedula_reverso_url) {
                            document.getElementById('preview-frente-img').src    = data.cedula_frente_url;
                            document.getElementById('preview-reverso-img').src   = data.cedula_reverso_url;
                            $('#preview-frente, #preview-reverso').show();
                            $('#persona_ya_tiene_documentos').val('1');
                            $('#badge-docs-existentes').show();
                        } else {
                            $('#persona_ya_tiene_documentos').val('0');
                            $('#badge-docs-existentes, #preview-frente, #preview-reverso').hide();
                            $('#cedula_frente_base64, #cedula_reverso_base64').val('');
                        }
                    },
                    error: function () { console.warn('Error al buscar persona'); }
                });
            }, 300);
        });

        // ── Autocompletar acudiente ────────────────────────────────────
        $('#acudiente_identificacion').on('blur', function () {
            var id = $(this).val().trim();
            if (id.length < 5) return;
            $.ajax({
                url: '<%= buscar_persona_registro_evento_path(@evento.guid) %>',
                method: 'GET',
                data: { identificacion: id },
                success: function (data) {
                    if (!data.encontrada) return;
                    if (data.nombre)            $('#acudiente_nombre').val(data.nombre).trigger('change');
                    if (data.apellido)          $('#acudiente_apellido').val(data.apellido).trigger('change');
                    if (data.celular)           $('#acudiente_celular').val(data.celular).trigger('change');
                    if (data.email)             $('#acudiente_email').val(data.email).trigger('change');
                    if (data.documento_tipo_id) $('#acudiente_documento_tipo_id').val(data.documento_tipo_id).trigger('change');

                    if (data.tiene_documentos && data.cedula_frente_url && data.cedula_reverso_url) {
                        document.getElementById('preview-acudiente-frente-img').src  = data.cedula_frente_url;
                        document.getElementById('preview-acudiente-reverso-img').src = data.cedula_reverso_url;
                        $('#preview-acudiente-frente, #preview-acudiente-reverso').show();
                        $('#acudiente_ya_tiene_documentos').val('1');
                        $('#badge-docs-acudiente').show();
                    } else {
                        $('#acudiente_ya_tiene_documentos').val('0');
                        $('#badge-docs-acudiente').hide();
                    }
                },
                error: function () { console.warn('Error al buscar acudiente'); }
            });
        });

        console.log('✅ reEvento inicializado');
        return { abrirCamara: abrirCamara };

    }(jQuery));

    /* ── Altura real del viewport (evita barra Safari/Chrome) ── */
    (function() {
        function setVh() {
            var vh = window.innerHeight * 0.01;
            document.documentElement.style.setProperty('--vh', vh + 'px');
        }
        setVh();
        window.addEventListener('resize', setVh);
        window.addEventListener('orientationchange', function() {
            setTimeout(setVh, 200);
        });

        // Recalcular al abrir el modal (cuando aparece/desaparece la barra del browser)
        document.getElementById('modalCamara').addEventListener('shown.bs.modal', function() {
            setTimeout(setVh, 100);
        });
    })();
</script>
