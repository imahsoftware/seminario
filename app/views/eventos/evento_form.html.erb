<!-- app/views/eventos/evento_form.html.erb -->
<% if @evento.etapa.to_s == "A" %>
  <%= simple_form_for @evento do |f| %>
    <%= hidden_field_tag :etapa, @evento.etapa.to_s %>
    <div class="box box-danger">
      <div class="box-header">
        <legend>Información del evento</legend>
      </div>
      <div class="box-body">

        <%# ── 1. Evento Especial (siempre primero) ── %>
        <% if is_auth_c('EVENTO_ESPECIAL') %>
          <div class="row" style="margin-bottom: 15px;">
            <div class="col-md-12">
              <div class="callout" style="border-left: 5px solid #071B7D; background-color: #f0f3ff; padding: 12px 15px;">
                <div class="checkbox" style="margin: 0;">
                  <label>
                    <%= f.check_box :evento_especial, { class: 'minimal' }, "1", "0" %>
                    <strong style="color: #071B7D; font-size: 14px;">
                      <i class="fa fa-star"></i> Evento Especial
                    </strong>
                    <small style="font-weight: normal; margin-left: 8px; color: #444;">
                      — Habilita el registro de voluntarios en el formulario público
                      (Día del Seminario, Día de la Alcancía, Cena Concierto, Encuentro Navideño, Cena Colaboradores)
                    </small>
                  </label>
                </div>
              </div>
            </div>
          </div>
        <% elsif @evento.evento_especial? %>
          <div class="row" style="margin-bottom: 15px;">
            <div class="col-md-12">
              <div class="callout" style="border-left: 5px solid #e67e22; background-color: #fef9f0; padding: 12px 15px;">
                <strong style="color: #e67e22; font-size: 14px;">
                  <i class="fa fa-star"></i> Evento Especial
                </strong>
                <small style="font-weight: normal; margin-left: 8px; color: #666;">
                  — Este evento está marcado como especial. Solo usuarios autorizados pueden modificar esta configuración.
                </small>
              </div>
            </div>
          </div>
        <% end %>

        <%# ── 2. Campos que cambian según tipo ── %>
        <div class="row">
          <%# Iglesia / Comunidad / Tipo — solo eventos normales %>
          <div id="campos-normales-evento" style="display: <%= @evento.evento_especial? ? 'none' : 'contents' %>;">
            <div class="col-md-3">
              <%= f.input :iglesia_id,
                          collection: Iglesia.all.order(:nombre).collect { |p| [p.nombre, p.id] },
                          input_html: { class: 'select2', id: 'evento_iglesia_id' },
                          as: :select, include_blank: true, label: "Iglesia" %>
            </div>
            <div class="col-md-3">
              <%= f.input :iglesiascomunidad_id,
                          collection: [],
                          input_html: { class: 'select2', id: 'evento_iglesiascomunidad_id' },
                          as: :select, include_blank: true, label: "Comunidad" %>
            </div>
            <div class="col-md-3">
              <%= f.input :tiposevento_id,
                          collection: Tiposevento.where(estado: "ACTIVO").order(:descripcion).collect { |p| [p.descripcion, p.id] },
                          input_html: { class: 'select2' },
                          as: :select, include_blank: true, label: "Tipo de Evento" %>
            </div>
          </div>

          <%# Nombre del Evento — solo eventos especiales %>
          <div id="campos-especiales-evento" style="display: <%= @evento.evento_especial? ? 'contents' : 'none' %>;">
            <div class="col-md-6">
              <div id="detalle-especial">
                <%= f.input :detalle, as: :string,
                            label: "Nombre del Evento",
                            input_html: { id: 'detalle_especial_input', class: 'form-control',
                                          onchange: "this.value=this.value.toUpperCase();",
                                          placeholder: "Ej: Día del Seminario, Cena Concierto...",
                                          value: @evento.detalle.to_s } %>
              </div>
            </div>
          </div>

          <%# Fecha Inicio Inscripción — siempre visible %>
          <div class="col-md-3">
            <label>Fecha Inicio Inscripción</label>
            <div class="input-group">
              <div class="input-group-addon" style="background: #EDEDED;"><i class="fa fa-calendar"></i></div>
              <%= f.input :fecha_inicio, as: :string, label: false,
                          input_html: { class: 'form-control datepicker', autocomplete: 'off' } %>
            </div>
          </div>
        </div>

        <%# ── 3. Fechas + Estado ── %>
        <div class="row" style="margin-top: 10px;">
          <div class="col-md-3">
            <label>Fecha Fin Inscripción</label>
            <div class="input-group">
              <div class="input-group-addon" style="background: #EDEDED;"><i class="fa fa-calendar"></i></div>
              <%= f.input :fecha_fin, as: :string, label: false,
                          input_html: { class: 'form-control datepicker', autocomplete: 'off' } %>
            </div>
          </div>
          <div class="col-md-3">
            <label>Fecha Inicio Evento</label>
            <div class="input-group">
              <div class="input-group-addon" style="background: #EDEDED;"><i class="fa fa-calendar"></i></div>
              <%= f.input :fecha_inicio_e, as: :string, label: false,
                          input_html: { class: 'form-control datepicker', autocomplete: 'off' } %>
            </div>
          </div>
          <div class="col-md-3">
            <label>Fecha Fin Evento</label>
            <div class="input-group">
              <div class="input-group-addon" style="background: #EDEDED;"><i class="fa fa-calendar"></i></div>
              <%= f.input :fecha_fin_e, as: :string, label: false,
                          input_html: { class: 'form-control datepicker', autocomplete: 'off' } %>
            </div>
          </div>
          <div class="col-md-3">
            <%= f.input :estado,
                        collection: select_estado,
                        as: :select,
                        input_html: { data: { width: '100%' }, class: 'select2' } %>
          </div>
        </div>

        <%# ── 4. Cantidades + Detalle normal ── %>
        <div class="row" style="margin-top: 10px;">
          <div class="col-md-3">
            <%= f.input :cantidad_persona,
                        as: :integer,
                        label: "Cantidad de Personas Permitidas",
                        input_html: { class: 'form-control', min: 0 } %>
          </div>
          <div class="col-md-3">
            <label class="form-label">Cantidad de Personas Registradas</label>
            <%= text_field_tag :cantidad_registradas,
                               @evento.eventospersonas.size,
                               class: 'form-control',
                               disabled: true %>
          </div>
          <div class="col-md-6" id="detalle-normal" style="display: <%= @evento.evento_especial? ? 'none' : 'block' %>;">
            <%= f.input :detalle, as: :text,
                        input_html: { onchange: "this.value=this.value.toUpperCase();" } %>
          </div>
        </div>

        <%# ── Selector Habeas Data + botón descarga ── %>
        <div class="row" style="margin-top: 10px;">
          <div class="col-md-4">
            <%= f.input :habeas_data_parametro_id,
                        label: "Habeas Data",
                        collection: Iparametro.where("campo = 'HABEAS_DATA'").order(:descripcion).collect { |p| [p.descripcion, p.id] },
                        as: :select,
                        input_html: { class: 'select2', id: 'evento_habeas_data_parametro_id' },
                        include_blank: 'Seleccione documento...' %>
          </div>
          <div class="col-md-2" style="padding-top: 25px;">
            <a id="habeas-data-link"
               href="<%= @evento.habeas_data_parametro&.valor.to_s %>"
               class="btn btn-default"
               target="_blank"
               style="<%= @evento.habeas_data_parametro_id.present? ? '' : 'display:none;' %>">
              <i class="fa fa-download"></i> Descargar
            </a>
          </div>
        </div>

        <!-- URL pública (solo si el evento ya fue creado) -->
        <% if @evento.persisted? && @evento.url_publica.present? %>
          <div class="row" style="margin-top: 20px;">
            <div class="col-md-12">
              <h4><i class="icon fa fa-link"></i> URL de Registro Público</h4>
              <p>Comparte esta URL para que las personas se registren en el evento:</p>
              <div class="input-group">
                <input type="text" class="form-control" id="url_publica"
                       value="<%= @evento.url_publica %>" readonly>
                <span class="input-group-btn">
                  <button class="btn btn-primary" type="button"
                          id="btn_copiar_url" data-clipboard-target="#url_publica">
                    <i class="fa fa-copy"></i> Copiar URL
                  </button>
                  <a href="<%= @evento.url_publica %>" target="_blank" class="btn btn-success">
                    <i class="fa fa-external-link"></i> Ver formulario
                  </a>
                </span>
              </div>
              <small class="help-block">
                <strong>Vigencia:</strong>
                Del <%= @evento.fecha_inicio.strftime("%d/%m/%Y") %>
                al <%= @evento.fecha_fin.strftime("%d/%m/%Y") %>
                <% if @evento.vigente? %>
                  <span class="label label-success">VIGENTE</span>
                <% elsif @evento.vencido? %>
                  <span class="label label-danger">VENCIDO</span>
                <% else %>
                  <span class="label label-warning">NO INICIADO</span>
                <% end %>
              </small>
            </div>
          </div>
        <% end %>

        <%# ── Documentos para voluntarios (solo eventos especiales ya guardados) ── %>
        <% if @evento.persisted? && @evento.evento_especial? %>
          <div class="row" style="margin-top: 20px;">
            <div class="col-md-12">
              <div class="box box-info" style="margin-bottom: 0;">
                <div class="box-header with-border">
                  <h4 class="box-title"><i class="fa fa-file-text-o"></i> Documentos para Voluntarios</h4>
                </div>
                <div class="box-body" id="seccion-documentos-evento">
                  <%= render 'documentos_asignados', evento: @evento %>
                </div>
              </div>
            </div>
          </div>
        <% elsif @evento.new_record? && @evento.evento_especial? %>
          <div class="alert alert-info" style="margin-top: 15px;">
            <i class="fa fa-info-circle"></i> Guarda el evento primero para poder asignar documentos.
          </div>
        <% end %>

        <div class="box-footer"></div>
        <div class="box-tools pull-right">
          <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
        </div>
      </div>
    </div>
  <% end %>

<% elsif @evento.etapa.to_s == "B" %>
  <%= render "eventospersonas/tabla", eventospersonas: @eventospersonas %>
<% elsif @evento.etapa.to_s == "C" %>
  <%= render "eventosusers/eventosusers" %>
<% end %>

<% if @evento.persisted? && @evento.url_publica.present? %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.11/clipboard.min.js"></script>
  <script>
      $(document).ready(function () {
          var clipboard = new ClipboardJS('#btn_copiar_url');
          clipboard.on('success', function (e) {
              toastr.success('URL copiada al portapapeles');
              e.clearSelection();
          });
          clipboard.on('error', function () {
              toastr.error('Error al copiar la URL');
          });
      });
  </script>
<% end %>

<script>
$(document).ready(function () {
    function toggleCamposEspecial(esEspecial) {
        if (esEspecial) {
            // Ocultar campos normales (Iglesia, Comunidad, Tipo) y detalle normal
            $('#campos-normales-evento').hide();
            $('#detalle-normal').hide();
            // Mostrar campos especiales (Nombre del Evento)
            $('#campos-especiales-evento').css('display', 'contents');
            // Limpiar selects de iglesia/tipo para que no bloqueen la validación del servidor
            $('#evento_iglesia_id').val('').trigger('change');
            $('#evento_iglesiascomunidad_id').val('').trigger('change');
            $('#evento_tiposevento_id').val('').trigger('change');
        } else {
            // Mostrar campos normales y detalle normal
            $('#campos-normales-evento').css('display', 'contents');
            $('#detalle-normal').show();
            // Ocultar campos especiales
            $('#campos-especiales-evento').hide();
        }
    }

    // Sincronizar input oculto del detalle especial con el campo real
    $('#detalle_especial_input').on('input change', function () {
        $('#evento_detalle').val($(this).val());
    });

    // Ejecutar al cambiar el checkbox
    $('input[name="evento[evento_especial]"][type="checkbox"]').on('change', function () {
        toggleCamposEspecial($(this).is(':checked'));
    });

    // Ejecutar al cargar la página según estado inicial
    var inicialEspecial = $('input[name="evento[evento_especial]"][type="checkbox"]').is(':checked');
    toggleCamposEspecial(inicialEspecial);
});
</script>

<script>
    $(document).ready(function () {

        // ── Mapa precargado: id => { descripcion, url } ──────────────────
        var habeasDataMap = <%= raw Iparametro.where("campo = 'HABEAS_DATA'").order(:descripcion).each_with_object({}) { |p, h|
        h[p.id] = { descripcion: p.descripcion.to_s, url: p.valor.to_s }
      }.to_json %>;

        // ── Mostrar/ocultar botón de descarga al cambiar el selector ─────
        $('#evento_habeas_data_parametro_id').on('change', function () {
            var id = $(this).val();
            var $link = $('#habeas-data-link');

            if (!id || !habeasDataMap[id]) {
                $link.hide();
                return;
            }

            $link.attr('href', habeasDataMap[id].url).show();
        });

        // ── Comunidades por iglesia ──────────────────────────────────────
        var iglesiaActual = $('#evento_iglesia_id').val();
        var comunidadActual = '<%= @evento.iglesiascomunidad_id %>';

        if (iglesiaActual) {
            cargarComunidades(iglesiaActual, comunidadActual);
        }

        $('#evento_iglesia_id').on('change', function () {
            cargarComunidades($(this).val(), null);
        });

        function cargarComunidades(iglesiaId, comunidadSeleccionada) {
            var $select = $('#evento_iglesiascomunidad_id');
            $select.empty().append('<option value="">Seleccione...</option>');
            if (!iglesiaId) return;

            $.ajax({
                url: '/iglesiascomunidades/por_iglesia',
                data: {iglesia_id: iglesiaId},
                success: function (data) {
                    if (data.mensaje) {
                        $select.append('<option value="">' + data.mensaje + '</option>');
                    } else {
                        $.each(data, function (i, comunidad) {
                            var selected = comunidad.id == comunidadSeleccionada ? 'selected' : '';
                            $select.append(
                                '<option value="' + comunidad.id + '" ' + selected + '>' +
                                comunidad.nombre + '</option>'
                            );
                        });
                    }
                    $select.trigger('change');
                }
            });
        }

        $(".select2").select2();

        $('.datepicker').datepicker({
            dayNamesMin: ["Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb"],
            monthNamesShort: ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"],
            dateFormat: "yy-mm-dd",
            yearRange: '1950:2030',
            changeMonth: true,
            changeYear: true
        });


    });
</script>
