<tr id="evento_<%= evento.id %>">
  <td class="text-center">
      <%= link_to edit_evento_path(evento), remote: true, class: 'edit_modulo_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
         <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to modulo, remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
   </td>
  <td><%= evento.descripcion %></td>
  <td><%= evento.controlador %></td>
  <td><%= evento.imagen %></td>
  <td><%= evento.mensaje %></td>
  <td><%= evento.nivel %></td>
  <td><%= evento.autorizado %></td>
  <!-- #evento.grupo -->
  <!-- #evento.color -->
</tr>
