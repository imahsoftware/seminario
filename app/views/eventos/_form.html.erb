<%= simple_form_for @evento do |f| %>

  <div class="bs-callout">

    <% if @evento.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@evento.errors.count, "error") %> impidieron guardar el registro:</h4>
        <ul>
          <% @evento.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- FILA 1 -->
    <div class="row">
      <div class="col-md-4">
        <%= f.input :guid, input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-4">
        <%= f.input :iglesia_id,
                    collection: @iglesias,
                    label_method: :nombre,
                    value_method: :id,
                    include_blank: true,
                    input_html: { class: 'select2 clean' } %>
      </div>

      <div class="col-md-4">
        <%= f.input :iglesiascomunidad_id,
                    label: "Iglesia Comunidad",
                    collection:  @iglesias_comunidad,
                    label_method: :nombre,
                    value_method: :id,
                    include_blank: true,
                    input_html: { class: 'select2 clean' } %>
      </div>
    </div>

    <!-- FILA 2 -->
    <div class="row">

      <div class="col-md-4">
        <%= f.input :tiposevento_id,
                    label: "Tipo de Evento",
                    collection: @tipos_evento,
                    label_method: :descripcion,
                    value_method: :id,
                    include_blank: true,
                    input_html: { class: 'select2 clean' } %>
      </div>

      <!-- FECHA INICIO -->
      <div class="col-md-4">
        <label>Fecha Inicio</label>
        <div class="input-group">
          <div class="input-group-addon" style="background: #EDEDED;">
            <i class="fa fa-calendar"></i>
          </div>
          <%= f.input :fecha_inicio,
                      as: :string,
                      label: false,
                      input_html: {
                        class: 'form-control datetimepicker',
                        autocomplete: 'off'
                      } %>
        </div>
      </div>

      <!-- FECHA FIN -->
      <div class="col-md-4">
        <label>Fecha Fin</label>
        <div class="input-group">
          <div class="input-group-addon" style="background: #EDEDED;">
            <i class="fa fa-calendar"></i>
          </div>
          <%= f.input :fecha_fin,
                      as: :string,
                      label: false,
                      input_html: {
                        class: 'form-control datetimepicker',
                        autocomplete: 'off'
                      } %>
        </div>
      </div>

    </div>

    <!-- FILA 3 -->
    <div class="row">
      <div class="col-md-6">
        <%= f.input :detalle, input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-3">
        <%= f.input :estado,
                    input_html: { class: 'clean' } %>
      </div>

      <div class="col-md-3">
        <%= f.input :user_act,
                    input_html: { class: 'clean' } %>
      </div>
    </div>

    <!-- BOTONES -->
    <div class="row">
      <div class="col-md-6">
        <%= link_to "Cancelar", eventos_path,
                    class: "btn btn-flat btn-default pull-left" %>
      </div>

      <div class="col-md-6">
        <%= f.button :submit, "Guardar",
                     class: "btn btn-danger pull-right" %>
      </div>
    </div>

  </div>

<% end %>
<script>
    $(function () {
        $('.datetimepicker').datetimepicker({
            format: 'DD/MM/YYYY',
            locale: 'es',
            viewMode: 'days'
        });
    });
</script>
