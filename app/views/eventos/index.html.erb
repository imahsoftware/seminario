<div class="box box-primary">
  <div class="box-header with-border">
    <legend>
      Compañias
      <%= link_to new_evento_path, class: 'btn btn-sm btn-info' do %>
        <i class="fa fa-plus-square"> </i> <span>Nueva compañia</span>
      <% end %>
    </legend>
    <div class="box-tools pull-right">
      <%= search_form_for @q do |f| %>
        <div class="input-group input-group-sm" style="width: 180px;">
          <%= f.search_field :detalle_cont, onChange: 'javascript:this.value=this.value.toUpperCase();', class: 'form-control pull-right input_uppercase', placeholder: 'Buscar...' %>
          <div class="input-group-btn">
            <%= button_tag(type: "submit", class: "btn btn-default") do %>
              <i class="fa fa-search"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div><!-- /.box-tools -->
  </div><!-- /.box-header -->
  <div class="box-body">
    <div class="row">
      <div class="col-md-12">
        <div id="eventos-form" hidden></div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
      <div class="box-body table-responsive">
        <table class="table table-bordered table-condensed table-striped">
          <thead>
          <tr class="thcolor">
            <th class="text-center">Acciones</th>
            <th>Descripción</th>
            <th>Controlador</th>
            <th>Imagen</th>
            <th>Mensaje</th>
            <th>Nivel</th>
            <th>Autorizado</th>
          </tr>
          </thead>
          <tbody id="eventos-tbody">
          <% @eventos.order(created_at: :desc).each do |evento| %>
            <tr id="evento_<%= evento.id %>">
              <td class="text-center">
                <%= link_to edit_evento_path(evento), remote: true, class: 'edit_modulo_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                  <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                <% end %>
                <%= link_to modulo, remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                  <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                <% end %>
              </td>
              <td><%= evento.descripcion %></td>
              <td><%= evento.controlador %></td>
              <td><%= evento.imagen %></td>
              <td><%= evento.mensaje %></td>
              <td><%= evento.nivel %></td>
              <td><%= evento.autorizado %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
      </div>
    </div>
  </div><!-- /.box-body -->
  <div class="box-footer clear-fix">
		<div class="box-tools pull-right">
			<%= will_paginate @eventos, renderer: BootstrapPagination::Rails %>
		</div>
  </div><!-- box-footer -->
</div><!-- /.box -->
