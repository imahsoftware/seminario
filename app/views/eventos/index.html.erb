<%# app/views/eventos/index.html.erb %>

<div class="box box-primary">

  <%# ── HEADER ────────────────────────────────────────────────────── %>
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-calendar"></i> Eventos</h3>
    <div class="box-tools pull-right" style="display:flex; gap:6px; align-items:center;">

      <%= link_to new_evento_path, class: 'btn btn-sm btn-success' do %>
        <i class="fa fa-plus-square"></i> Nuevo Evento
      <% end %>

      <%= search_form_for @q do |f| %>
        <div class="input-group input-group-sm" style="width: 220px;">
          <%= f.search_field :detalle_cont,
                             onChange: 'javascript:this.value=this.value.toUpperCase();',
                             class: 'form-control input_uppercase',
                             placeholder: 'Buscar evento...' %>
          <div class="input-group-btn">
            <%= button_tag(type: "submit", class: "btn btn-default") do %>
              <i class="fa fa-search"></i>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# ── TABS ──────────────────────────────────────────────────────── %>
  <div class="box-body" style="padding-bottom: 0;">
    <ul class="nav nav-tabs" id="eventosTabs" role="tablist">
      <li role="presentation" class="<%= params[:tab] == 'especiales' ? '' : 'active' %>">
        <a href="#tab-normales" role="tab" data-toggle="tab" data-tab="normales">
          <i class="fa fa-calendar"></i> Eventos
          <span class="badge" style="background-color: #071B7D; margin-left: 5px;">
            <%= @eventos_normales.total_entries %>
          </span>
        </a>
      </li>
      <% if is_auth_c('EVENTO_ESPECIAL') || @eventos_especiales.any? %>
        <li role="presentation" class="<%= params[:tab] == 'especiales' ? 'active' : '' %>">
          <a href="#tab-especiales" role="tab" data-toggle="tab" data-tab="especiales">
            <i class="fa fa-star" style="color: #f39c12;"></i> Eventos Especiales
            <span class="badge" style="background-color: #f39c12; margin-left: 5px;">
              <%= @eventos_especiales.total_entries %>
            </span>
          </a>
        </li>
      <% end %>
    </ul>
  </div>

  <%# ── CONTENIDO TABS ─────────────────────────────────────────────── %>
  <div class="tab-content" style="padding: 0;">

    <%# ── TAB: EVENTOS NORMALES ──────────────────────────────────────── %>
    <div role="tabpanel"
         class="tab-pane <%= params[:tab] == 'especiales' ? '' : 'active' %>"
         id="tab-normales">
      <div class="box-body table-responsive" style="padding-top: 0;">
        <%= render 'tabla_eventos', eventos: @eventos_normales, tipo: :normal %>
      </div>
      <div class="box-footer clearfix">
        <div class="pull-right">
          <%= will_paginate @eventos_normales,
                            renderer: BootstrapPagination::Rails,
                            params: { tab: 'normales', page_e: params[:page_e] } %>
        </div>
        <div class="pull-left text-muted" style="padding-top: 6px;">
          <small>
            Mostrando <%= @eventos_normales.offset_value + 1 %> –
            <%= [@eventos_normales.offset_value + @eventos_normales.length, @eventos_normales.total_entries].min %>
            de <%= @eventos_normales.total_entries %> eventos
          </small>
        </div>
      </div>
    </div>

    <%# ── TAB: EVENTOS ESPECIALES ─────────────────────────────────────── %>
    <% if is_auth_c('EVENTO_ESPECIAL') || @eventos_especiales.any? %>
      <div role="tabpanel"
           class="tab-pane <%= params[:tab] == 'especiales' ? 'active' : '' %>"
           id="tab-especiales">
        <div class="box-body table-responsive" style="padding-top: 0;">
          <%= render 'tabla_eventos', eventos: @eventos_especiales, tipo: :especial %>
        </div>
        <div class="box-footer clearfix">
          <div class="pull-right">
            <%= will_paginate @eventos_especiales,
                              renderer: BootstrapPagination::Rails,
                              params: { tab: 'especiales', page: params[:page] } %>
          </div>
          <div class="pull-left text-muted" style="padding-top: 6px;">
            <small>
              Mostrando <%= @eventos_especiales.offset_value + 1 %> –
              <%= [@eventos_especiales.offset_value + @eventos_especiales.length, @eventos_especiales.total_entries].min %>
              de <%= @eventos_especiales.total_entries %> eventos especiales
            </small>
          </div>
        </div>
      </div>
    <% end %>

  </div><%# /tab-content %>

</div>

<script>
  $(document).ready(function () {
    $('[data-toggle="tooltip"]').tooltip();

    // Recordar tab activo en la URL al cambiar
    $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
      var tabName = $(e.target).data('tab');
      // Actualizar URL sin recargar la página
      var url = new URL(window.location.href);
      url.searchParams.set('tab', tabName);
      window.history.replaceState({}, '', url.toString());
    });
  });
</script>
