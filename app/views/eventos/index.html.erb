<%# app/views/eventos/index.html.erb %>

<div class="box box-primary">

  <%# ── HEADER ────────────────────────────────────────────────────── %>
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-calendar"></i> Eventos</h3>
    <div class="box-tools pull-right" style="display:flex; gap:6px; align-items:center;">

      <%= link_to new_evento_path, class: 'btn btn-sm btn-success' do %>
        <i class="fa fa-plus-square"></i> Nuevo Evento
      <% end %>

      <%= search_form_for @q do |f| %>
        <div class="input-group input-group-sm" style="width: 220px;">
          <%= f.search_field :detalle_cont,
                             onChange: 'javascript:this.value=this.value.toUpperCase();',
                             class: 'form-control input_uppercase',
                             placeholder: 'Buscar evento...' %>
          <div class="input-group-btn">
            <%= button_tag(type: "submit", class: "btn btn-default") do %>
              <i class="fa fa-search"></i>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# ── BODY ──────────────────────────────────────────────────────── %>
  <div class="box-body table-responsive">
    <table class="table table-bordered table-hover table-striped" style="font-size: 13px;">
      <thead>
      <tr class="thcolor">
        <th class="text-center" width="8%"></th>
        <th>Detalle</th>
        <th width="18%">Tipo Evento</th>
        <th class="text-center" width="12%">Fechas Inscripción</th>
        <th class="text-center" width="12%">Fechas Evento</th>
        <th class="text-center" width="12%">Cupos</th>
        <th class="text-center" width="12%">Estado</th>
      </tr>
      </thead>
      <tbody>

      <% if @eventos.empty? %>
        <tr>
          <td colspan="7" class="text-center text-muted" style="padding: 30px;">
            <i class="fa fa-calendar-o fa-2x"></i><br>
            <small>No se encontraron eventos.</small>
          </td>
        </tr>

      <% else %>
        <% @eventos.order(created_at: :desc).each do |evento| %>
          <%
            inscritos  = evento.eventospersonas.size rescue 0
            permitidos = evento.cantidad_persona.to_i
            porcentaje = permitidos > 0 ? [(inscritos * 100.0 / permitidos).round, 100].min : 0
            color_barra = porcentaje >= 100 ? 'danger' : porcentaje >= 75 ? 'warning' : 'success'
          %>
          <tr <%= evento.evento_especial? ? 'style="border-left: 4px solid #f39c12; background-color: #fffdf4;"'.html_safe : '' %>>
            <td class="text-center">
              <%= link_to edit_evento_path(evento.guid, etapa: 'A'),
                          class: 'btn btn-xs btn-warning',
                          title: 'Editar',
                          data: { toggle: 'tooltip' } do %>
                <i class="fa fa-edit"></i>
              <% end %>
              <%= link_to edit_evento_path(evento.guid, etapa: 'B'),
                          class: 'btn btn-xs btn-info',
                          title: 'Ver inscritos',
                          data: { toggle: 'tooltip' } do %>
                <i class="fa fa-users"></i>
              <% end %>
              <%# Botón nuevo - Descargar Excel %>
              <%= link_to evento_exportar_excel_path(evento.guid, format: :xlsx),
                          class: 'btn btn-xs btn-success',
                          title: 'Descargar Excel',
                          data: { toggle: 'tooltip' } do %>
                <i class="fa fa-file-excel-o"></i>
              <% end %>
            </td>
            <td>
              <% if evento.evento_especial? %>
                <span class="label" style="background-color: #f39c12; color: #fff; font-size: 10px; padding: 2px 6px; margin-right: 5px; vertical-align: middle;">
                  <i class="fa fa-star"></i> Especial
                </span>
              <% end %>
              <%= evento.detalle rescue nil %>
            </td>
            <td><%= evento.tiposevento.descripcion rescue '—' %></td>
            <td class="text-center">
              <small>
                <i class="fa fa-calendar text-muted"></i>
                <%= evento.fecha_inicio.strftime("%d/%m/%Y") rescue '—' %>
              </small><br>
              <small>
                <i class="fa fa-calendar-check-o text-muted"></i>
                <%= evento.fecha_fin.strftime("%d/%m/%Y") rescue '—' %>
              </small>
            </td>

            <%# Fechas Evento %>
            <td class="text-center">
              <small>
                <i class="fa fa-calendar text-muted"></i>
                <%= evento.fecha_inicio_e.strftime("%d/%m/%Y") rescue '—' %>
              </small><br>
              <small>
                <i class="fa fa-calendar-check-o text-muted"></i>
                <%= evento.fecha_fin_e.strftime("%d/%m/%Y") rescue '—' %>
              </small>
            </td>

            <%# Cupos %>
            <td class="text-center">
                <span>
                  <strong><%= inscritos %></strong>
                  <% if permitidos > 0 %>
                    <span class="text-muted">/ <%= permitidos %></span>
                  <% end %>
                </span>
              <% if permitidos > 0 %>
                <div class="progress progress-xs" style="margin: 4px 0 0 0;">
                  <div class="progress-bar progress-bar-<%= color_barra %>"
                       style="width: <%= porcentaje %>%"
                       title="<%= porcentaje %>% ocupado">
                  </div>
                </div>
              <% end %>
            </td>


            <td class="text-center">
              <% if evento.vigente? %>
                <span class="label label-success">VIGENTE</span>
              <% elsif evento.vencido? %>
                <span class="label label-danger">VENCIDO</span>
              <% else %>
                <span class="label label-warning">NO INICIADO</span>
              <% end %>
            </td>

          </tr>
        <% end %>
      <% end %>

      </tbody>
    </table>
  </div>

  <%# ── FOOTER PAGINACIÓN ─────────────────────────────────────────── %>
  <div class="box-footer clearfix">
    <div class="pull-right">
      <%= will_paginate @eventos, renderer: BootstrapPagination::Rails %>
    </div>
    <div class="pull-left text-muted" style="padding-top: 6px;">
      <small>
        Mostrando <%= @eventos.offset_value + 1 %> –
        <%= [@eventos.offset_value + @eventos.length, @eventos.total_entries].min %>
        de <%= @eventos.total_entries %> eventos
      </small>
    </div>
  </div>

</div>

<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
