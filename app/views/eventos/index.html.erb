<div>

</div>

<p id="notice"><%= notice %></p>

<h1>Eventos</h1>

<table>
  <thead>
    <tr>
      <th>Guid</th>
      <th>Iglesia</th>
      <th>Iglesiascomunidad</th>
      <th>Tiposevento</th>
      <th>Fecha inicio</th>
      <th>Fecha fin</th>
      <th>Detalle</th>
      <th>Estado</th>
      <th>User</th>
      <th>User act</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @eventos.each do |evento| %>
      <tr>
        <td><%= evento.guid %></td>
        <td><%= evento.iglesia %></td>
        <td><%= evento.iglesiascomunidad %></td>
        <td><%= evento.tiposevento %></td>
        <td><%= evento.fecha_inicio %></td>
        <td><%= evento.fecha_fin %></td>
        <td><%= evento.detalle %></td>
        <td><%= evento.estado %></td>
        <td><%= evento.user %></td>
        <td><%= evento.user_act %></td>
        <td><%= link_to 'Show', evento %></td>
        <td><%= link_to 'Edit', edit_evento_path(evento) %></td>
        <td><%= link_to 'Destroy', evento, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Evento', new_evento_path %>
