wd = xlsx_package.workbook
wd.styles do |style|
  header1   = wd.styles.add_style(b: true, bg_color: "FF071B7D", fg_color: 'F5F6CE', sz: 11, font_name: "Calibri",
                                  :alignment => { :horizontal => :center, :vertical => :center })
  header2   = wd.styles.add_style(b: true, bg_color: "FFE87F07", fg_color: 'F5F6CE', sz: 11, font_name: "Calibri",
                                  :alignment => { :horizontal => :center, :vertical => :center })
  titulo    = wd.styles.add_style(b: true, bg_color: "FF1a2eaa", fg_color: 'FFFFFF', sz: 13, font_name: "Calibri",
                                  :alignment => { :horizontal => :center, :vertical => :center })
  datosiz   = wd.styles.add_style(sz: 11, font_name: "Calibri", :alignment => { :horizontal => :left,   :vertical => :center })
  datoscent = wd.styles.add_style(sz: 11, font_name: "Calibri", :alignment => { :horizontal => :center, :vertical => :center })
  fecha     = wd.styles.add_style(sz: 11, font_name: "Calibri", :format_code => 'dd-mm-yyyy',
                                  :alignment => { :horizontal => :center, :vertical => :center })

  # ── Hoja 1: Info del Evento ──
  wd.add_worksheet(:name => "Evento") do |sheet|
    sheet.add_row ["Detalle del Evento"],                                      :style => [titulo]
    sheet.add_row ["Campo",                        "Valor"],                   :style => [header1, header1]
    sheet.add_row ["Evento",                       @evento.detalle],           :style => [datosiz, datoscent]
    sheet.add_row ["Tipo",                         @evento.tiposevento&.descripcion.to_s], :style => [datosiz, datoscent]
    sheet.add_row ["Fecha Inicio Inscripción",     @evento.fecha_inicio],      :style => [datosiz, fecha]
    sheet.add_row ["Fecha Fin Inscripción",        @evento.fecha_fin],         :style => [datosiz, fecha]
    sheet.add_row ["Fecha Inicio Evento",          @evento.fecha_inicio_e],    :style => [datosiz, fecha]
    sheet.add_row ["Fecha Fin Evento",             @evento.fecha_fin_e],       :style => [datosiz, fecha]
    sheet.add_row ["Total Inscritos",              @inscritos.count],          :style => [datosiz, datoscent]
    sheet.column_widths 30, 40
  end

  # ── Hoja 2: Inscritos ──
  wd.add_worksheet(:name => "Inscritos") do |sheet|

    # Columna:            1          2                  3          4            5
    sheet.add_row [     'Identificación',"Tipo Documento", "Nombre",  "Apellido",       "Celular",  "Dirección",
                         # Columna:            6          7                  8                 9
                         "Email",   "Género",          "Estado Civil",   "Tipo Persona",
                         # Columna:            10                         11                  12
                         "Identificación Acudiente", "Nombre Acudiente", "Apellido Acudiente",
                         # Columna:            13                  14                       15                    16              17
                         "Email Acudiente",  "Celular Acudiente",     "Tipo Doc. Acudiente", "Firma Acudiente", "Fecha Registro"],
                  :style => Array.new(17, header2)

    for ep in @inscritos
      sheet.add_row [
                      ep.identificacion,
                      ep.documento_tipo&.descripcion.to_s,   # 3  Tipo Documento
                      ep.nombre,                              # 1  Nombre
                      ep.apellido,                            # 2  Apellido
                      ep.celular,                            # 4  Celular
                      ep.direccion,                          # 5  Dirección
                      ep.email,                              # 6  Email
                      (ep.sexo == 'M' ? 'Masculino' : 'Femenino'), # 7 Género
                      ep.estado_civil&.nombre.to_s,          # 8  Estado Civil
                      ep.tipo_persona,                       # 9  Tipo Persona
                      ep.acudiente_identificacion,           # 10 Identificación Acudiente
                      ep.acudiente_nombre,                   # 11 Nombre Acudiente
                      ep.acudiente_apellido,                 # 12 Apellido Acudiente
                      ep.acudiente_email,                    # 13 Email Acudiente
                      ep.acudiente_celular,                  # 14 Celular Acudiente
                      ep.acudiente_documento_tipo&.descripcion.to_s,        # 15 Tipo Doc. Acudiente
                      ep.acudiente_firma,                    # 16 Firma Acudiente
                      ep.created_at],                        # 17 Fecha Registro
                    :style => [datosiz, datosiz,   datosiz,   datoscent, datoscent, datosiz,
                               datosiz,   datoscent, datosiz,   datoscent, datoscent,
                               datosiz,   datosiz,   datosiz,   datoscent, datoscent,
                               datoscent, fecha],
                    :types => [:string, nil, nil, :string, :string,   # identificacion y celular como string
                               nil, nil, nil, nil,      nil,
                               :string, nil, nil,       nil,
                               :string, nil,            nil,      nil]
    end

    sheet.column_widths 30, 30, 30, 16, 25,
                        28, 12, 18, 15, 22,
                        22, 22, 28, 18, 18,
                        15, 18
  end
end