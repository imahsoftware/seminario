wd = xlsx_package.workbook

headers = [
  'Identificación', 'Tipo Documento', 'Nombre', 'Apellido', 'Edad', 'Celular',
  'Dirección', 'Email', 'Género', 'Estado Civil', 'Tipo Persona', 'Nombre Cónyuge','Identificación Cónyuge',
  'Identificación Acudiente', 'Nombre Acudiente', 'Apellido Acudiente',
  'Email Acudiente', 'Celular Acudiente', 'Tipo Doc. Acudiente',
  'Firma Acudiente', 'Fecha Registro'
].freeze

wd.styles do |s|
  borde = { style: :thin, color: "FF000000", edges: [:left, :right, :top, :bottom] }

  header1   = s.add_style(b: true, bg_color: "FF071B7D", fg_color: 'F5F6CE', sz: 11, font_name: "Calibri",
                          border: borde,
                          :alignment => { :horizontal => :center, :vertical => :center })
  header2   = s.add_style(b: true, bg_color: "FFE87F07", fg_color: 'F5F6CE', sz: 11, font_name: "Calibri",
                          border: borde,
                          :alignment => { :horizontal => :center, :vertical => :center })
  titulo    = s.add_style(b: true, bg_color: "FF1a2eaa", fg_color: 'FFFFFF', sz: 13, font_name: "Calibri",
                          border: borde,
                          :alignment => { :horizontal => :center, :vertical => :center })
  datosiz   = s.add_style(sz: 11, font_name: "Calibri", border: borde,
                          :alignment => { :horizontal => :left,   :vertical => :center })
  datoscent = s.add_style(sz: 11, font_name: "Calibri", border: borde,
                          :alignment => { :horizontal => :center, :vertical => :center })
  fecha     = s.add_style(sz: 11, font_name: "Calibri", :format_code => 'dd-mm-yyyy',
                          border: borde,
                          :alignment => { :horizontal => :center, :vertical => :center })

  # ── Hoja 1: Info del Evento ──
  wd.add_worksheet(:name => "Evento") do |sheet|
    sheet.add_row ["Detalle del Evento", ""],                                  :style => [header1, header1]
    sheet.merge_cells "A1:B1"
    sheet.add_row ["Campo",                        "Valor"],                   :style => [header1, header1]
    sheet.add_row ["Evento",                       @evento.detalle],           :style => [datosiz, datoscent]
    sheet.add_row ["Tipo",                         @evento.tiposevento&.descripcion.to_s], :style => [datosiz, datoscent]
    sheet.add_row ["Fecha Inicio Inscripción",     @evento.fecha_inicio],      :style => [datosiz, fecha]
    sheet.add_row ["Fecha Fin Inscripción",        @evento.fecha_fin],         :style => [datosiz, fecha]
    sheet.add_row ["Fecha Inicio Evento",          @evento.fecha_inicio_e],    :style => [datosiz, fecha]
    sheet.add_row ["Fecha Fin Evento",             @evento.fecha_fin_e],       :style => [datosiz, fecha]
    sheet.add_row ["Total Inscritos",              @inscritos.count],          :style => [datosiz, datoscent]
    sheet.column_widths 30, 60
  end

  # ── Hoja 2: Inscritos ──
  wd.add_worksheet(:name => "Inscritos") do |sheet|

    # Encabezados
    sheet.add_row headers, :style => Array.new(headers.size, header2)

    # Estilos por columna (21 columnas, alineado con headers)
    estilos_fila = [
      datosiz,   # 1  Identificación
      datosiz,   # 2  Tipo Documento
      datosiz,   # 3  Nombre
      datosiz,   # 4  Apellido
      datoscent, # 5  Edad
      datoscent, # 6  Celular
      datosiz,   # 7  Dirección
      datosiz,   # 8  Email
      datoscent, # 9  Género
      datosiz,   # 10 Estado Civil
      datoscent, # 11 Tipo Persona
      datosiz,   # 12 Nombre Cónyuge
      datoscent, # 13 Identificación Cónyuge
      datoscent, # 14 Identificación Acudiente
      datosiz,   # 15 Nombre Acudiente
      datosiz,   # 16 Apellido Acudiente
      datosiz,   # 17 Email Acudiente
      datoscent, # 18 Celular Acudiente
      datoscent, # 19 Tipo Doc. Acudiente
      datoscent, # 20 Firma Acudiente
      fecha      # 21 Fecha Registro
    ]

    # Tipos por columna (string para forzar texto en identificaciones y celulares)
    tipos_fila = [
      :string, # 1  Identificación
      nil,     # 2  Tipo Documento
      nil,     # 3  Nombre
      nil,     # 4  Apellido
      nil,     # 5  Edad
      :string, # 6  Celular
      nil,     # 7  Dirección
      nil,     # 8  Email
      nil,     # 9  Género
      nil,     # 10 Estado Civil
      nil,     # 11 Tipo Persona
      nil,     # 12 Nombre Cónyuge
      :string, # 13 Identificación Cónyuge
      :string, # 14 Identificación Acudiente
      nil,     # 15 Nombre Acudiente
      nil,     # 16 Apellido Acudiente
      nil,     # 17 Email Acudiente
      :string, # 18 Celular Acudiente
      nil,     # 19 Tipo Doc. Acudiente
      nil,     # 20 Firma Acudiente
      nil      # 21 Fecha Registro
    ]

    @inscritos.each do |ep|
      # Calcular edad
      edad = ''
      if ep.fecha_nacimiento.present?
        hoy = Date.today
        edad = hoy.year - ep.fecha_nacimiento.year
        edad -= 1 if hoy < ep.fecha_nacimiento + edad.years
      end

      # Obtener datos del cónyuge
      conyuge_nombre = ''
      conyuge_identificacion = ''
      
      if ep.tipo_persona == 'MATRIMONIO'
        if ep.conyuge_pendiente == 1
          # Si está pendiente, mostrar "PENDIENTE"
          conyuge_nombre = 'PENDIENTE'
          conyuge_identificacion = 'PENDIENTE'
        elsif ep.conyuge_id.present?
          # Si no está pendiente y tiene conyuge_id, buscar los datos
          conyuge = Eventospersona.find_by(id: ep.conyuge_id)
          if conyuge
            conyuge_nombre = "#{conyuge.nombre} #{conyuge.apellido}"
            conyuge_identificacion = conyuge.identificacion
          end
        end
      end

      sheet.add_row [
                      ep.identificacion,                              # 1
                      ep.documento_tipo&.descripcion.to_s,            # 2
                      ep.nombre,                                      # 3
                      ep.apellido,                                    # 4
                      edad,                                           # 5
                      ep.celular,                                     # 6
                      ep.direccion,                                   # 7
                      ep.email,                                       # 8
                      (ep.sexo == 'M' ? 'Masculino' : 'Femenino'),    # 9
                      ep.estado_civil&.nombre.to_s,                   # 10
                      ep.tipo_persona,                                # 11
                      conyuge_nombre,                                 # 12
                      conyuge_identificacion,                         # 13
                      ep.acudiente_identificacion,                    # 14
                      ep.acudiente_nombre,                            # 15
                      ep.acudiente_apellido,                          # 16
                      ep.acudiente_email,                             # 17
                      ep.acudiente_celular,                           # 18
                      ep.acudiente_documento_tipo&.descripcion.to_s,  # 19
                      ep.acudiente_firma,                             # 20
                      ep.created_at                                   # 21
                    ],
                    :style => estilos_fila,
                    :types => tipos_fila
    end

    # Fila de total al final
    sheet.add_row []
    sheet.add_row ["Total Inscritos:", @inscritos.count],
                  :style => [header1, datoscent]

    # Anchos de columna (21 columnas)
    sheet.column_widths 30, 30, 30, 16, 8, 25,
                        28, 25, 12, 18, 15,
                        30, 22, 22, 22, 22,
                        28, 18, 18, 15, 18

    # Congelar la primera fila (encabezados visibles al hacer scroll)
    sheet.sheet_view.pane do |pane|
      pane.state        = :frozen
      pane.y_split      = 1
      pane.active_pane  = :bottom_right
    end

    # Autofiltro sobre los encabezados (columnas A hasta U = 21)
    sheet.auto_filter = "A1:U1"
  end
end